    <!-- SimpleStyles: ScrollBar -->
    <Style x:Key="VScrollBarFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="15" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="15" />
                        </Grid.RowDefinitions>
                        <Rectangle StrokeThickness="1" Stroke="{DynamicResource NormalOverBrush}"
                                   Fill="{DynamicResource VScrollbarBkgOverFill}" />
                        <Rectangle Grid.Row="2" StrokeThickness="1" Stroke="{DynamicResource NormalOverBrush}"
                                   Fill="{DynamicResource VScrollbarBkgOverFill}" />
                        <Path HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M 0 4 L 8 4 L 4 0 Z">
                            <Path.Fill>
                                <LinearGradientBrush EndPoint="0.7,0.75"
                                                     StartPoint="0.25,0">
                                    <GradientStop Color="Black"
                                                  Offset="0.25" />
                                    <GradientStop Color="#FFA9AAAC"
                                                  Offset="1" />
                                    <GradientStop Color="#FFA4A5A7"
                                                  Offset="0.75" />
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                        <Path HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Grid.Row="2"
                              Data="M 0 0 L 4 4 L 8 0 Z">
                            <Path.Fill>
                                <LinearGradientBrush EndPoint="0.7,0.75"
                                                     StartPoint="0.25,0">
                                    <GradientStop Color="Black"
                                                  Offset="0.25" />
                                    <GradientStop Color="#FFA9AAAC"
                                                  Offset="1" />
                                    <GradientStop Color="#FFA4A5A7"
                                                  Offset="0.75" />
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
