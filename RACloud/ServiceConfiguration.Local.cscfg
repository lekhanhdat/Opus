<ServiceConfiguration serviceName="ScheduleJobCloudService" xmlns="http://schemas.microsoft.com/ServiceHosting/2008/10/ServiceConfiguration" osFamily="4" osVersion="*" schemaVersion="2015-04.2.6">
  <Role name="RAScheduleJobWorkerRole">
    <Instances count="1" />
    <ConfigurationSettings>
      <Setting name="Microsoft.WindowsAzure.Plugins.Diagnostics.ConnectionString" value="UseDevelopmentStorage=true" />
      <Setting name="JobQueueConnectionString" value="" />
      <Setting name="LogStorage" value="" />
      <Setting name="RealTimeQueueName" value="" />
      <Setting name="JobQueueName" value="" />
      <Setting name="LogContainerName" value="joblogs" />
      <Setting name="ReportStorage" value="" />
      <Setting name="ReportFolder" value="C:\RECO_Reports" />
      <Setting name="ReportContainerName" value="jobreports" />
      <Setting name="ConfigDatabaseConnection" value="" />
      <Setting name="PortalApiUrl" value="" />
      <Setting name="ControlServiceAddress" value="" />
      <Setting name="CertificateThumbprint" value="958B6B5093959E9B3886BC19D5B10A19C417973D"/>
      <Setting name="HotfixStorageUrl" value=""/>
      <Setting name="AzureTableConnection" value=""/>
      <Setting name="NotificationSetting" value="" />
      <Setting name="RedirectAosLoginUrl" value=""/>
      <Setting name="CosmosDBURI" value=""/>
      <Setting name="CosmosDBSecret" value=""/>
      <Setting name="DAOKeyVaultClientId"  value="" />
      <Setting name="DAOKeyVaultUrl"  value="" />
      <Setting name="DAOKeyVaultCertThumbprint"  value="" />
      <Setting name="SubscriptionId" value=""/>
      <Setting name="SubscriptionCertThumbprint" value=""/>
      <Setting name="MaxBackupItemsThreads" value="25"/>
      <Setting name="ReservedInstanceCount" value="1"/>
    </ConfigurationSettings>
    <Certificates>
      <Certificate name="CloudRecords Application" thumbprint="958B6B5093959E9B3886BC19D5B10A19C417973D" thumbprintAlgorithm="sha1" />
      <Certificate name="DocAveOnline Application" thumbprint="DC895545B9271DDA56ADF6E7AC82E6CFDB457850" thumbprintAlgorithm="sha1" />
      <Certificate name="DocAveOnline KeyVault" thumbprint="A6F2B3046148A581A4B442DC9965FD41C23ED771" thumbprintAlgorithm="sha1" />
      <Certificate name="Subscription Management" thumbprint="958B6B5093959E9B3886BC19D5B10A19C417973D" thumbprintAlgorithm="sha1" />
    </Certificates>
  </Role>
 
</ServiceConfiguration>