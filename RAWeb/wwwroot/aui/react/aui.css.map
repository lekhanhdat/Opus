}
[data-verify-invalid='true'] {
  border: 1px solid var(--error-color) !important;
}
:root {
  --theme-rgb: 0, 114, 208;
  --theme-1: #e6f8ff;
  --theme-2: #a3e2ff;
  --theme-3: #77caf7;
  --theme-4: #4badeb;
  --theme-5: #2390de;
  --theme-6: #0072d0;
  --theme-7: #0058ab;
  --theme-8: #004085;
  --theme-9: #002a5e;
  --theme-10: #001738;
}
