<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AvePoint.Deployment.CommonGUI">

  <ResourceDictionary.MergedDictionaries>
    <!--<ResourceDictionary Source="/AvePoint.CallAssist.CommonDeploymentGUI;component/Themes/Generic.xaml" />-->
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ResourceDictionary>
    <ResourceDictionary>
      <local:ScanningRuleItemCheckStateIconMarkConverter x:Key="ScanningRuleItemCheckStateIconMarkConverter" />
    </ResourceDictionary>
    <ResourceDictionary>
      <local:ScanningRuleItemCheckStateStatusStringConverter
x:Key="ScanningRuleItemCheckStateStatusStringConverter" />
    </ResourceDictionary>
    <ResourceDictionary>
      <local:ScanningRuleItemCheckStateForegroundConverter x:Key="ScanningRuleItemCheckStateForegroundConverter" />
    </ResourceDictionary>
  </ResourceDictionary.MergedDictionaries>

  <DataTemplate x:Key="ScanningRuleItemTemplate">
    <StackPanel Visibility="{Binding Path=IsVisibility, Converter={StaticResource BooleanToVisibilityConverter}}">
      <Grid Height="26">
        <Grid.ColumnDefinitions>
          <!--Icon Image-->
          <ColumnDefinition Width="26" />
          <!--Rule-->
          <ColumnDefinition Width="*" />
          <!--Status-->
          <ColumnDefinition Width="100" />
        </Grid.ColumnDefinitions>
        <Border BorderBrush="Silver" BorderThickness="1,0,1,1" Grid.Column="0">
          <Image Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Source="{Binding Path=CheckState, Converter={StaticResource ScanningRuleItemCheckStateIconMarkConverter}}">
          </Image>
        </Border>
        <Border BorderBrush="Silver" BorderThickness="0,0,1,1" Grid.Column="1">
          <Grid Margin="5,0,5,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding RightPageRuleContent}" VerticalAlignment="Center"
                       HorizontalAlignment="Left" FontFamily="Segoe UI" FontSize="12" Foreground="#FF333333" />
          </Grid>
        </Border>
        <Border BorderBrush="Silver" BorderThickness="0,0,1,1" Grid.Column="2">
          <Grid Margin="5,0,5,0" VerticalAlignment="Center">
            <Label IsTabStop="True">
              <Hyperlink Foreground="#FF333333" Command="{Binding HyperLinkOperator.Command}">
                <TextBlock TextDecorations="Underline" HorizontalAlignment="Left" FontFamily="Segoe UI"
                           FontSize="12"
                           Text="{Binding Path=CheckState, Converter={StaticResource ScanningRuleItemCheckStateStatusStringConverter}}"
                           Foreground="{Binding Path=CheckState, Converter={StaticResource ScanningRuleItemCheckStateForegroundConverter}}" />
              </Hyperlink>
            </Label>
          </Grid>
        </Border>
      </Grid>
    </StackPanel>
  </DataTemplate>
</ResourceDictionary>