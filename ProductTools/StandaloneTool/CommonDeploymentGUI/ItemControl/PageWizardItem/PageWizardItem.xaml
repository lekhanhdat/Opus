  <DataTemplate x:Key="PageWizardItemTemplateForCT">
    <StackPanel Width="Auto" Height="Auto" Background="Green">
      <RadioButton GroupName="1" Background="Transparent" Margin="0" IsChecked="{Binding IsChecked}"
                   Content="{Binding Content}"
                   Visibility="{Binding Path=IsVisibility, Converter={StaticResource BooleanToVisibilityConverter}}"
                   Command="{Binding WizardOperator.Command}" Style="{DynamicResource CTItemRadioButton}" Width="Auto" Height="30"
                   BorderBrush="{x:Null}" Foreground="{x:Null}" />
    </StackPanel>
  </DataTemplate>


</ResourceDictionary>