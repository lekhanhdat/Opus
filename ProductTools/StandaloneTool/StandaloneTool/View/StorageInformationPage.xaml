<Page
    x:Class="StandaloneTool.View.StorageInformationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resource="clr-namespace:DataExportCore.Resources;assembly=DataExportCore"
    xmlns:src="clr-namespace:AvePoint.Deployment.CommonGUI;assembly=AvePoint.CallAssist.CommonDeploymentGUI"
    xmlns:converter="clr-namespace:StandaloneTool.Common"
    Title="StorageInformation"
    d:DesignHeight="500"
    d:DesignWidth="780"
    mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converter:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        </ResourceDictionary>
    </Page.Resources>
    <Grid>
        <Grid>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="370" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid
                        Name="WizardTextBlock"
                        Grid.Row="1"
                        Background="#FF1188EE">
                        <TextBlock
                            Grid.Row="1"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            FontFamily="Segoe UI"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="White"
                            Style="{StaticResource PageDescriptionTextBlock}"
                            Text="{x:Static resource:CommonResourceManager.SATool_ExportDataLocationTitle}" />
                    </Grid>
                </Grid>
                <Grid Grid.Row="3">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock
                                Width="600"
                                HorizontalAlignment="Center"
                                FontSize="13"
                                Foreground="#000"
                                Style="{StaticResource PageDescriptionTextBlock}"
                                Text="{x:Static resource:CommonResourceManager.SATool_ExportDataLocation_FirstDesc}" />
                            <TextBlock
                                Width="600"
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                FontSize="13"
                                Foreground="#000"
                                Style="{StaticResource PageDescriptionTextBlock}"
                                Text="{x:Static resource:CommonResourceManager.SATool_ExportDataLocation_SecondDesc}" />
                            <CheckBox
                                Width="600"
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center"
                                Content="{x:Static resource:CommonResourceManager.SATool_ExportDataLocation_SkipRestoreAvePointStorageData}"
                                IsChecked="{Binding SkipRestoreDataInAvePointStorage, Mode=TwoWay}" />
                        </StackPanel>

                        <Grid
                            Grid.Row="3"
                            Margin="0,5,0,0"
                            HorizontalAlignment="Center"
                            IsEnabled="{Binding SkipRestoreDataInAvePointStorage, Converter={StaticResource InverseBooleanConverter}}">
                            <Grid.ColumnDefinitions>
                                <!--  Intro  -->
                                <ColumnDefinition Width="Auto" MinWidth="100" />
                                <!--  Space  -->
                                <ColumnDefinition Width="50" />
                                <!--  Value  -->
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="15" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="15" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="15" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="15" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="15" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="15" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="0"
                                Margin="0,6,0,0"
                                VerticalAlignment="Top"
                                Style="{StaticResource PageIntroTextBlock}"
                                Text="{x:Static resource:CommonResourceManager.SATool_StorageTypeTitle}" />
                            <src:TextBoxEx
                                Grid.Row="2"
                                Grid.Column="2"
                                IsReadOnly="True"
                                Text="{Binding DefaultStorageType}" />

                            <!--  Microsoft Azure Blob Storage  -->
                            <Grid
                                Name="AzurePageName"
                                Grid.Row="4"
                                Grid.ColumnSpan="3">
                                <Grid.ColumnDefinitions>
                                    <!--  Intro  -->
                                    <ColumnDefinition Width="Auto" MinWidth="100" />
                                    <!--  Space  -->
                                    <ColumnDefinition Width="50" />
                                    <!--  Value  -->
                                    <ColumnDefinition Width="300" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="15" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="15" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="15" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="15" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="15" />
                                </Grid.RowDefinitions>
                                <Grid
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,6,0,0">
                                    <TextBlock
                                        VerticalAlignment="Top"
                                        Style="{StaticResource PageIntroTextBlock}"
                                        Text="{x:Static resource:CommonResourceManager.SATool_AccessPointTitle}" />
                                    <TextBlock
                                        Margin="78,3,0,0"
                                        HorizontalAlignment="Left"
                                        Foreground="Red"
                                        Text="*" />
                                </Grid>
                                <src:TextBoxEx
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    ErrorMsg="{Binding AccessPointMsg}"
                                    ShowMsgOnBottom="True"
                                    Text="{Binding AccessPoint}" />
                                <Grid
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Margin="0,6,0,0">
                                    <TextBlock
                                        VerticalAlignment="Top"
                                        Style="{StaticResource PageIntroTextBlock}"
                                        Text="{x:Static resource:CommonResourceManager.SATool_ContainerNameTitle}" />
                                    <TextBlock
                                        Margin="98,3,0,0"
                                        HorizontalAlignment="Left"
                                        Foreground="Red"
                                        Text="*" />
                                </Grid>
                                <src:TextBoxEx
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    ErrorMsg="{Binding ContainerNameMsg}"
                                    ShowMsgOnBottom="True"
                                    Text="{Binding ContainerName}" />
                                <Grid
                                    Grid.Row="4"
                                    Grid.Column="0"
                                    Margin="0,6,0,0">
                                    <TextBlock
                                        VerticalAlignment="Top"
                                        Style="{StaticResource PageIntroTextBlock}"
                                        Text="{x:Static resource:CommonResourceManager.SATool_AccountNameTitle}" />
                                    <TextBlock
                                        Margin="88,3,0,0"
                                        HorizontalAlignment="Left"
                                        Foreground="Red"
                                        Text="*" />
                                </Grid>
                                <src:TextBoxEx
                                    Grid.Row="4"
                                    Grid.Column="2"
                                    ErrorMsg="{Binding AccountNameMsg}"
                                    ShowMsgOnBottom="True"
                                    Text="{Binding AccountName}" />
                                <Grid
                                    Grid.Row="6"
                                    Grid.Column="0"
                                    Margin="0,6,0,0">
                                    <TextBlock
                                        VerticalAlignment="Top"
                                        Style="{StaticResource PageIntroTextBlock}"
                                        Text="{x:Static resource:CommonResourceManager.SATool_AccountKeyTitle}" />
                                    <TextBlock
                                        Margin="75,3,0,0"
                                        HorizontalAlignment="Left"
                                        Foreground="Red"
                                        Text="*" />
                                </Grid>
                                <PasswordBox
                                    Grid.Row="6"
                                    Grid.Column="2"
                                    MinHeight="30"
                                    VerticalAlignment="Center"
                                    src:PasswordBoxBindingHelper.BoundPassword="{Binding Path=AccountKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    src:PasswordBoxBindingHelper.IsPasswordBindingEnabled="True"
                                    AllowDrop="True"
                                    d:LayoutOverrides="GridBox" />
                                <TextBlock
                                    Grid.Row="8"
                                    Grid.Column="2"
                                    FontSize="13"
                                    Foreground="Red"
                                    Text="{Binding AccountKeyMsg, Mode=TwoWay}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
        <StackPanel
            Margin="0,50,0,-83"
            Background="#50333333"
            IsVisibleChanged="StackPanel_IsVisibleChanged"
            Visibility="{Binding Path=IsCheckingConfig, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=true}" />
        <src:GifImage
            Width="60"
            Height="60"
            Margin="1,100,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Source="..\Images\loading.gif"
            Visibility="{Binding Path=IsCheckingConfig, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=true}" />
    </Grid>
</Page>
