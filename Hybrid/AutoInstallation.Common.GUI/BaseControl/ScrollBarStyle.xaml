    <Style x:Key="VScrollBarThumb"
           TargetType="{x:Type Thumb}">
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <Setter Property="OverridesDefaultStyle"
                Value="true" />
        <Setter Property="IsTabStop"
                Value="false" />
        <Setter Property="Focusable"
                Value="false" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Visibility="Visible">
                        <Rectangle x:Name="Background"
                                   Stroke="{DynamicResource NormalBorderBrush}"
                                   RadiusX="1.5"
                                   RadiusY="1.5"
                                   Fill="{DynamicResource VScrollbarBkgNormFill}" />
                        <Rectangle x:Name="BackgroundMouseOver"
                                   Stroke="#FF3B79AC"
                                   StrokeThickness="1"
                                   RadiusX="0.5"
                                   RadiusY="0.5"
                                   Opacity="0"
                                   Fill="{DynamicResource VScrollbarBkgOverFill}" />
                        <Rectangle x:Name="BackgroundPressed"
                                   StrokeThickness="1"
                                   RadiusX="0.5"
                                   RadiusY="0.5"
                                   Opacity="0"
                                   Stroke="#FF2C628B"
                                   Fill="{DynamicResource VScrollbarBkgPressFill}" />
                        <Grid Width="7"
                              Height="8"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center">
                            <Border Width="7"
                                    Height="2"
                                    BorderThickness="1,1,0,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,6"
                                    BorderBrush="{DynamicResource BlackBrush}"
                                    Background="{DynamicResource NormalBorderBrush}"
                                    OpacityMask="{DynamicResource LineMaskBrushV0010}" />
                            <Border Width="7"
                                    Height="2"
                                    BorderThickness="1,1,0,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Margin="0"
                                    BorderBrush="{DynamicResource BlackBrush}"
                                    Background="{DynamicResource NormalBorderBrush}"
                                    OpacityMask="{DynamicResource LineMaskBrushV0010}" />
                            <Border Width="7"
                                    Height="2"
                                    BorderThickness="1,1,0,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,-6"
                                    Background="{DynamicResource NormalBorderBrush}"
                                    BorderBrush="{DynamicResource BlackBrush}"
                                    OpacityMask="{DynamicResource LineMaskBrushV0010}" />
                            <Border x:Name="BorderOver"
                                    Margin="0,0,0,6"
                                    Width="7"
                                    Height="2"
                                    BorderThickness="1,1,0,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Opacity="0"
                                    Background="{DynamicResource ScrollBarOver1}"
                                    BorderBrush="{DynamicResource ScrollBarOver2}"
                                    OpacityMask="{DynamicResource LineMaskBrush10030}" />
                            <Border x:Name="BorderOver1"
                                    Width="7"
                                    Height="2"
                                    BorderThickness="1,1,0,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Opacity="0"
                                    Background="{DynamicResource ScrollBarOver1}"
                                    BorderBrush="{DynamicResource ScrollBarOver2}"
                                    OpacityMask="{DynamicResource LineMaskBrush10030}" />
                            <Border x:Name="BorderOver2"
                                    Margin="0,0,0,-6"
                                    Width="7"
                                    Height="2"
                                    BorderThickness="1,1,0,0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center"
                                    Opacity="0"
                                    Background="{DynamicResource ScrollBarOver1}"
                                    BorderBrush="{DynamicResource ScrollBarOver2}"
                                    OpacityMask="{DynamicResource LineMaskBrush10030}" />
                            <Border x:Name="BorderPress"
                                    Margin="0,0,0,6"
                                    Width="7"
                                    Height="2"
                                    BorderThickness="1,1,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Opacity="0"
                                    Background="{DynamicResource ScrollBarPress1}"
                                    BorderBrush="{DynamicResource ScrollBarPress2}"
                                    OpacityMask="{DynamicResource LineMaskBrush10030}" />
                            <Border x:Name="BorderPress1"
                                    Margin="0,0,0,0"
                                    Width="7"
                                    Height="2"
                                    BorderThickness="1,1,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Opacity="0"
                                    Background="{DynamicResource ScrollBarPress1}"
                                    BorderBrush="{DynamicResource ScrollBarPress2}"
                                    OpacityMask="{DynamicResource LineMaskBrushV0010}" />
                            <Border x:Name="BorderPress2"
                                    Margin="0,0,0,-6"
                                    Width="7"
                                    Height="2"
                                    BorderThickness="1,1,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Opacity="0"
                                    BorderBrush="{DynamicResource ScrollBarPress2}"
                                    Background="{DynamicResource ScrollBarPress1}"
                                    OpacityMask="{DynamicResource LineMaskBrushV0010}" />
                        </Grid>
                        <Rectangle x:Name="Highlight"
                                   Margin="1"
                                   Stroke="{DynamicResource WhiteBrush}"
                                   RadiusX="0.5"
                                   RadiusY="0.5"
                                   Opacity="0.6"
                                   IsHitTestVisible="false" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Opacity"
                                    TargetName="BackgroundMouseOver"
                                    Value="1" />
                            <Setter Property="Opacity"
                                    TargetName="BorderOver"
                                    Value="1" />
                            <Setter Property="Opacity"
                                    TargetName="BorderOver1"
                                    Value="1" />
                            <Setter Property="Opacity"
                                    TargetName="BorderOver2"
                                    Value="1" />
                        </Trigger>
                        <Trigger Property="IsDragging"
                                 Value="True">
                            <Setter Property="Opacity"
                                    TargetName="BorderPress"
                                    Value="1" />
                            <Setter Property="Opacity"
                                    TargetName="BorderPress1"
                                    Value="1" />
                            <Setter Property="Opacity"
                                    TargetName="BorderPress2"
                                    Value="1" />
                            <Setter Property="Opacity"
                                    TargetName="BackgroundPressed"
                                    Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False" />
                        <Trigger Property="IsFocused"
                                 Value="False" />
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
