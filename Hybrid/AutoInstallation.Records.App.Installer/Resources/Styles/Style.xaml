<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:AutoInstallation.Records.App.Installer.Resources.Styles">
    <SolidColorBrush x:Key="MouseOverColor" Color="#FFFFFF" Opacity="0.14" />
    <SolidColorBrush x:Key="DisableColor" Color="#FFFFFF" Opacity="0.32" />

    <Style x:Key="ActionButtonStyle" TargetType="Button">
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="border" BorderThickness="0" CornerRadius="3">
                        <Label x:Name="lbContent"
                               Padding="27, 4"
                               Content="{TemplateBinding Content}"
                               Foreground="{TemplateBinding Foreground}"
                               Background="{TemplateBinding Background}"
                               HorizontalContentAlignment="Center"
                               VerticalContentAlignment="Center" />
                    </Border>
                    <!-- <ControlTemplate.Triggers> -->
                    <!--     <Trigger Property="IsEnabled" Value="True"> -->
                    <!--         <Setter Property="BorderBrush" TargetName="border" Value="White" /> -->
                    <!--         <Setter Property="Foreground" TargetName="lbContent" Value="#ffffff" /> -->
                    <!--         <Setter Property="Background" TargetName="lbContent" Value="Transparent" /> -->
                    <!--     </Trigger> -->
                    <!--     <Trigger Property="IsEnabled" Value="False"> -->
                    <!--         <Setter Property="BorderBrush" TargetName="border" -->
                    <!--                 Value="{StaticResource DisableColor}" /> -->
                    <!--         <Setter Property="Foreground" TargetName="lbContent" -->
                    <!--                 Value="{StaticResource DisableColor}" /> -->
                    <!--         <Setter Property="Background" TargetName="lbContent" Value="Transparent" /> -->
                    <!--     </Trigger> -->
                    <!--     <Trigger Property="IsMouseOver" Value="True"> -->
                    <!--         <Setter Property="Background" TargetName="border" -->
                    <!--                 Value="{StaticResource MouseOverColor}" /> -->
                    <!--     </Trigger> -->
                    <!--     <Trigger Property="IsPressed" Value="True"> -->
                    <!--         <Setter Property="Background" TargetName="border" Value="Transparent" /> -->
                    <!--     </Trigger> -->
                    <!-- </ControlTemplate.Triggers> -->
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TitleLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <!-- <Setter Property="LineHeight" Value="32"/> -->
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#333333" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="InfoLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <!-- <Setter Property="LineHeight" Value="32"/> -->
        <Setter Property="Foreground" Value="#333333" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="ActionButton" TargetType="Button">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Width" Value="80" />
    </Style>
</ResourceDictionary>