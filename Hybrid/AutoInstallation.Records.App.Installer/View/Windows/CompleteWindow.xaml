<local:BaseWindow x:Class="AutoInstallation.Records.App.Installer.View.Windows.CompleteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoInstallation.Records.App.Installer.View.Windows"
        mc:Ignorable="d"
        Title="{Binding Source='Key_GUI_App_Title',Converter={StaticResource MessageI18N},ConverterParameter='ConfigurationTool'}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/Styles/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="312" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="25" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.Background>
                <ImageBrush x:Name="BackgroundImage" ImageSource="../../Images/bg.png" />
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="260" />

            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="1" Grid.Column="1">
                <TextBlock  Margin="15,5,0,5" 
                            HorizontalAlignment="Stretch" d:LayoutOverrides="Width"
                           TextWrapping="WrapWithOverflow"
                           TextAlignment="Left"
                           LineHeight="19"
                           FontFamily="Segoe UI"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#333333"
                           Text="{Binding Source='Key_GUI_Agent_Configuration',Converter={StaticResource MessageI18N},ConverterParameter='ConfigurationTool'}"
                            />
            </Grid>
            <Grid Grid.Row="2" Grid.Column="1" Background="#f5fdf8" Margin="20,19,20,46" VerticalAlignment="Center" Height="195">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Image Grid.Row="0" x:Name="CompletegroundImage" Source="../../Images/complete.png" Stretch="None" VerticalAlignment="Bottom" Height="44"/>
                <TextBlock Grid.Row="1" FontSize="14" Foreground="#333333" TextWrapping="Wrap" Background="#f5fdf8"
                               HorizontalAlignment="Center" VerticalAlignment="Top"
                Text="{Binding Source='Key_GUI_Configuration_Complete',Converter={StaticResource MessageI18N},ConverterParameter='ConfigurationTool'}"
                            />
            </Grid>


        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="5"
                    Style="{StaticResource ActionButton}"
                    IsDefault="True"
                    Content="{Binding Source='Key_GUI_Agent_Action_Finish',Converter={StaticResource MessageI18N},ConverterParameter='ConfigurationTool'}"
                    Click="CloseAction" />
        </Grid>
    </Grid>
</local:BaseWindow>
