    class AveFile : AveClientObject, IAveFile
    {
        private IAveRequest mRequest;
        private IAveWeb mParentWeb;
        private string mSiteUrl;
        private string mServerRelativeUrl;
        private string mFullUrl;
        private bool mVersionsLoaded;
        private bool mUniqueIdLoaded;

        public AveFile(IAveRequest request, IAveWeb web, string serverRelativeUrl, string listName)
        {
            mRequest = request;
            mParentWeb = web;
            mSiteUrl = web.Site.Url;
            mServerRelativeUrl = serverRelativeUrl;
            mVersionsLoaded = false;
            mUniqueIdLoaded = false;
            mFullUrl = GetServerUrl(web.Url).TrimEnd('/') +"/" + serverRelativeUrl.TrimStart('/');
            Dictionary<string, object> items = mRequest.FileGetFile(web.Url, web.Id.ToString(), serverRelativeUrl, listName);
            List<Dictionary<string, object>> itemsList = items["Items"] as List<Dictionary<string, object>>;
            if ( itemsList.Count == 0 )
            {
                //throw new Exception("file object isn't exist");
                base.DataCache.PropertiesCache.Add("Exist", false);
                return;
            }
            Dictionary<string, object> fileProperties = itemsList[0];
            string name = fileProperties["AuthorName"] as string;
            string id = fileProperties["AuthorId"] as string;
            foreach ( IAveUser user in  mParentWeb.SiteUsers)
            {
                if ( id.Equals(user.Id.ToString()) && name.Equals(user.Name.ToString()) )
                {
                    fileProperties.Remove("AuthorName");
                    fileProperties.Remove("AuthorId");
                    fileProperties.Add("Author", user);
                    break;
                }
            }
            base.DataCache.AddPropertyies(fileProperties);
        }

