CREATE TABLE tb_head_index(COL_ID CHAR(36) NOT NULL,
                   COL_FLAG BIGINT default 0,
                   COL_CRC BIGINT, 
                   COL_JOBID CHAR(36), 
                   COL_SOLUTION_NAME VARCHAR(255), 
                   COL_DISPLAY_NAME VARCHAR(255), 
                   COL_VERSION CHAR(10), 
                   COL_DATA_VERSION INT, 
                   COL_PATH VARCHAR(255), 
                   COL_LCID INT, 
                   COL_CONTAINSWEBAPPLICATIONRESOURCE CHAR(5),
                   COL_CONTAINSGLOBALASSEMBLY CHAR(5), 
                   COL_CONTAINSCODEACCESSSECURITYPOLICY CHAR(5), 
                   COL_DEPLOYMENTSERVERTYPE VARCHAR(255), 
                   COL_CREATEDTIME BIGINT, 
                   COL_LOGICDEVICEID VARCHAR(255), 
                   COL_FILE_OFFSET BIGINT, 
                   COL_FILE_LENGTH BIGINT, 
                   COL_EXTENSION_1 INT, 
                   COL_EXTENSION_2 INT, 
                   COL_EXTENSION_3 INT, 
                   COL_EXTENSION_4 BIGINT, 
                   COL_EXTENSION_5 BIGINT, 
                   COL_EXTENSION_6 VARCHAR(32672), 
                   COL_EXTENSION_7 VARCHAR(32672), 
                   COL_EXTENSION_8 VARCHAR(32672), 
                   COL_EXTENSION_9 TEXT, 
                   COL_EXTENSION_10 TEXT,
                   COL_DESCRIPTION VARCHAR(300) default '', 
                   COL_SOLUTION_CONTENT BLOB);

CREATE TABLE tb_job_info(COL_GUID VARCHAR(36) NOT NULL PRIMARY KEY, 
                  COL_KEY VARCHAR(32672), 
                  COL_VALUE VARCHAR(32672));

