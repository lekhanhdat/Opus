			<parameters>
				<OldIndexProcessor>${AvePoint.Media.Service.ArchiverBackup.ArchiverMergeIndexServiceProcessor}</OldIndexProcessor>
				<NewIndexProcessor>${AvePoint.Media.Service.ArchiverBackup.ArchiverMergeIndexServiceProcessor}</NewIndexProcessor>
			</parameters>
