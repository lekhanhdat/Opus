    <!--TextBox-->

    <SolidColorBrush x:Key="TextBoxBorderBrush" Color="#FFABABAB" />


    <LinearGradientBrush x:Key="TextBoxOverBrush" EndPoint="0.5,1" StartPoint="0.5,0">
        <GradientStop Color="#FF4488CC" Offset="0" />
        <GradientStop Color="#FF66AAFF" Offset="0.355" />
