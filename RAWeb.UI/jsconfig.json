{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "checkJs": true,
    "allowJs": true,
    "jsx": "react",
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "noImplicitAny": false,
    "strictNullChecks": false,
    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ]
  },
  "include": [
    "src/types/globals.d.ts",
    "src/**/*",
    "src/types/**/*"
  ],
  "exclude": [
    "node_modules",
    "build"
  ]
}