<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>AvePoint.Common</RootNamespace>
    <AssemblyName>AgentCommonUtility</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <OutputPath>..\..\..\bin\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>none</DebugType>
    <OutputPath>..\..\..\bin\Release\</OutputPath>
    <DefineConstants>TRACE;CODE_ANALYSIS</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
  </PropertyGroup>
  <PropertyGroup>
    <AssemblyOriginatorKeyFile>..\..\..\DocaveReference\DocAveStandard.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
	<PropertyGroup>
		<EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
	</PropertyGroup>
  <PropertyGroup>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Common\GlobalCommon\GCommonContract\DocAve.GCommonContract.csproj" />
    <ProjectReference Include="..\..\..\Common\GlobalCommon\GCommonUtility\DocAve.GCommonUtility.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\DocaveReference\DocAveStandard.snk">
      <Link>DocAveStandard.snk</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="log4net" Version="3.3.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.2" />
    <PackageReference Include="System.DirectoryServices" Version="10.0.2" />
    <PackageReference Include="Microsoft.DotNet.UpgradeAssistant.Extensions.Default.Analyzers" Version="0.4.421302">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="AgentCredentialManager.cs" />
    <Compile Remove="AgentRegisterUtil.cs" />
    <Compile Remove="AgentServiceLocator.cs" />
    <Compile Remove="AveCrypto.cs" />
    <Compile Remove="AveResourceUsageMonitor.cs" />
    <Compile Remove="AveStaticEnv.cs" />
    <Compile Remove="CustomizeChannelFactory.cs" />
    <Compile Remove="CustomizeMessageInspectorServiceBehavior.cs" />
    <Compile Remove="CustomizeOperationInvokerOperationBehavior.cs" />
    <Compile Remove="CustomizeServiceHostFactory.cs" />
    <Compile Remove="EnvUtility.cs" />
    <Compile Remove="Impersonator.cs" />
    <Compile Remove="LoggerInitializer.cs" />
    <Compile Remove="PermissionProvisionManager.cs" />
    <Compile Remove="SQLServerInfo.cs" />
    <Compile Remove="StartProcess.cs" />
    <Compile Remove="WcfUtility.cs" />
    <Compile Remove="XmlUtility.cs" />
  </ItemGroup>
</Project>