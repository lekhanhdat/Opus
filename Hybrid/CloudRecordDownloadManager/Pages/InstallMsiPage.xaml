<local:BasePage x:Class="CloudRecordDownloadManager.Pages.InstallMsiPage"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                xmlns:local="clr-namespace:CloudRecordDownloadManager.Pages"
                xmlns:res="clr-namespace:CloudRecordDownloadManager.Properties"
                mc:Ignorable="d">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="312" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="25" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.Background>
                <ImageBrush x:Name="BackgroundImage" ImageSource="../Resources/Images/bg.png" />
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="33" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="*" />
                <RowDefinition Height="40" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="1" Grid.Column="1"
                       Margin="16, 0"
                       Text="{x:Static res:I18N.key_0cf5afca_a5b2_4f91_b0c1_69b0d2ba1737}"
                       TextWrapping="WrapWithOverflow"
                       TextAlignment="Left"
                       LineHeight="19"
                       FontFamily="Segoe UI"
                       FontSize="16"
                       FontWeight="SemiBold"
                       Foreground="#333333" />
            <Grid Grid.Row="3" Grid.Column="1" Margin="16, 0" Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="16" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{x:Static res:I18N.key_c2479e85_f4bb_45d8_b64a_38aa761ce9bc}"
                           TextWrapping="WrapWithOverflow"
                           TextAlignment="Left"
                           LineHeight="16"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           Foreground="#333333" />
                <ProgressBar Grid.Row="3" Grid.Column="1" x:Name="Indicator"
                             Height="15"
                             Maximum="100"
                             Minimum="0"
                             Value="50" />
            </Grid>
        </Grid>
        <Grid Grid.Row="1" Margin="0, 0, 6, 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.5" />
                <RowDefinition Height="1.5" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#A0A0A0" Margin="0, 0, 1, 0" />
            <Grid Grid.Row="1" Background="White" />
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" x:Name="ConfigButton"
                    Content="{x:Static res:I18N.key_51a906d9_7bad_4489_b99a_d4450dd177b4}"
                    Padding="20, 0"
                    FontFamily="Segoe UI"
                    FontSize="13"
                    Click="ConfigAction" />
        </Grid>
    </Grid>
</local:BasePage>