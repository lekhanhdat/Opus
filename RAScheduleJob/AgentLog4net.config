<log4net debug="true">
	<root>
		<level value="DEBUG" />
		<appender-ref ref="AveSeparativeLogAppender" />
		<appender-ref ref="HighLevelFileLogAppender" />
	</root>
	<appender name="AveSeparativeLogAppender" type="AvePoint.RA.CommonUtil.AveSeparativeLogAppender, RevIMGCommon">
		<lockingModel type="AvePoint.RA.CommonUtil.MultiTenantFileLocker, RevIMGCommon" />
		<!-- !Attention : When configuring the value of "log4net.Util.PatternString", "/logs/%property{TenantAccountId}/%property{ProcessName}%property{LogFilePostfix}.log" should be reserved, only the path ahead of this is configurable -->
		<file type="log4net.Util.PatternString" value="/logs/{1}.log" />
		<param name="AppendToFile" value="true" />
		<StaticLogFileName value="false"/>
		<maximumFileSize value="100MB" />
		<maxSizeRollBackups value="50" />
    <rollingStyle value="Size"/>
		<encoding value="utf-8" />
		<layout type="log4net.Layout.PatternLayout">
			<param name="ConversionPattern" value="%-5level %date{yyyy-MM-dd HH:mm:ss,fff} [%thread] %logger %property{EventID}- %message  %newline" />
		</layout>
	</appender>
	<appender name="HighLevelFileLogAppender" type="AvePoint.RA.CommonUtil.AveHighSeparativeLogAppender, RevIMGCommon">
		<lockingModel type="AvePoint.RA.CommonUtil.MultiTenantFileLocker, RevIMGCommon" />
		<file type="log4net.Util.PatternString" value="/logs/high/{1}_high.log" />
		<param name="AppendToFile" value="true" />
		<StaticLogFileName value="false"/>
		<maximumFileSize value="100MB" />
		<maxSizeRollBackups value="10" />
    <rollingStyle value="Size"/>
		<encoding value="UTF-8" />
		<layout type="log4net.Layout.PatternLayout">
			<header value="Level DateTime Thread Class EventID- Message &#xD;&#xA;" />
			<param name="ConversionPattern" value="%-5level %date{MM-dd HH:mm:ss,fff} %thread %logger %property{EventID}- %message  %newline" />
		</layout>
	</appender>
</log4net>
