<UserControl x:Class="AvePoint.Deployment.CommonGUI.Loading"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" mc:Ignorable="d" d:DesignHeight="300" d:DesignWidth="300"
             Width="16" Height="16">
  <UserControl.Resources>
    <Storyboard x:Key="LoadingStoryBoard" RepeatBehavior="Forever">
      <DoubleAnimationUsingKeyFrames
Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)"
Storyboard.TargetName="path">
        <SplineDoubleKeyFrame KeyTime="0:0:0.5" Value="180" />
        <SplineDoubleKeyFrame KeyTime="0:0:1" Value="360" />
      </DoubleAnimationUsingKeyFrames>
    </Storyboard>
  </UserControl.Resources>
  <UserControl.Triggers>
    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
      <BeginStoryboard Storyboard="{StaticResource LoadingStoryBoard}" />
    </EventTrigger>
  </UserControl.Triggers>
  <Grid x:Name="LayoutRoot">
    <Grid Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="16" Height="16">
      <Path
Data="M7,3.25 C5,3.25 3.25,5 3.25,7 3.25,9 5,10.75 7,10.75 9,10.75 10.75,9 10.75,7 10.75,5 9,3.25 7,3.25 z M7,0.25 C10.7,0.25 13.75,3.27 13.75,7 13.75,10.7 10.7,13.75 7,13.75 3.27,13.75 0.25,10.7 0.25,7 0.25,3.27 3.27,0.25 7,0.25 z"
Margin="1" Stretch="Fill" StrokeThickness="0.5">
        <Path.Effect>
          <DropShadowEffect ShadowDepth="1" Opacity="0.3" />
        </Path.Effect>
        <Path.Fill>
          <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FF0072F1" Offset="0.5" />
            <GradientStop Color="#FF00A2FF" Offset="0.67" />
            <GradientStop Color="#FFB6FFDF" Offset="1" />
            <GradientStop Color="#FFD6E9FF" />
          </LinearGradientBrush>
        </Path.Fill>
        <Path.Stroke>
          <RadialGradientBrush GradientOrigin="1,1" RadiusY="0.8" RadiusX="0.8">
            <GradientStop Color="White" Offset="1" />
            <GradientStop Color="#FF9EBEFF" Offset="0.835" />
            <GradientStop Color="#FF5395FF" Offset="0.754" />
            <GradientStop Color="#FF2B67AB" />
          </RadialGradientBrush>
        </Path.Stroke>
      </Path>
      <Path
Data="M7,3.25 C5,3.25 3.25,5 3.25,7 3.25,9 5,10.75 7,10.75 9,10.75 10.75,9 10.75,7 10.75,5 9,3.25 7,3.25 z M7,0.25 C10.7,0.25 13.75,3.27 13.75,7 13.75,10.7 10.7,13.75 7,13.75 3.27,13.75 0.25,10.7 0.25,7 0.25,3.27 3.27,0.25 7,0.25 z"
Margin="1" Stretch="Fill">
        <Path.Effect>
          <DropShadowEffect ShadowDepth="1" Opacity="0.3" />
        </Path.Effect>
        <Path.Stroke>
          <RadialGradientBrush GradientOrigin="1,1" RadiusY="0.8" RadiusX="0.8">
            <GradientStop Color="#FF61C9F3" Offset="0.835" />
            <GradientStop Color="#FF6EDECB" Offset="0.754" />
            <GradientStop Color="#FFB2ECFB" />
          </RadialGradientBrush>
        </Path.Stroke>
      </Path>
      <Path x:Name="path"
            Data="M7,3.25 C5,3.25 3.25,5 3.25,7 3.25,9 5,10.75 7,10.75 9,10.75 10.75,9 10.75,7 10.75,5 9,3.25 7,3.25 z M7,0.25 C10.7,0.25 13.75,3.27 13.75,7 13.75,10.7 10.7,13.75 7,13.75 3.27,13.75 0.25,10.7 0.25,7 0.25,3.27 3.27,0.25 7,0.25 z"
            Margin="1" Stretch="Fill" StrokeThickness="0.5" Stroke="Transparent" RenderTransformOrigin="0.5,0.5">
        <Path.RenderTransform>
          <TransformGroup>
            <ScaleTransform />
            <SkewTransform />
            <RotateTransform />
            <TranslateTransform />
          </TransformGroup>
        </Path.RenderTransform>
        <Path.Fill>
          <RadialGradientBrush GradientOrigin="0.214,0.255" RadiusY="0.396" RadiusX="0.396"
                               Center="0.277,0.314">
            <GradientStop Color="#000072F1" Offset="1" />
            <GradientStop Color="#CCB6FFED" Offset="0.284" />
            <GradientStop Color="#FFCBFFF9" Offset="0.004" />
            <GradientStop Color="#897AD1EE" Offset="0.653" />
          </RadialGradientBrush>
        </Path.Fill>
      </Path>
    </Grid>
  </Grid>
</UserControl>