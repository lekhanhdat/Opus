@using AvePoint.RA.I18N.Core;
@using AvePoint.RA.Web.Common;
@using AvePoint.RA.Common.Util;
@using AvePoint.RA.Contract.RMWeb.Account;
@using AvePoint.RA.Web.Extentions.Util
@using Microsoft.AspNetCore.Html
@model SsoSamplerUserInfo
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@Html.I18N("RM_JS_ErrorPage_Error")</title>
    <link rel='SHORTCUT ICON' href='https://res.cdn.avepointonlineservices.com/cloud%20records/favicon.ico' type='image/x-icon' />
    <link rel="stylesheet" type="text/css" href="~/Content/ErrorPage/errorpage.css" />
</head>
<body>
    <div class="errorPageContainer">
        <div class="page-error-content">
            <div class="icon-page-error-base icon-not-permission">

            </div>
            <div class="page-error-title">
                @Html.I18N("RM_SSO_UnableLogin_Title")
            </div>
            <div class="page-error-desc">
                @Html.Raw(Model.FailedMessage)
            </div>
        </div>
    </div>
</body>
</html>