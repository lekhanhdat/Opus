<client>
	<endpoint address="net.tcp://0.0.0.0:0/AgentCoreService" behaviorConfiguration="globalDefaultEndPointBehavior"
	  binding="customBinding" bindingConfiguration="netTcpWithServerClientSecurityCustomBinding"
	  contract="AvePoint.GCommon.MicroKernel.ICoreService" name="AgentCoreService" />
  <endpoint address="net.tcp://0.0.0.0:0/RecordsRealTimeListener" behaviorConfiguration="globalDefaultEndPointBehavior"
  binding="customBinding" bindingConfiguration="netTcpWithServerClientSecurityCustomBinding"
  contract="AvePoint.GCommon.MicroKernel.ICoreService" name="RecordsRealTimeListener" />
	<endpoint address="https://0.0.0.0:0/ControlCore/ControlCoreService.svc"
	 binding="basicHttpBinding" bindingConfiguration="globalDefaultBasicHttpBinding"
	 contract="AvePoint.GCommon.MicroKernel.ICoreService" name="ManagerCoreService" />
	
	<endpoint address="https://0.0.0.0:0/ControlCore/ControlDataTransfer.svc"
	  binding="basicHttpBinding" bindingConfiguration="globalDefaultBasicHttpBinding"
	  contract="AvePoint.GCommon.Transfer.Data.Interface.IRelay" name="ControlDataTransfer" />
</client>