		<component id="AvePoint.Media.Core.Index.IIndexDatabaseScriptGenerator" service="AvePoint.Media.Core.Index.IIndexDatabaseScriptGenerator, MediaCoreIndex" type="AvePoint.Media.Core.Index.IndexDatabaseScriptGenerator, MediaCoreIndex" lifestyle="transient">
			<parameters>
				<ScriptDictionary>
					<dictionary>
						<entry key="GranularIndexProcessorParameter">Granular</entry>
						<entry key="GeneralIndexProcessorParameter">General</entry>
						<entry key="ArchiverIndexProcessorParameter">Archiver</entry>
						<entry key="ExportIndexProcessorParameter">Export</entry>
					</dictionary>
				</ScriptDictionary>
			</parameters>
		</component>
		<component id="AvePoint.Media.Core.Index.IIndexCacheManager" service="AvePoint.Media.Core.Index.IIndexCacheManager, MediaCoreIndex" type="AvePoint.Media.Core.Index.IndexCacheManager, MediaCoreIndex" lifestyle="transient" />
