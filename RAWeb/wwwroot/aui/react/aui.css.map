input[aria-invalid='true']:not(:is(.aui-choice-group, .aui-validation[data-multiple='true']) input),
[aria-invalid='true'] > input:not(:is(.aui-choice-group, .aui-validation[data-multiple='true']) input),
textarea[aria-invalid='true'],
[aria-invalid='true'] > textarea {
  border-image: none;
  clip-path: none;
  outline-color: var(--error-color) !important;
  border-color: var(--error-color) !important;
}
input[aria-invalid='true']:not(:is(.aui-choice-group, .aui-validation[data-multiple='true']) input):focus-visible,
[aria-invalid='true'] > input:not(:is(.aui-choice-group, .aui-validation[data-multiple='true']) input):focus-visible,
textarea[aria-invalid='true']:focus-visible,
[aria-invalid='true'] > textarea:focus-visible {
  outline-style: var(--outline-style);
}
input[aria-invalid='true']:is([type='radio'], [type='checkbox']):not(:is(.aui-choice-group, .aui-validation[data-multiple='true']) input),
[aria-invalid='true'] > input:is([type='radio'], [type='checkbox']):not(:is(.aui-choice-group, .aui-validation[data-multiple='true']) input) {
  --active-border: var(--error-color);
}
input[aria-invalid='true']:is([type='radio'], [type='checkbox']):not(:is(.aui-choice-group, .aui-validation[data-multiple='true']) input):not([class*='aui']),
[aria-invalid='true'] > input:is([type='radio'], [type='checkbox']):not(:is(.aui-choice-group, .aui-validation[data-multiple='true']) input):not([class*='aui']) {
  outline: 1px var(--outline-style) var(--error-color);
}
.aui-table[aria-invalid='true'] {
  border-image: none;
  clip-path: none;
  outline-color: var(--error-color) !important;
  border-color: transparent !important;
  outline-width: 1px;
  outline-style: solid;
}
.aui-table[aria-invalid='true']:focus-visible {
  outline-style: var(--outline-style);
}
.aui-comboboxshell[aria-invalid='true'] {
  border: 1px solid var(--error-color) !important;
  outline-color: var(--error-color) !important;
}
.aui-richeditor[aria-invalid='true'] > .aui-richeditor-uninit {
  border-image: none;
  clip-path: none;
  outline-color: var(--error-color) !important;
  border-color: var(--error-color) !important;
}
.aui-richeditor[aria-invalid='true'] > .aui-richeditor-uninit:focus-visible {
  outline-style: var(--outline-style);
}
.aui-richeditor[aria-invalid='true'] > .cke {
  border-image: none;
