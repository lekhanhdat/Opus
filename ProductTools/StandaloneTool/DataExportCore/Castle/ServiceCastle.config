		<component id="AvePoint.Media.Service.ArchiverBackup.IArchiverSiteMasterIndexService" service="AvePoint.Media.Service.ArchiverBackup.IArchiverSiteMasterIndexService, MediaServiceArchiverBackup" type="AvePoint.Media.Service.ArchiverBackup.ArchiverSiteMasterIndexService, MediaServiceArchiverBackup" lifestyle="thread" />
		<component id="AvePoint.Media.Service.ArchiverBackup.ArchiverRestoreTreeHandler" service="AvePoint.Media.Service.IRestoreServiceTreeHandler, MediaServiceApplicationModel" type="AvePoint.Media.Service.ArchiverBackup.ArchiverRestoreTreeHandler, MediaServiceArchiverBackup" lifestyle="thread" />
