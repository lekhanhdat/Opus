FROM mcr.microsoft.com/dotnet/framework/aspnet:4.7.2-20200811-windowsservercore-ltsc2019
SHELL ["cmd", "/S", "/C"]
COPY startup/ C:/startup/
RUN cd C:/startup \
    && %windir%\system32\inetsrv\appcmd.exe set AppPool DefaultAppPool -processModel.identityType:LocalSystem \
	&& PowerShell -File SecurityProtocol.ps1 \
	&& cd C:/ \
	&& rd /S /Q "C:/startup"