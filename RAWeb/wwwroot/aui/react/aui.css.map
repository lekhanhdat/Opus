.text-overflow {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
body.disabled-scroll {
  overflow: hidden;
  display: flex;
  flex-direction: column;
  height: 100%;
}
body .scroll-box {
  scrollbar-gutter: stable;
  overflow: auto;
}
.hide-scrollbar,
.hide-scrollbar body {
  overflow: hidden;
  overscroll-behavior: none;
}
.scrollbar-hidden {
  scrollbar-width: none;
}
.scrollbar-hidden::-webkit-scrollbar {
  display: none;
}
