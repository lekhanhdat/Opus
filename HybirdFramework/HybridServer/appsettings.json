{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.AspNetCore.SignalR": "Debug",
      "Microsoft.AspNetCore.Http.Connections": "Debug"
    }
  },
  "AllowedHosts": "*",
  "AVE_LOG_FILE_PATH": "~\\bin\\log",
  "SIGNALR_DB_CONNECTION_STRING": "Data Source=127.0.0.1;Initial Catalog=SignalRDB;Encrypt=False;uid=;pwd=",
  "RECO_REDIS_CONNECTION_STRING": "127.0.0.1:6379",
  "PUBLIC_IDENTITY_SERVICE_URL": "https://identity-public.sharepointguild.com",
  "PUBLIC_AUDIENCE_URL": "https://graph-public.sharepointguild.com/records",
  "IDENTITY_SERVICE_URL": "https://identity.sharepointguild.com",
  "AUDIENCE_URL": "https://graph.avepoint.internal/records",
  "SIGNALR_CLIENT_TIMEOUT_INTERVAL": "30",
  "SIGNALR_HAND_SHAKE_TIMEOUT": "15",
  "SIGNALR_KEEP_ALIVE_INTERVAL": "15",
  "SIGNALR_MAX_RECEIVE_MESSAGE_SIZE": "320",
  "SIGNALR_ENABLE_DETAILED_ERRORS": "false"
