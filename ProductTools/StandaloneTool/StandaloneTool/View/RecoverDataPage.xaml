<Page
    x:Class="StandaloneTool.View.RecoverDataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:binding="clr-namespace:StandaloneTool.View.Model.Binding"
    xmlns:control="clr-namespace:StandaloneTool.Model.CustomControl"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resource="clr-namespace:DataExportCore.Resources;assembly=DataExportCore"
    xmlns:src="clr-namespace:AvePoint.Deployment.CommonGUI;assembly=AvePoint.CallAssist.CommonDeploymentGUI"
    x:Name="myPage"
    Title="RecoverDataPage"
    d:DesignHeight="500"
    d:DesignWidth="780"
    Loaded="Window_Loaded"
    Unloaded="Window_Unloaded"
    mc:Ignorable="d">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <src:BooleanToInverseVisibilityConverter x:Key="BooleanToInverseVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid Name="WizardTextBlock" Background="#FF1188EE">
                    <TextBlock
                        Margin="0,0,0,20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        FontFamily="Segoe UI"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Style="{StaticResource PageDescriptionTextBlock}"
                        Text="{x:Static resource:CommonResourceManager.SATool_MailboxConfigTitle}" />
                </Grid>
            </Grid>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <!--  Intro  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Space  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Space  -->
                    <ColumnDefinition Width="*" />
                    <!--  Value  -->
                    <ColumnDefinition Width="Auto" />
                    <!--  Space  -->
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>
                <src:SearchTextBox
                    Name="SearchDocumenten"
                    Grid.Row="0"
                    Grid.Column="4"
                    Width="200"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    FontFamily="Segoe UI"
                    FontSize="13"
                    OnSearchEvent="SearchTextBox_OnSearchEventForEnable"
                    OnStopEvent="SearchTextBox_OnStopEventForEnable"
                    Text="{Binding SearchText}"
                    TextChanged="SearchTextBox_TextChanged">
                    <src:SearchTextBox.Watermark>
                        <TextBlock Text="{x:Static resource:CommonResourceManager.SATool_SearchWatermark}"/>
                    </src:SearchTextBox.Watermark>
                </src:SearchTextBox>
            </Grid>
            <Grid
                Grid.Row="3"
                Height="25"
                Margin="32,0,0,0" />
            <Grid Grid.Row="4" Margin="20,0,20,0">
                    <DataGrid
                        Name="dataGrid1"
                        Height="260"
                        VerticalAlignment="Center"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        HorizontalGridLinesBrush="Gainsboro"
                        ItemsSource="{Binding ArchiverSites}"
                        VerticalGridLinesBrush="Gainsboro">
                        <DataGrid.Resources>
                            <binding:BindingProxy x:Key="proxy" Data="{Binding}" />
                            <Style x:Key="CenterAlignmentStyle" TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.CellStyle>
                            <Style TargetType="{x:Type DataGridCell}">
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="Black" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="{x:Type DataGridRow}">
                                <Setter Property="HorizontalContentAlignment" Value="Left" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn>
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Checked="CheckAll_Click"
                                            IsChecked="{Binding DataContext.IsAllChecked, Mode=TwoWay, ElementName=myPage, UpdateSourceTrigger=PropertyChanged}"
                                            Unchecked="UnCheckAll_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            x:Name="CheckSingle"
                                            Margin="5,5"
                                            Click="CheckSingle_Click"
                                            IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding SiteUrl}"
                                ElementStyle="{StaticResource CenterAlignmentStyle}"
                                IsReadOnly="True">
                                <DataGridTextColumn.Header>
                                    <TextBlock Name="ColumnOneHeaderName" Text="{Binding ColumnOneHeaderText}" />
                                </DataGridTextColumn.Header>
                            </DataGridTextColumn>
                            <!--  Column two  -->
                            <!--<DataGridTemplateColumn Width="205" Visibility="{Binding Data.VColumnTwoVisibility, Converter={StaticResource BooleanToVisibilityConverter}, Source={StaticResource proxy}}">
                            <DataGridTemplateColumn.Header>
                            <TextBlock Name="ColumnTwoHeaderName" Text="{Binding ColumnTwoHeaderText}" />
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                            <ComboBox
                            Width="200"
                            DisplayMemberPath="Name"
                            IsSynchronizedWithCurrentItem="True"
                            ItemsSource="{Binding Path=SelectionList}"
                            SelectedIndex="0"
                            SelectedValue="{Binding Path=JobId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            SelectedValuePath="Key"
                            />
                            </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>-->
                        </DataGrid.Columns>
                    </DataGrid>
                <TextBlock x:Name="noDataTextBlock" 
                       Text="{x:Static resource:CommonResourceManager.SATool_NoDataFound}"
                       HorizontalAlignment="Center" 
                       VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ArchiverSites.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Grid Grid.Row="5">
                <control:PaggingControl
                    Height="50"
                    Margin="20,0"
                    VerticalAlignment="Bottom"
                    ItemsCount="{Binding DataListCount}"
                    PageRefreshCommand="{Binding PageRefreshCmd}" />
            </Grid>
        </Grid>
        <StackPanel
            Margin="0,50,0,-95"
            Background="#50333333"
            IsVisibleChanged="StackPanel_IsVisibleChanged"
            Visibility="{Binding Path=IsCheckingConfig, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=true}" />
        <src:GifImage
            Width="60"
            Height="60"
            Margin="1,100,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Source="..\Images\loading.gif"
            Visibility="{Binding Path=IsCheckingConfig, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=true}" />

    </Grid>
</Page>
