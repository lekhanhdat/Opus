<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1"/>
    
  </startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.SharePoint.Client" publicKeyToken="71e9bce111e9429c" culture="neutral" />
        <codeBase version="16.1.5813.1200" href=".\2013\Microsoft.SharePoint.Client.dll" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Microsoft.SharePoint.Client.Runtime" publicKeyToken="71e9bce111e9429c" culture="neutral" />
        <codeBase version="16.1.5813.1200" href=".\2013\Microsoft.SharePoint.Client.Runtime.dll" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
        <bindingRedirect oldVersion="0.0.0.0-11.0.0.0" newVersion="11.0.0.0" />
      </dependentAssembly>
      <probing privatePath="Resources;2013;x86"/>
      <generatePublisherEvidence enabled="false"/>
    </assemblyBinding>
  </runtime>

  <log4net>
    <root>
      <level value="INFO" />
      <!--<appender-ref ref="AveSeparativeLogAppender" />-->
      <!--<appender-ref ref="HighLevelEventLogAppender" />-->
       <appender-ref ref="ConsoleAppender"/> 
    </root>
    <appender name="LogFileAppender" type="log4net.Appender.RollingFileAppender">
      <lockingModel type="log4net.Appender.FileAppender+MinimalLock" />
      <file type="log4net.Util.PatternString" value="%property{RelatedPath}..\Logs\%property{ProcessName}%property{LogFilePostfix}.log" />
      <param name="AppendToFile" value="true" />
      <rollingStyle value="Size" />
      <maximumFileSize value="5MB" />
      <maxSizeRollBackups value="100" />
      <encoding value="utf-8" />
      <layout type="log4net.Layout.PatternLayout">
        <header value="Level DateTime Thread Class EventID- Message &#xD;&#xA;" />
        <param name="ConversionPattern" value="%-5level %date{MM-dd HH:mm:ss,fff} %thread %logger %property{EventID}- %message  %newline" />
      </layout>
    </appender>
    <appender name="AveSeparativeLogAppender" type="AvePoint.GCommon.AveSeparativeLogAppender">
      <lockingModel type="AvePoint.GCommon.MultiTenantFileLocker" />
      <!-- !Attention : When configuring the value of "log4net.Util.PatternString", "\Logs\%property{TenantAccountId}\%property{ProcessName}%property{LogFilePostfix}.log" should be reserved, only the path ahead of this is configurable -->
      <file type="log4net.Util.PatternString" value="C:\DocAveOnlineTenant\Logs\{0}\%property{ProcessName}{1}.log" />
      <param name="AppendToFile" value="true" />
      <rollingStyle value="Size" />
      <datePattern value="yyyyMMdd" />
      <maximumFileSize value="50MB" />
      <maxSizeRollBackups value="100" />
      <encoding value="utf-8" />
      <layout type="log4net.Layout.PatternLayout">
        <header value="Level DateTime Thread Class EventID- Message &#xD;&#xA;" />
        <param name="ConversionPattern" value="%-5level %date{MM-dd HH:mm:ss,fff} %thread %logger %property{EventID}- %message  %newline" />
      </layout>
    </appender>
    <appender name="HighLevelEventLogAppender" type="AvePoint.GCommon.AveHighLevelEventLogAppender">
      <encoding value="utf-8" />
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%-5level %date{MM-dd HH:mm:ss,fff} module:%property{ModuleName} thread:%thread %logger- %message eventID:%property{EventID} %newline" />
      </layout>
    </appender>
    <appender name="ConsoleAppender" type="log4net.Appender.ColoredConsoleAppender">
      <target value="Console.Out" />
      <mapping>
        <level value="ERROR" />
        <foreColor value="Red, HighIntensity" />
      </mapping>
      <mapping>
        <level value="WARN" />
        <foreColor value="Yellow, HighIntensity" />
      </mapping>
      <mapping>
        <level value="DEBUG" />
        <foreColor value="Green, HighIntensity" />
      </mapping>
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%-5level %date thread:[%thread] %logger - %message%newline" />
      </layout>
    </appender>
  </log4net>
</configuration>
