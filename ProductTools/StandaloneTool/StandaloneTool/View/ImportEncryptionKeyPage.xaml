<Page
    x:Class="StandaloneTool.View.ImportEncryptionKeyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resource="clr-namespace:DataExportCore.Resources;assembly=DataExportCore"
    xmlns:src="clr-namespace:AvePoint.Deployment.CommonGUI;assembly=AvePoint.CallAssist.CommonDeploymentGUI"
    Title="ImportEncryptionPage"
    d:DesignHeight="406"
    d:DesignWidth="540"
    mc:Ignorable="d">
    <Grid>
        <Grid
            Height="Auto"
            HorizontalAlignment="Stretch"
            Background="Transparent"
            DockPanel.Dock="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid Background="#FF1188EE">
                    <TextBlock
                        Grid.Row="1"
                        Margin="0,0,0,20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        FontFamily="Segoe UI"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="White"
                        Style="{StaticResource PageDescriptionTextBlock}"
                        Text="{x:Static resource:CommonResourceManager.SATool_ImportEncryptionKeyPageTitle}" />
                </Grid>
            </Grid>
            <Grid Grid.Row="2" Width="520">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Width="520"
                    HorizontalAlignment="Center"
                    Style="{StaticResource PageDescriptionTextBlock}"
                    Text="{x:Static resource:CommonResourceManager.SATool_ImportEncryptionKeyPageDesc}"
                    TextAlignment="Left"
                    TextWrapping="Wrap" />
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,5">
                        <TextBlock
                            HorizontalAlignment="Left"
                            Style="{StaticResource PageIntroTextBlock}"
                            Text="{x:Static resource:CommonResourceManager.SATool_DataTypeTitle}" />
                    </StackPanel>
                    <ComboBox
                        Name="comboBoxDataType"
                        Grid.Row="1"
                        SelectionChanged="ComboBoxDataType_SelectionChanged"
                        Text="{Binding DataType}" />
                    <TextBlock
                        Grid.Row="2"
                        Margin="0,5,0,0"
                        FontSize="13" />
                </Grid>
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                        <TextBlock
                            HorizontalAlignment="Left"
                            Style="{StaticResource PageIntroTextBlock}"
                            Text="{x:Static resource:CommonResourceManager.SATool_BackupJobIndexTitle}" />
                        <TextBlock
                            Margin="3,0,0,0"
                            HorizontalAlignment="Left"
                            Foreground="Red"
                            Text="*" />
                    </StackPanel>
                    <src:TextBoxEx
                        Grid.Row="1"
                        Width="430"
                        MinHeight="36"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        AllowDrop="True"
                        ErrorMsg="{Binding EncryptionFilePathMsg}"
                        ShowMsgOnBottom="True"
                        Text="{Binding EncryptionFilePath, UpdateSourceTrigger=PropertyChanged}"
                        d:LayoutOverrides="GridBox">
                        <i:Interaction.Triggers>
                            <i:EventTrigger EventName="PreviewDragOver">
                                <i:InvokeCommandAction Command="{Binding PreviewDragOverCommand}" PassEventArgsToCommand="True" />
                            </i:EventTrigger>
                            <i:EventTrigger EventName="PreviewDrop">
                                <i:InvokeCommandAction Command="{Binding PreviewDropCommand}" PassEventArgsToCommand="True" />
                            </i:EventTrigger>
                        </i:Interaction.Triggers>
                    </src:TextBoxEx>
                    <Button
                        Grid.Row="1"
                        Width="80"
                        MinHeight="36"
                        Margin="10,0,0,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Command="{Binding SelectFileCommand}"
                        Content="{x:Static resource:CommonResourceManager.SATool_BrowseButtonTitle}" />
                    <TextBlock
                        Grid.Row="2"
                        Margin="0,5,0,0"
                        FontSize="13" />
                </Grid>
                <Grid Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                        <TextBlock
                            HorizontalAlignment="Left"
                            Style="{StaticResource PageIntroTextBlock}"
                            Text="{x:Static resource:CommonResourceManager.SATool_DecryptionPassword}" />
                        <TextBlock
                            Margin="3,0,0,0"
                            HorizontalAlignment="Left"
                            Foreground="Red"
                            Text="*" />
                    </StackPanel>
                    <TextBlock
                        Grid.Row="1"
                        MaxWidth="500"
                        Margin="0,-5,0,5"
                        HorizontalAlignment="Left"
                        Style="{StaticResource PageDescriptionTextBlock2}"
                        Text="{x:Static resource:CommonResourceManager.SATool_DecryptionPwdDesc}"
                        TextAlignment="Left"
                        TextWrapping="Wrap" />
                    <PasswordBox
                        Grid.Row="2"
                        Width="520"
                        MinHeight="36"
                        VerticalAlignment="Center"
                        src:PasswordBoxBindingHelper.BoundPassword="{Binding Path=EncryptionPwd, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        src:PasswordBoxBindingHelper.IsPasswordBindingEnabled="True"
                        AllowDrop="True"
                        d:LayoutOverrides="GridBox" />
                    <TextBlock
                        Grid.Row="3"
                        Margin="0,5,0,0"
                        FontSize="13"
                        Foreground="Red"
                        Text="{Binding EncryptionPwdMsg, Mode=TwoWay}" />
                </Grid>
            </Grid>
        </Grid>
        <StackPanel
            Margin="0,50,0,-115"
            Background="#50333333"
            Visibility="{Binding Path=IsCheckingConfig, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=true}">
            <i:Interaction.Triggers>
                <i:EventTrigger EventName="IsVisibleChanged">
                    <i:InvokeCommandAction Command="{Binding IsVisibleChangedCommand}" />
                </i:EventTrigger>
            </i:Interaction.Triggers>
        </StackPanel>
        <src:GifImage
            Width="60"
            Height="60"
            Margin="1,100,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Source="..\Images\loading.gif"
            Visibility="{Binding Path=IsCheckingConfig, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=true}" />
    </Grid>
</Page>
