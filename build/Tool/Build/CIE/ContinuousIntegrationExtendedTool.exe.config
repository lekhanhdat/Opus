<?xml version="1.0"?>
<configuration>
  <appSettings>    
    <add key="commonConfigFile" value="Tool\CIE\IntegrationCommonConfig.xml"/>
  </appSettings>
  <system.serviceModel>
    <client>
      <endpoint address="net.tcp://10.1.4.5:9999/CheckService" binding="netTcpBinding" bindingConfiguration="userDefinedTcpBinding" contract="AvePoint.Integration.ToolCollection.ValidationContract.IPackageValidationContracts" name="ccFtpServer"/>
      <endpoint address="net.tcp://10.2.0.7:50001/CheckService" binding="netTcpBinding" bindingConfiguration="userDefinedTcpBinding" contract="AvePoint.Integration.ToolCollection.ValidationContract.IPackageValidationContracts" name="dlFtpServer"/>
    </client>
    <bindings>
      <netTcpBinding>
        <binding name="userDefinedTcpBinding" closeTimeout="01:10:00" openTimeout="01:10:00" receiveTimeout="01:10:00" sendTimeout="01:10:00">
          <security mode="None"/>
        </binding>
      </netTcpBinding>
    </bindings>
  </system.serviceModel>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0"/>
  </startup>
</configuration>
