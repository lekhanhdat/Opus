<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="BCStyleLink.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Focus Visual -->

    <Style x:Key="RadioButtonFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border>
                        <Rectangle
                            Margin="15,0,0,0"
                            StrokeThickness="1"
                            Stroke="#60000000"
                            StrokeDashArray="1 2" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SimpleStyles: RadioButton -->
    <Style x:Key="{x:Type RadioButton}" TargetType="{x:Type RadioButton}">
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource RadioButtonFocusVisual}" />
        <Setter Property="FontFamily" Value="Arial" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#FF333333" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <ControlTemplate.Resources>
                        <Storyboard x:Key="RadioButtonOnMouseEnter">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)"
                                                           Storyboard.TargetName="CheckMarkOver">
                                <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)"
                                                           Storyboard.TargetName="CircleFillOver">
                                <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)"
                                                           Storyboard.TargetName="BackgroundOver">
                                <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                        <Storyboard x:Key="RadioButtonOnMouseLeave">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)"
                                                           Storyboard.TargetName="BackgroundOver">
                                <LinearDoubleKeyFrame KeyTime="0" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)"
                                                           Storyboard.TargetName="CheckMarkOver">
                                <LinearDoubleKeyFrame KeyTime="0" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)"
                                                           Storyboard.TargetName="CircleFillOver">
                                <LinearDoubleKeyFrame KeyTime="0" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </ControlTemplate.Resources>
                    <BulletDecorator Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <BulletDecorator.Bullet>
                            <Grid Width="12" Height="12">
                                <Ellipse x:Name="Border" Fill="{DynamicResource NormalSingleFill}"
                                         StrokeThickness="1"
                                         Stroke="{DynamicResource NormalSingleBrush}" Visibility="Visible" />
                                <Ellipse x:Name="BackgroundDis" Width="Auto" Height="Auto" StrokeThickness="1"
                                         Stroke="#FFAAAAAA" Fill="White" Visibility="Collapsed" Margin="0" />
                                <Ellipse x:Name="BackgroundOver" Width="Auto" Height="Auto" Fill="#FFDEF9FA"
                                         Stroke="#FF5989A5" StrokeThickness="1" Visibility="Visible" Opacity="0"
                                         Margin="0" />
                                <Ellipse x:Name="BackgroundPress" Width="Auto" Height="Auto" Fill="#FFC2E4F6"
                                         Stroke="#FF2C628B" StrokeThickness="1" Visibility="Collapsed" Margin="0" />
                                <Ellipse x:Name="CircleFill" Margin="2" Fill="#FFCACFD5" StrokeThickness="1"
                                         Stroke="{DynamicResource NormalBackgroundStroke}" />
                                <Ellipse x:Name="CircleFillOver" Margin="2" Fill="#FFAFDEFD" StrokeThickness="1"
                                         Visibility="Visible" Opacity="0">
                                    <Ellipse.Stroke>
                                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                            <GradientStop Color="#FF79C6F9" Offset="0" />
                                            <GradientStop Color="#FFCFEDFD" Offset="1" />
                                        </LinearGradientBrush>
                                    </Ellipse.Stroke>
                                </Ellipse>
                                <Ellipse x:Name="CircleFillPress" Margin="2" Fill="#FF90CFFC" StrokeThickness="1"
                                         Visibility="Collapsed">
                                    <Ellipse.Stroke>
                                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                                            <GradientStop Color="#FF5EB6F7" Offset="0" />
                                            <GradientStop Color="#FFC0E7FC" Offset="1" />
                                        </LinearGradientBrush>
                                    </Ellipse.Stroke>
                                </Ellipse>
                                <Ellipse x:Name="CircleFillDis" Margin="1" Fill="#FFDDDDDD" Visibility="Collapsed"
                                         Stroke="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}" />
                                <Ellipse x:Name="CircleGradient" Margin="3" StrokeThickness="1" Visibility="Visible"
                                         Fill="{DynamicResource GradientBrush}" />
                                <Ellipse x:Name="CheckMark" Visibility="Collapsed" Margin="3"
                                         Fill="{DynamicResource CheckMarkBrush}" Stroke="#FF275674" StrokeThickness="1" />
                                <Ellipse x:Name="CheckMarkOver" Visibility="Collapsed" Margin="3" Stroke="#FF275674"
                                         StrokeThickness="1" Fill="{DynamicResource CheckMarkOverBrush}" Opacity="0" />
                                <Ellipse x:Name="CheckMarkPress" Margin="3"
                                         Fill="{DynamicResource CheckMarkPressBursh}" Stroke="#FF275674"
                                         StrokeThickness="1" Visibility="Collapsed" />
                                <Ellipse x:Name="Focused" Margin="-1" Stroke="{DynamicResource FocusBorderBrush}"
                                         StrokeThickness="1" IsHitTestVisible="false" Visibility="Collapsed" />
                            </Grid>
                        </BulletDecorator.Bullet>
                        <ContentPresenter
                            Margin="5,0,4,0"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Left"
                            RecognizesAccessKey="True" />
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard x:Name="RadioButtonOnMouseLeave_BeginStoryboard"
                                             Storyboard="{StaticResource RadioButtonOnMouseLeave}" />
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard Storyboard="{StaticResource RadioButtonOnMouseEnter}" />
                        </EventTrigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Focused" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="CheckMarkOver" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="true">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CheckMarkOver" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter TargetName="BackgroundPress" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CircleFillPress" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter TargetName="BackgroundDis" Property="Visibility" Value="Visible" />
                            <Setter TargetName="CircleFillDis" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
                            <Setter Property="Stroke" TargetName="CheckMark" Value="#FF919191" />
                            <Setter Property="Fill" TargetName="CheckMark" Value="{DynamicResource CheckMarkDisBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style x:Key="CTItemRadioButton" TargetType="{x:Type RadioButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RadioButton}">
                    <Grid>
                        <Rectangle x:Name="BackgroundGradientSelectedDisabled" Stroke="{x:Null}" RadiusX="1"
                                   RadiusY="1" Opacity="1" Fill="#FFA8A8A8" Height="30" Visibility="Collapsed"
                                   HorizontalAlignment="Stretch" Margin="0" Width="Auto" />
                        <Rectangle x:Name="BackgroundGradientOver" Fill="#FFA8A8A8" RadiusX="1" RadiusY="1" Opacity="1"
                                   Height="30" Visibility="Collapsed" HorizontalAlignment="Stretch" Margin="0"
                                   Width="Auto" />
                        <Rectangle x:Name="BackgroundGradientSelected" Fill="#FFA8A8A8" RadiusX="1" RadiusY="1"
                                   Opacity="0" Height="30" Margin="0" Width="Auto" />
                        <Rectangle x:Name="FocusVisualElement" Stroke="#FF757575" StrokeThickness="1"
                                   Visibility="Visible" RadiusX="1" RadiusY="1" Focusable="True"
                                   VerticalAlignment="Stretch" Height="30" Opacity="0" Margin="0" Width="Auto" />
                        <TextBlock x:Name="TextBlockNormal" HorizontalAlignment="Left" Margin="15,0,0,0"
                                   VerticalAlignment="Center" Height="Auto" Foreground="#FF0077BB"
                                   Text="{TemplateBinding Content}" TextWrapping="Wrap" />
                        <TextBlock x:Name="TextBlockSelect" HorizontalAlignment="Left" Margin="15,0,0,0"
                                   VerticalAlignment="Center" Height="Auto" Text="{TemplateBinding Content}"
                                   TextWrapping="Wrap" Foreground="White" Visibility="Collapsed" />
                        <TextBlock x:Name="TextBlockDisabled" HorizontalAlignment="Left" Margin="15,0,0,0"
                                   VerticalAlignment="Center" Height="Auto" TextWrapping="Wrap" Foreground="#FF888888"
                                   Visibility="Collapsed" Text="{TemplateBinding Content}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter Property="Visibility" TargetName="TextBlockSelect" Value="Collapsed" />
                            <Setter Property="Opacity" TargetName="BackgroundGradientSelected" Value="0" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Visibility" TargetName="BackgroundGradientSelectedDisabled"
                                    Value="Visible" />
                            <Setter Property="Visibility" TargetName="TextBlockDisabled" Value="Visible" />
                            <Setter Property="Visibility" TargetName="TextBlockNormal" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Visibility" TargetName="BackgroundGradientOver" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Visibility" TargetName="TextBlockSelect" Value="Visible" />
                            <Setter Property="Opacity" TargetName="BackgroundGradientSelected" Value="1" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Opacity" TargetName="FocusVisualElement" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>