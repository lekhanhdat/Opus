<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:AutoInstallation.Common.GUI"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/CloudAgentConfigurationToolCommonGUI;component/Styles/DefaultStyle.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--Base-->
    <Style x:Key="TextBoxBasicTheme" TargetType="{x:Type TextBox}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!-- <Setter Property="OverridesDefaultStyle" Value="True"/>-->
        <Setter Property="FontFamily" Value="Arial" />
        <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="MinWidth" Value="80" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="AllowDrop" Value="true" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBoxBase}">
                    <ControlTemplate.Resources>
                        <Storyboard x:Key="TextBoxOnMouseEnter">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)"
                                                           Storyboard.TargetName="Over">
                                <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                        <Storyboard x:Key="TextBoxOnMouseLeave">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)"
                                                           Storyboard.TargetName="Over">
                                <SplineDoubleKeyFrame KeyTime="0" Value="1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </ControlTemplate.Resources>
                    <Grid MinHeight="24">
                        <Border x:Name="Border" Padding="2" MinHeight="24" Background="#FFF" BorderBrush="#FFABABAB"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="Over" BorderThickness="{TemplateBinding BorderThickness}" Opacity="0"
                                Visibility="Visible" Margin="0" Background="{x:Null}" BorderBrush="#FF4488CC" />
                        <Border x:Name="ReadOnly" Background="#CCE8E8E8"
                                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="#FF888888"
                                Visibility="Collapsed" Margin="0" HorizontalAlignment="Stretch" Height="Auto"
                                VerticalAlignment="Stretch" Width="Auto" />
                        <ScrollViewer Margin="0,2,0,0" x:Name="PART_ContentHost"
                                      Template="{DynamicResource TextBoxScrollViewer}" FontFamily="Arial" />
                        <Border x:Name="Disable" Background="#CCE8E8E8" BorderBrush="#FFB7B7B7"
                                BorderThickness="{TemplateBinding BorderThickness}" IsHitTestVisible="False"
                                Visibility="Collapsed" Margin="0" />
                        <Border x:Name="Focus" BorderThickness="{TemplateBinding BorderThickness}"
                                IsHitTestVisible="False" Visibility="Collapsed" Margin="-1" BorderBrush="#9DF" />
                        <!--<ContentControl x:Name="Watermark" Background="{TemplateBinding Background}" Content="{TemplateBinding Watermark}" Foreground="#FFAAAAAA" FontWeight="{TemplateBinding FontWeight}" FontStyle="Normal" FontStretch="{TemplateBinding FontStretch}" FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" IsHitTestVisible="False" IsTabStop="False" Margin="2,0,0,0" Opacity="0" Padding="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>-->
                    </Grid>
                    <ControlTemplate.Triggers>

                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard Storyboard="{StaticResource TextBoxOnMouseEnter}" />
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard Storyboard="{StaticResource TextBoxOnMouseLeave}" />
                        </EventTrigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="ReadOnly" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Disable" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--Default-->
    <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBoxBasicTheme}" />

    <!--Extra-->
    <Style TargetType="{x:Type local:TextBoxEx}" BasedOn="{StaticResource TextBoxBasicTheme}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <!--<ControlTemplate TargetType="{x:Type TextBox}">-->
                <ControlTemplate TargetType="{x:Type local:TextBoxEx}">
                    <ControlTemplate.Resources>
                        <Storyboard x:Key="TextBoxOnMouseEnter">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)"
                                                           Storyboard.TargetName="Over">
                                <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                        <Storyboard x:Key="TextBoxOnMouseLeave">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)"
                                                           Storyboard.TargetName="Over">
                                <SplineDoubleKeyFrame KeyTime="0" Value="1" />
                                <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </ControlTemplate.Resources>

                    <Grid x:Name="RootElement" VerticalAlignment="Center">
                        <!--RowDefinitions need not to be changed-->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="Border" Background="#FFF" MinHeight="24" BorderBrush="#FFABABAB"
                                BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="Over" BorderThickness="{TemplateBinding BorderThickness}" Opacity="0"
                                Visibility="Visible" Margin="0" Background="{x:Null}" BorderBrush="#FF4488CC" />
                        <Border x:Name="ReadOnly" Background="#CCE8E8E8"
                                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="#FF888888"
                                Visibility="Collapsed" HorizontalAlignment="Stretch" Height="Auto"
                                VerticalAlignment="Stretch" Width="Auto" />
                        <ScrollViewer Margin="0,2,0,-2" Width="{TemplateBinding TextBoxWidth}"
                                      x:Name="PART_ContentHost" VerticalAlignment="Center" FontFamily="Arial"
                                      FontSize="11" />
                        <Border x:Name="Disable" Background="#CCE8E8E8" BorderBrush="#FFB7B7B7"
                                BorderThickness="{TemplateBinding BorderThickness}" IsHitTestVisible="False"
                                Visibility="Collapsed" Margin="0" />
                        <Border x:Name="Focus" BorderThickness="{TemplateBinding BorderThickness}"
                                IsHitTestVisible="False" Visibility="Collapsed" Margin="-1" BorderBrush="#9DF" />
                        <Label x:Name="WaterMark" Content="{TemplateBinding Tag}" Visibility="Collapsed"
                               Focusable="False" Foreground="#FFCCCCCC" Margin="3,0,0,0" Padding="0" FontFamily="Arial"
                               HorizontalAlignment="Stretch" VerticalAlignment="Center" Width="Auto" Height="Auto" />
                        <Grid Width="{TemplateBinding TextBoxWidth}" Visibility="Collapsed" Grid.Row="1"
                              Grid.Column="0" Grid.RowSpan="2" x:Name="ValidationPanel" HorizontalAlignment="Left"
                              VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0"
                                   Source="/CloudAgentConfigurationToolCommonGUI;component/UI/TextBox/Images/errormsg_16x16.png"
                                   Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" x:Name="ValidationMsg"
                                       Text="{Binding ErrorMsg}" Foreground="Red"
                                       DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
                        </Grid>
                    </Grid>


                    <ControlTemplate.Triggers>

                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard Storyboard="{StaticResource TextBoxOnMouseEnter}" />
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard Storyboard="{StaticResource TextBoxOnMouseLeave}" />
                        </EventTrigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="ReadOnly" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Visibility" TargetName="Disable" Value="Visible" />
                            <Setter Property="Foreground" TargetName="WaterMark" Value="#FFBFBFBF" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsFocused" Value="False" />
                                <Condition Property="Text" Value="" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Visibility" TargetName="WaterMark" Value="Visible" />
                            <!--<Setter Property="Margin" TargetName="WaterMark" Value="0"/>-->
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="1" />
    </Style>


    <!-- SimpleStyles: RichTextBox -->

    <!--<Style x:Key="{x:Type RichTextBox}" BasedOn="{StaticResource {x:Type TextBox}}" TargetType="{x:Type RichTextBox}">
        <Style.Resources>
            <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
                <Setter Property="OverridesDefaultStyle" Value="true"/>
