<config.example>
  <!--For Content Manager Column Mapping-->
  <columnMapping>
    <list name="*">
      <column name="ToMetadata">
        <!--这个示例不会对column进行改名，但是会改变类型和Value-->
        <destinationColumnInfo>
          <type>Managed Metadata</type>
          <termGroup>System</termGroup>
          <termSet>Keywords</termSet>
        </destinationColumnInfo>
        <values>
          <value source="ValueA;#ValueB" destination="Value1;#Value2"/>
          <value source="ValueB" destination="Value2"/>
          <value source="ValueC" destination="Value3"/>
          <value source="ValueD" destination="Value4"/>
        </values>
      </column>
      <column name="Strategy">
        <!--这个示例会对column进行改名,保持类型和Value-->
        <destinationcolumnInfo>
          <name>Initiative</name>
        </destinationcolumnInfo>
      </column>
      <column name="choicecol">
        <!--这个示例会对column更改类型-->
        <destinationcolumnInfo>
          <type>Lookup</type>
          <webRelativeUrl>sites/site3</webRelativeUrl>
          <listTitle>look1</listTitle>
          <fieldName>Title</fieldName>
        </destinationcolumnInfo>
        <values>
          <value source="chi" destination="Value1"/>
          <value source="ValueB" destination="Value2"/>
          <value source="ValueC" destination="Value3"/>
          <value source="ValueD" destination="Value4"/>
        </values>
      </column>
    </list>
  </columnMapping>
  <UserMappings>
    <UserMapping SourceUser="domain1\user1" DestinationUser="domain2\user1" />
    <UserMapping SourceUser="domain1\user2" DestinationUser="domain2\user2" />
    <UserMapping SourceUser="domain1\user3" DestinationUser="domain2\user3" />
  </UserMappings>
  <DomainMappings>
    <DomainMapping SourceDomain= "domain1" DestinationDomain= "domain2" />
  </DomainMappings>
  <CustomTemplateMapping>
    <SiteCollection name="*">
      <TemplateMappings>
        <TemplateMapping key="aa" value="bb"/>
        <TemplateMapping key="cc" value="dd"/>
      </TemplateMappings>
    </SiteCollection>
    <Web name="subWeb">
      <TemplateMappings>
        <TemplateMapping key="2" value="3"/>
        <TemplateMapping key="4" value="5"/>
      </TemplateMappings>
    </Web>
  </CustomTemplateMapping>
</config.example>
