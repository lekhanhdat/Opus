          [COL_NAME] VARCHAR(32672),
          [COL_PLAN_ID] VARCHAR(256),
          [COL_JOB_ID] VARCHAR(256),
          [COL_CYCLE_ID] VARCHAR(256),
          [COL_JOB_TYPE] VARCHAR(256),
          [COL_PATH_MD5] CHAR(32),
          [COL_PARENT_PATH_MD5] CHAR(32),
		  [COL_BACKUP_TYPE] INT,
          [COL_BACKUP_TIME] BIGINT,
		  [COL_DATA_FILE_OFFSET] BIGINT,
		  [COL_DATA_FILE_LENGTH] BIGINT,		  
          [COL_DATA_FILE_NUMBER] BIGINT,         
          [COL_DATA_FILE_PREFIX_NUMBER] BIGINT,      
          [COL_META_DATA_HEADER_OFFSET] BIGINT,
		  [COL_CONTENT_OFFSET] BIGINT,
          [COL_CONTENT_LENGTH] BIGINT,                
          [COL_CONTENT_DATA_OFFSET] BIGINT,
		  [COL_CONTENT_DATA_HEADER_OFFSET] BIGINT,
          [COL_CONTENT_DATA_FILE_NUMBER] BIGINT,
          [COL_CONTENT_DATA_FILE_PREFIX_NUMBER] BIGINT,
		  [COL_CONTENT_PAGE_SIZE] BIGINT,
		  [COL_SEQUENCE] BIGINT,                     
          [COL_PLATFORM_TYPE] INT,
          [COL_VERSION] BIGINT,
		  [COL_ATTRIBUTES] VARCHAR(32762),
          [COL_STORAGEPOLICYID] CHAR(36),
          [COL_STORAG_ACCESSTIERTYPE] INT,
          [COL_RETENTION_STATUS] INT,
          [COL_STORAGEINFO] TEXT,        		  		 
		  [COL_CRC] BIGINT,
          [COL_STORAGE_CRC32] VARCHAR(32672),
		  [COL_NODE_TYPE] INT,
		  [COL_EXTENSION_1] INT,        
          [COL_EXTENSION_2] BIGINT,       
          [COL_EXTENSION_3] VARCHAR(32),      
          [COL_EXTENSION_4] TEXT,
		  [COL_SENDER] TEXT,
		  [COL_DISPLAY_TO] TEXT,
		  [COL_SEND_DATE] BIGINT,
		  [COL_HAS_ATTACH] BOOLEAN,
		  [COL_CATEGORY] TEXT,
		  [COL_CURRENT_JOB_ID] VARCHAR(256),
		  [COL_FILE_EXTENSION_NAME] TEXT,
		  [COL_DISPLAYNAME] TEXT
);

CREATE TABLE [tb_job_info](
          [COL_GUID] VARCHAR(36) not null primary key,
          [COL_JOB_ID] VARCHAR(256),
          [COL_KEY] VARCHAR(32672),
          [COL_VALUE] VARCHAR(32672),
		  [COL_EXTENSION_1] INT,
          [COL_EXTENSION_2] BIGINT,              
          [COL_EXTENSION_3] VARCHAR(32),       
          [COL_EXTENSION_4] TEXT
);

CREATE TABLE [tb_master_index](
            [COL_ID] CHAR(36) not null primary key,
            [COL_PLAN_ID] VARCHAR(256),
            [COL_CYCLE_ID] VARCHAR(256),
            [COL_JOB_ID] VARCHAR(256),
            [COL_LOGICAL_DEVICE_ID] VARCHAR(255),
            [COL_BACKUP_PLAN_TYPE] INTEGER,
            [COL_BACKUP_TIME] BIGINT,
            [COL_USER_ADDRESS] VARCHAR(255),
            [COL_MAX_DATA_BLOCK_SIZE] INTEGER,
            [COL_ENCRYPTION_INFO] TEXT,
			[COL_MODIFY_DATA] INTEGER, 
			[COL_GROUP_NAME] VARCHAR(32672),
			[COL_EXTENSION_1] INT,          
            [COL_EXTENSION_2] BIGINT,                        
            [COL_EXTENSION_3] VARCHAR(32),
			[COL_CURRENT_JOB_ID] VARCHAR(256)
);

CREATE TABLE [tb_datamd5_index](
          [COL_PLAN_ID] VARCHAR(256),
          [COL_CYCLE_ID] VARCHAR(256),
          [COL_JOB_ID] VARCHAR(256),
          [COL_DATA_NAME] VARCHAR(32672),
          [COL_DATA_OBJECT_ID] VARCHAR(32672),
          [COL_DATA_MD5] CHAR(32)
);

CREATE TABLE [tb_planner_index](
          [COL_ID] CHAR(36) not null ,
          [COL_FLAG] BIGINT,
          [COL_TYPE] INT,
          [COL_PATH] VARCHAR(256),
		  [COL_PARENT_NODE_NAME] VARCHAR(32672),
		  [COL_PARENT_NODE_ID] VARCHAR(32672),
          [COL_NAME] VARCHAR(32672),
		  [COL_CURRENT_NODE_NAME] VARCHAR(32672),
		  [COL_CURRENT_NODE_ID] VARCHAR(32672),
		  [COL_BUCKET_NAME] VARCHAR(32672),
	      [COL_BUCKET_ID] VARCHAR(32672),
		  [COL_PROGRESS] INT,
		  [COL_LABELS] VARCHAR(32672),
		  [COL_PRIVACY] INT,
          [COL_PLAN_ID] VARCHAR(256),
          [COL_JOB_ID] VARCHAR(256),
          [COL_CYCLE_ID] VARCHAR(256),
          [COL_JOB_TYPE] VARCHAR(256),
          [COL_PATH_MD5] CHAR(32),
          [COL_PARENT_PATH_MD5] CHAR(32),
		  [COL_BACKUP_TYPE] INT,
          [COL_BACKUP_TIME] BIGINT,
		  [COL_DATA_FILE_OFFSET] BIGINT,
		  [COL_DATA_FILE_LENGTH] BIGINT,		  
          [COL_DATA_FILE_NUMBER] BIGINT,         
          [COL_DATA_FILE_PREFIX_NUMBER] BIGINT,      
          [COL_META_DATA_HEADER_OFFSET] BIGINT,
		  [COL_CONTENT_OFFSET] BIGINT,
          [COL_CONTENT_LENGTH] BIGINT,                
          [COL_CONTENT_DATA_OFFSET] BIGINT,
		  [COL_CONTENT_DATA_HEADER_OFFSET] BIGINT,
          [COL_CONTENT_DATA_FILE_NUMBER] BIGINT,
          [COL_CONTENT_DATA_FILE_PREFIX_NUMBER] BIGINT,
		  [COL_CONTENT_PAGE_SIZE] BIGINT,
		  [COL_SEQUENCE] BIGINT,                     
          [COL_PLATFORM_TYPE] INT,
          [COL_VERSION] BIGINT,
		  [COL_ATTRIBUTES] VARCHAR(32762),
          [COL_STORAGEPOLICYID] CHAR(36),
          [COL_STORAG_ACCESSTIERTYPE] INT, 
          [COL_RETENTION_STATUS] INT,
          [COL_STORAGEINFO] TEXT,        		  		 
		  [COL_CRC] BIGINT,
          [COL_STORAGE_CRC32] VARCHAR(32672),
		  [COL_NODE_TYPE] INT,
		  [COL_EXTENSION_1] INT,        
          [COL_EXTENSION_2] BIGINT,       
          [COL_EXTENSION_3] VARCHAR(32),      
          [COL_EXTENSION_4] TEXT,
		  [COL_SENDER] TEXT,
		  [COL_DISPLAY_TO] TEXT,
		  [COL_SEND_DATE] BIGINT,
		  [COL_HAS_ATTACH] BOOLEAN,
		  [COL_CATEGORY] TEXT,
		  [COL_CURRENT_JOB_ID] VARCHAR(256),
		  [COL_FILE_EXTENSION_NAME] TEXT,
		  [COL_DISPLAYNAME] TEXT
);

