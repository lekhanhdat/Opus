<src:BaseWindow
    x:Class="StandaloneTool.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:src="clr-namespace:AvePoint.Deployment.CommonGUI;assembly=AvePoint.CallAssist.CommonDeploymentGUI"
    Title="MainWindow"
    ResizeMode="NoResize"
    Width="810"
    Height="650"
    Icon="/Images/logo.ico"
    Loaded="BaseWindow_Loaded"
    TitleImg="/StandaloneTool;component/Images/logo.png"
    TitleText="AvePoint Opus Standalone Tool"
    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid Margin="0,38,0,0" Background="#FFEEF2F6">
        <Grid
            x:Name="footer"
            Height="80"
            Margin="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom">
            <StackPanel
                Width="Auto"
                Margin="0"
                HorizontalAlignment="Left"
                Orientation="Horizontal">
                <Button
                    x:Name="BtnBack"
                    Width="120"
                    Height="40"
                    Margin="{StaticResource MainWindowButtonMargin}"
                    Command="{Binding BackOperator.Command}"
                    Content="{Binding BackOperator.Content}"
                    Style="{StaticResource NotRecommandedButtonStyle}"
                    Visibility="{Binding ModelCommonInfo.IsCover, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Button
                    x:Name="BtnNext"
                    Width="120"
                    Height="40"
                    Margin="{StaticResource MainWindowButtonMargin}"
                    Command="{Binding NextOperator.Command}"
                    Content="{Binding NextOperator.Content}"
                    Style="{StaticResource RecommandedButtonStyle}"
                    Visibility="{Binding ModelCommonInfo.IsCover, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <!--<Button
                x:Name="BtnCancel"
                Margin="{StaticResource MainWindowButtonMargin}"
                Height="40"  Width="120"
                Content="{Binding CancelOperator.Content}"
                Command="{Binding CancelOperator.Command}"
                Style="{StaticResource NotRecommandedButtonStyle}"
                Visibility="{Binding Path=IsEnabled, ElementName=BtnCancel, Converter={StaticResource BooleanToVisibilityConverter}}"
                />-->
            </StackPanel>
        </Grid>
        <Grid Margin="0,0,0,80">
            <Grid>
                <Frame
                    Name="MainContentFrame"
                    Source="{Binding NavigationOperator.HostFrameSource}"
                    Style="{StaticResource ucMainFrame}" />
            </Grid>
        </Grid>
    </Grid>
</src:BaseWindow>
