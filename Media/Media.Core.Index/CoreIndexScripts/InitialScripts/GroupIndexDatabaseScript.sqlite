CREATE INDEX 
            IF NOT EXISTS IDX_CONTAINER_PATH_MD5
            on tb_container_index(COL_PATH_MD5 asc);

CREATE INDEX
IF NOT EXISTS IDX_ITEM_PATH_MD5
on tb_item_index(COL_PATH_MD5 asc);

CREATE INDEX
IF NOT EXISTS IDX_CONTAINER_NODE_ID
on tb_container_index(COL_NODE_ID asc);


CREATE INDEX
IF NOT EXISTS IDX_ITEM_PARENT_NODE_ID
on tb_item_index(COL_PARENT_NODE_ID asc);


CREATE INDEX
IF NOT EXISTS IDX_ITEM_SORT_ID
on tb_item_index(COL_SORT_ID asc);


CREATE INDEX
IF NOT EXISTS IDX_CONTAINER_PARENT_PATH_MD5
on tb_container_index(COL_PARENT_PATH_MD5 asc);


CREATE INDEX
IF NOT EXISTS IDX_ITEM_PARENT_PATH_MD5
on tb_item_index(COL_PARENT_PATH_MD5 asc);


CREATE INDEX
IF NOT EXISTS IDX_CONTAINER_PATH
on tb_container_index(COL_PATH asc);


CREATE INDEX
IF NOT EXISTS IDX_ITEM_PATH
on tb_item_index(COL_PATH asc);


CREATE INDEX
IF NOT EXISTS IDX_PLANNER_PATH_MD5
on tb_planner_index(COL_PATH_MD5 asc);

CREATE INDEX
IF NOT EXISTS IDX_PLANNER_PARENT_NODE_ID
on tb_planner_index(COL_PARENT_NODE_ID asc);

CREATE INDEX
IF NOT EXISTS IDX_PLANNER_PARENT_PATH_MD5
on tb_planner_index(COL_PARENT_PATH_MD5 asc);

CREATE INDEX
IF NOT EXISTS IDX_PLANNER_PATH
on tb_planner_index(COL_PATH asc);