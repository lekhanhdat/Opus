			<parameters>
				<TreeHandler>${AvePoint.Media.Service.ArchiverBackup.ArchiverRestoreTreeHandler}</TreeHandler>
			</parameters>
		</component>
		<component id="AvePoint.Media.Service.Remoting.ArchiverMergeIndexService" service="AvePoint.Media.Service.IMergeIndexService, MediaServiceApplicationModel" type="AvePoint.Media.Service.ArchiverBackup.MergeIndexService, MediaServiceArchiverBackup" lifestyle="transient">
			<parameters>
