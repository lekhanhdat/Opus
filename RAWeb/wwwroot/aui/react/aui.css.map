@font-face {
  font-family: 'font-aui';
  src: url('data:font/woff2;base64,') format('woff2');
  font-weight: normal;
  font-style: normal;
  font-display: block;
}

[class^="faui-"], [class*=" faui-"] {
  /* use !important to prevent issues with browser extensions that change fonts */
  font-family: 'font-aui' !important;
  speak: never;
  font-style: normal;
  font-weight: normal;
  font-variant: normal;
  text-transform: none;
  line-height: 1;

  /* Better Font Rendering =========== */
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

