html {
  --font-family: 'Open Sans';
  --font-families: var(--font-family), 'Segoe UI', 'Helvetica Neue', 'Helvetica', 'Arial', 'sans-serif';
  font-family: var(--font-families);
  --font-light: 300;
  --font-regular: 400;
  --font-semibold: 600;
  --font-bold: 700;
  --font-extrabold: 800;
  --font-reset: normal normal normal 1rem / var(--line-spacing) var(--font-families, 'Open Sans');
  direction: ltr;
  --inline-end-side: 90deg;
}
html:lang(ja) {
  --font-families: 'Meiryo UI', 'メイリオ', 'Segoe UI', 'Helvetica Neue', 'Helvetica', 'Arial', 'sans-serif';
}
html:lang(ko) {
  --font-families: 'Malgun Gothic', '맑은 고딕', 'Segoe UI', 'Helvetica Neue', 'Helvetica', 'Arial', 'sans-serif';
}
html:lang(zh) {
  --font-families: var(--font-family), 'Microsoft YaHei', '微软雅黑', 'Segoe UI', 'Helvetica Neue', 'Helvetica', 'Arial', 'sans-serif';
}
@supports (font: -apple-system-body) {
  html:lang(ja, ko, zh) {
    --font-families: var(--font-family), -apple-system, 'Segoe UI', 'Helvetica Neue', 'Helvetica', 'Arial', 'sans-serif';
  }
}
html:dir(rtl) {
  direction: rtl;
  --inline-end-side: 270deg;
}
html {
  --line-spacing: 1.5;
  font-size: calc(var(--font-size-base) * 1px);
  --font-size-base: 14;
  --font-size-min: 12;
  --font-xs: calc(var(--font-size-min) / var(--font-size-base) * 1rem);
  --font-s: calc(calc(var(--font-size-base) + var(--font-size-min)) / var(--font-size-base) / 2 * 1rem);
  --font-m: 1rem;
  --font-l: calc(calc(var(--font-size-base) + 2) / var(--font-size-base) * 1rem);
  --font-xl: calc(calc(var(--font-size-base) + 6) / var(--font-size-base) * 1rem);
  --font-xxl: calc(calc(var(--font-size-base) + 10) / var(--font-size-base) * 1rem);
  --font-xxxl: calc(calc(var(--font-size-base) + 14) / var(--font-size-base) * 1rem);
  --font-xxxxl: calc(calc(var(--font-size-base) + 18) / var(--font-size-base) * 1rem);
  text-size-adjust: 100%;
}
:root {
  --dpr: 1;
  --animation-duration: undefined;
  --radius-xs: 1px;
  --radius-s: 2px;
  --radius-m: 4px;
  --radius-l: 8px;
  --radius-xl: 12px;
  --radius-xxl: 24px;
  --radius-round: 100vmax;
  --shadow-size-s: 0 0 2px 0;
  --shadow-size-m: 0 1px 8px 0;
  --shadow-size-l: 0 2px 12px 0;
  --shadow-size-xl: 0 0 40px 0;
  --scrollbar-w: 8px;
  --scrollbar-h: 8px;
  --border-m: min(1px, calc(1px / var(--dpr)));
  --border-l: min(2px, calc(2px / var(--dpr)));
  --border-xl: min(3px, calc(3px / var(--dpr)));
  --border-xxl: min(4px, calc(4px / var(--dpr)));
  --border-xxxl: min(5px, calc(5px / var(--dpr)));
  --gap-xxs: 2px;
  --gap-xs: 4px;
  --gap-s: 8px;
  --gap-m: 16px;
  --gap-l: 24px;
  --gap-xl: 32px;
  --widget-radius-m: var(--radius-s);
  --widget-height-least: 24px;
  --widget-height-xxxs: min(1lh, 24px);
  --widget-height-xxs: 24px;
  --widget-height-xs: 26px;
  --widget-height-s: 28px;
  --widget-height-m: 34px;
  --widget-height-l: 40px;
  --widget-height-xl: 50px;
  --widget-height-xxl: 88px;
  --window-height: 100dvh;
  --window-width: 100dvw;
  --z-panel-min: 101;
  --z-panel-global: 111;
  --z-panel-max: 120;
  --z-dialog-min: 121;
  --z-dialog-max: 140;
  --z-dialog-extend: 150;
  --z-popup: 198;
  --z-popup-extend: 199;
  --z-toast: 200;
  --z-popover: 999;
  --z-global: 9999;
  --z-alert: 99999;
  --z-tooltip: 999999;
}
:root {
  --outline-style: auto;
}
@-moz-document url-prefix() {
  :root {
    --outline-style: solid;
  }
}
@supports (font: -apple-system-body) {
  :root {
    --outline-style: solid;
  }
}
.aui-mobile-view.aui-touchable {
  --widget-height-xxxs: max(1lh, 24px);
  --widget-height-xxs: 30px;
  --widget-height-xs: 40px;
  --widget-height-s: 40px;
  --widget-height-m: 44px;
  --widget-height-l: 44px;
  --widget-height-xl: 50px;
  --widget-height-xxl: 152px;
}
/*
    status: disabled, selected, unselected, active, inactive, hover, normal, checked(alt), others.
    mode: normal(theme), gray, dark.
*/
:root {
  --theme-1: #caf3fb;
  --theme-2: #a8dae4;
  --theme-3: #87c2cd;
  --theme-4: #64aab7;
  --theme-5: #3f93a1;
  --theme-6: #007c8c;
  --theme-7: #006371;
  --theme-8: #004c57;
  --theme-9: #00353f;
  --theme-10: #002028;
}
:root {
  --theme-bg: var(--theme-2);
  --theme-color: var(--theme-6);
}
:root:where([style*='--theme-value:']) {
  --theme-1: oklch(from var(--theme-6) calc(l + 0.4) calc(c - 0.05) h);
  --theme-2: oklch(from var(--theme-6) calc(l + 0.32) calc(c - 0.04) h);
  --theme-3: oklch(from var(--theme-6) calc(l + 0.24) calc(c - 0.03) h);
  --theme-4: oklch(from var(--theme-6) calc(l + 0.16) calc(c - 0.02) h);
  --theme-5: oklch(from var(--theme-6) calc(l + 0.08) calc(c - 0.01) h);
  --theme-6: var(--theme-value);
  --theme-7: oklch(from var(--theme-6) calc(l - 0.08) calc(c - 0.01) h);
  --theme-8: oklch(from var(--theme-6) calc(l - 0.16) calc(c - 0.02) h);
  --theme-9: oklch(from var(--theme-6) calc(l - 0.24) calc(c - 0.03) h);
  --theme-10: oklch(from var(--theme-6) calc(l - 0.32) calc(c - 0.04) h);
}
