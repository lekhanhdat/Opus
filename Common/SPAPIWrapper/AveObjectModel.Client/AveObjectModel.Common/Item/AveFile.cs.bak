        public Guid UniqueId
        {
            get {
                if (mUniqueIdLoaded == false)
                {
                    Guid id = new Guid(base.DataCache.GetProperty<string>("UniqueId"));
                    base.DataCache.PropertiesCache.Remove("UniqueId");
                    base.DataCache.PropertiesCache.Add("UniqueId", id);
                    mUniqueIdLoaded = true;
                }
                return base.DataCache.GetProperty<Guid>("UniqueId");
            }
        }

        public IAveFileVersionCollection Versions
        {
            get {
                //using the version service
                if ( mVersionsLoaded == false )
                {
                    string fileSiteRelativeUrl = mServerRelativeUrl.Substring( mParentWeb.ServerRelativeUrl.Length);
                    List<Dictionary<string, object>> versions = mRequest.FileGetVersions(mParentWeb.Url, fileSiteRelativeUrl);
                    AveFileVersionCollection versionCollection = new AveFileVersionCollection();
                    foreach ( Dictionary<string, object> dic in versions )
                    {
                        AveFileVersion fileVersion = new AveFileVersion(mRequest, this.mParentWeb.Site.Url, dic);
                        versionCollection.Add(fileVersion);
                    }
                    versions.Clear();
                    base.DataCache.PropertiesCache.Add("Versions", versionCollection);
                    mVersionsLoaded = true;
                }
                return base.DataCache.GetProperty<IAveFileVersionCollection>("Versions"); 
            }
        }

