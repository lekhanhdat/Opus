CREATE TABLE [ArchiverIndexSubInfoes](
	[Id] nvarchar(128) NOT NULL primary key,
	[JobId] nvarchar(4000) NULL,
	[StorageId] nvarchar(4000) NULL,
	[CurrentStorageId] nvarchar(4000) NULL,
	[DataEncryptionDynamicKey] blob NULL,
	[DataEncryptionType] int NULL,
	[SubJobId] nvarchar(40)
);

CREATE TABLE [ArchiverSiteMasterIndexes](
	[Id] nvarchar(128) NOT NULL primary key,
	[ArchiverTime] bigint NOT NULL,
	[JobId] nvarchar(4000) NULL,
	[SiteId] nvarchar(4000) NULL,
	[SiteURL] nvarchar(4000) NULL,
	[SourceFlag] int NOT NULL,
	[GroupMailboxAddress] nvarchar(400),
	[O365TenantId] nvarchar(64)
);

CREATE TABLE [RMStorageDeviceInfoes](
	[Id] nvarchar(128) NOT NULL primary key,
	[Name] nvarchar(255) NULL,
	[Type] int NOT NULL,
	[ModifiedTime] bigint NOT NULL,
	[ConnectionString] nvarchar(32672) NULL,
	[IsSystemStorage] boolean NOT NULL
);

CREATE TABLE [SettingProfiles](
	[Name] nvarcha(255) NULL primary key,
	[Settings] nvarchar(32672) NULL
);

CREATE TABLE [CommonSiteMasterIndex] (
  Id nvarchar(64) PRIMARY KEY,
  ArchiverTime bigint NOT NULL,
  JobId nvarchar(255),
  SiteURL nvarchar(400),
  StorageId nvarchar(64),
  IndexStorageId nvarchar(64),
  SiteGroupId nvarchar(64),
  TeamId nvarchar(64),
  SiteId nvarchar(64),
  SPVersion int NOT NULL,
  MergeIndexState int NOT NULL,
  JobState int NOT NULL,
  StorageInfo nvarchar(255),
  Extension nvarchar(32672),
  Flag int NOT NULL,
  DAOMigrated boolean,
  BackupFileType int NOT NULL,
  DuplicateStatus int NOT NULL,
  DataType int NOT NULL,
  O365TenantId nvarchar(64)
);