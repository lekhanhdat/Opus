<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="BCStyleLink.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--ProgressBarColor-->


    <LinearGradientBrush x:Key="ProgressBarIndicatorAnimatedFill" EndPoint="1,0" StartPoint="0,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#66FFFFFF" Offset="0.4" />
        <GradientStop Color="#66FFFFFF" Offset="0.6" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>


    <!--Progress-->
    <Style x:Key="{x:Type ProgressBar}" TargetType="{x:Type ProgressBar}">
        <Setter Property="Background" Value="#FFE0E0E0" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <ControlTemplate.Resources>
                        <Storyboard x:Key="ProgressBarLightAnimationPlay" RepeatBehavior="Forever">
                            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00" Storyboard.TargetName="LightAnimation"
                                                           Storyboard.TargetProperty="(UIElement.OpacityMask).(Brush.RelativeTransform).(TransformGroup.Children)[3].(TranslateTransform.X)">
                                <SplineDoubleKeyFrame KeyTime="00:00:00" Value="-1" />
                                <SplineDoubleKeyFrame KeyTime="00:00:03" Value="2" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </ControlTemplate.Resources>
                    <Grid x:Name="TemplateRoot" SnapsToDevicePixels="true">
                        <Rectangle x:Name="rectangle" Fill="{TemplateBinding Background}" />
                        <Rectangle x:Name="PART_Track" />
                        <Decorator x:Name="PART_Indicator" HorizontalAlignment="Left">
                            <Grid x:Name="Foreground">
                                <Rectangle x:Name="Indicator" />
                                <Border x:Name="Animation" ClipToBounds="True" CornerRadius="3"
                                        BorderThickness="0,0,1,0" BorderBrush="#FF00BB33">
                                    <Rectangle x:Name="PART_GlowRect"
                                               Fill="{DynamicResource ProgressBarIndicatorAnimatedFill}"
                                               HorizontalAlignment="Left" Margin="-80,0,0,0" Width="80" RadiusX="0"
                                               VerticalAlignment="Stretch" Height="Auto" />
                                </Border>
                                <Grid x:Name="Overlay">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition MaxWidth="20" />
                                        <ColumnDefinition Width="0.1*" />
                                        <ColumnDefinition MaxWidth="20" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>


                                    <Rectangle x:Name="LightAnimation" Grid.ColumnSpan="3" Grid.RowSpan="3"
                                               Fill="#FF8DFF8D">
                                        <Rectangle.OpacityMask>
                                            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0"
                                                                 MappingMode="RelativeToBoundingBox">
                                                <LinearGradientBrush.RelativeTransform>
                                                    <TransformGroup>
                                                        <ScaleTransform CenterX="0.5" CenterY="0.5" />
                                                        <SkewTransform CenterX="0.5" CenterY="0.5" />
                                                        <RotateTransform Angle="90" CenterX="0.5" CenterY="0.5" />
                                                        <TranslateTransform X="-1" />
                                                    </TransformGroup>
                                                </LinearGradientBrush.RelativeTransform>
                                                <GradientStop Color="#00000000" Offset="0.85" />
                                                <GradientStop Color="Black" Offset="0.50" />
                                                <GradientStop Color="Black" Offset="0.57" />
                                                <GradientStop Color="#00000000" Offset="0.25" />
                                            </LinearGradientBrush>
                                        </Rectangle.OpacityMask>
                                    </Rectangle>


                                    <Rectangle x:Name="LeftDark" Fill="#FF35A13D" Grid.RowSpan="2" />
                                    <Rectangle x:Name="RightDark" Grid.Column="2" Fill="#FF35A13D" Grid.RowSpan="2" />
                                    <Rectangle x:Name="LeftLight" Grid.Column="0" Fill="#FF35A13D" Grid.Row="2" />
                                    <Rectangle x:Name="CenterLight" Grid.Column="1" Fill="#FF35A13D" Grid.Row="2" />
                                    <Rectangle x:Name="RightLight" Grid.Column="2" Fill="#FF35A13D" Grid.Row="2" />
                                    <Border x:Name="Highlight1" Background="#FF35A13D" Grid.ColumnSpan="3"
                                            Grid.RowSpan="2" BorderThickness="0" />
                                    <Border x:Name="Highlight2" Background="#FF35A13D" Grid.ColumnSpan="3"
                                            Grid.RowSpan="2" BorderThickness="0" />
                                </Grid>
                            </Grid>
                        </Decorator>

                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Vertical">
                            <Setter Property="LayoutTransform" TargetName="TemplateRoot">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsIndeterminate" Value="true">
                            <Setter Property="Visibility" TargetName="LeftDark" Value="Collapsed" />
                            <Setter Property="Visibility" TargetName="RightDark" Value="Collapsed" />
                            <Setter Property="Visibility" TargetName="LeftLight" Value="Collapsed" />
                            <Setter Property="Visibility" TargetName="CenterLight" Value="Collapsed" />
                            <Setter Property="Visibility" TargetName="RightLight" Value="Collapsed" />
                            <Setter Property="Visibility" TargetName="Indicator" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsIndeterminate" Value="false">
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="ProgressBarLightAnimationPlay_BeginStoryboard" />
                            </Trigger.ExitActions>
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="ProgressBarLightAnimationPlay_BeginStoryboard"
                                                 Storyboard="{StaticResource ProgressBarLightAnimationPlay}" />
                            </Trigger.EnterActions>
                            <Setter Property="Background" TargetName="Animation" Value="#00B5FFA9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>