@using AvePoint.RA.I18N.Core;
@using AvePoint.RA.Web.Extentions.Util
@using Microsoft.AspNetCore.Html
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en-US">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@Html.I18N("RM_JS_Common_RecourdAutomation")</title>
</head>
<body>
    <form id="sso_logout_form" method="post" action="@ViewBag.ssoLogoutUrl">
        <input type="hidden" name="client_id" value="@ViewBag.clientId" />
        <input type="hidden" name="redirect_uri" value="@ViewBag.redirectUrl" />
        <input type="hidden" name="user_id" value="@ViewBag.userId" />
    </form>
    <script nonce="@ViewBag.Nonce" type="text/javascript" src="~/Scripts/Logon/sso.js"></script>
</body>
</html>