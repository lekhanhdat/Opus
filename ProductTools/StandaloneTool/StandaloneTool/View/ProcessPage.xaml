<Page
    x:Class="StandaloneTool.View.ProcessPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resource="clr-namespace:DataExportCore.Resources;assembly=DataExportCore"
    xmlns:viewModel="clr-namespace:StandaloneTool.View.Model"
    Title="ProcessPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    DataContext="{x:Static viewModel:ProcessViewModel.Instance}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="150" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Name="WizardTextBlock" Background="#FF1188EE">
            <TextBlock
                Margin="0,0,0,20"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                FontFamily="Segoe UI"
                FontSize="16"
                FontWeight="Bold"
                Foreground="White"
                Style="{StaticResource PageDescriptionTextBlock}"
                Text="{Binding ProcessConfigPageTitle}" />
        </Grid>
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="15" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="60" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid HorizontalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="1"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="#FF1188EE"
                    Text="{Binding ProgressText}" />
                <TextBlock
                    Grid.Column="2"
                    FontSize="20"
                    FontWeight="Bold"
                    Foreground="#FF1188EE"
                    Text="{x:Static resource:CommonResourceManager.SATool_CompletedPercentage}" />
                <Rectangle
                    Width="1"
                    Height="15"
                    Margin="20,0,0,0"
                    Fill="#FFA3BBD3" />
            </Grid>
            <ProgressBar
                Name="progressBar"
                Grid.Row="2"
                Width="420"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Value="{Binding Process}" />
            <Grid
                Grid.Row="4"
                Grid.ColumnSpan="5"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="13"
                    FontStyle="Italic"
                    Foreground="#FF444444"
                    Text="{x:Static resource:CommonResourceManager.SATool_ExportingDataText}"
                    Visibility="{Binding Path=IsExchangeExportModule, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=true}" />
                <Grid
                    x:Name="MainPage"
                    Grid.Row="1"
                    Grid.ColumnSpan="5"
                    MaxWidth="700"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <TextBlock
                        Width="{Binding TextBlockWidth}"
                        MaxWidth="700"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontStyle="Italic"
                        Foreground="#FF444444"
                        Text="{Binding CurrentProcessingDetail}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
