-- Creating table 'tb_agent_index'
CREATE TABLE [tb_agent_index](
    [COL_SITE_URL_MD5] VARCHAR(50) NOT NULL,
    [COL_SITE_URL] VARCHAR(32672),
    [COL_BACKUP_TYPE] VARCHAR(32),
    [COL_LAST_BACKUP_INDEX] TEXT,
    [COL_TIME_STAMP] VARCHAR(32),
    [COL_EXTENSION_1] BIGINT,
    [COL_EXTENSION_2] BIGINT,
    [COL_EXTENSION_3] VARCHAR(32672),
    [COL_EXTENSION_4] TEXT
);

-- Creating table 'tb_site_master_index'
CREATE TABLE [tb_site_master_index](
    [COL_ID] VARCHAR(255) NOT NULL PRIMARY KEY,
    [COL_FARM_NAME] VARCHAR(255),
    [COL_PLAN_ID] VARCHAR(255),
    [COL_CYCLE_ID] VARCHAR(255),
    [COL_JOB_ID] VARCHAR(255),
    [COL_LOGICAL_DRIVE] VARCHAR(255),
    [COL_PHYSICAL_DRIVE] VARCHAR(255),
    [COL_BACKUP_PLAN_TYPE] INTEGER,
    [COL_WEBAPP_NAME] VARCHAR(255),
    [COL_SITE_URL] VARCHAR(255),
    [COL_BACKUP_TIME] BIGINT,
    [COL_REMARK1] VARCHAR(255),
    [COL_REMARK2] VARCHAR(255),
    [COL_REMARK3] VARCHAR(32672),
    [COL_REMARK4] VARCHAR(32672),
    [COL_REMARK5] INTEGER,
    [COL_REMARK6] INTEGER,
    [COL_REMARK7] BIGINT,
    [COL_REMARK8] CLOB(2147483647),
    [COL_SP_VERSION] INTEGER default 0,
    [COL_MAX_DATA_BLOCK_SIZE] INTEGER default 0
);

-- Creating table 'tb_job_info'
CREATE TABLE [tb_job_info](
    [COL_GUID] VARCHAR(36) NOT NULL PRIMARY KEY,
    [COL_JOB_ID] VARCHAR(32672),
    [COL_KEY] VARCHAR(32672),
    [COL_VALUE] VARCHAR(32672),
    [COL_EXTENSION_1] INT,
    [COL_EXTENSION_2] INT,
    [COL_EXTENSION_3] INT,
    [COL_EXTENSION_4] BIGINT,
    [COL_EXTENSION_5] BIGINT,
    [COL_EXTENSION_6] VARCHAR(32672),
    [COL_EXTENSION_7] VARCHAR(32672),
    [COL_EXTENSION_8] VARCHAR(32672),
    [COL_EXTENSION_9] TEXT,
    [COL_EXTENSION_10] TEXT
);

-- Creating table 'tb_job_properties'
CREATE TABLE [tb_job_properties](
    [COL_ID] CHAR(36) not null primary key,
    [COL_SUCCESS] VARCHAR(50),
    [COL_SECURITY_KEY] TEXT,
    [COL_DATA_MODE] INT,
    [COL_VERSION] VARCHAR(20),
    [COL_JOB_TYPE] INT,
    [COL_JOB_ID] VARCHAR(32672),
    [COL_PLAN_TYPE] INT,
    [COL_PLAN_NAME] TEXT,
    [COL_CATALOG] TEXT,
    [COL_SSP_CATALOG] TEXT,
    [COL_SEARCH_XML] TEXT,
    [COL_SHARED_SEARCH_SETTING] BLOB,
    [COL_BACKUP_LIST] BLOB,
    [COL_FEW_NAME] TEXT,
    [COL_FEW_LIST] TEXT,
    [COL_CREATE_TIME] BIGINT,
    [COL_CATALOG_GROUP] INT,
    [COL_SEARCH_XML_GROUP] INT,
    [COL_MAX_FILE_SIZE] BIGINT,
    [COL_NEW_INDEX] INT,
    [COL_Extension_1] INT,
    [COL_Extension_2] INT,
    [COL_Extension_3] INT,
    [COL_Extension_4] BIGINT,
    [COL_Extension_5] BIGINT,
    [COL_Extension_6] VARCHAR(32672),
    [COL_Extension_7] VARCHAR(32672),
    [COL_Extension_8] VARCHAR(32672),
    [COL_Extension_9] TEXT,
    [COL_Extension_10] NUMBER
);

