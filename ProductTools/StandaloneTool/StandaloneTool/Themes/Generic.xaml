<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:resource="clr-namespace:DataExportCore.Resources;assembly=DataExportCore"
                    xmlns:control="clr-namespace:StandaloneTool.Model.CustomControl">
    <Style TargetType="{x:Type control:PaggingControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type control:PaggingControl}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        DataContext="{Binding RelativeSource={RelativeSource  AncestorType={x:Type control:PaggingControl}}}"
                    >
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentPage}" VerticalAlignment="Center" Margin="10 0 0 0" />
                            <TextBlock Text="/" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TotalPages}" VerticalAlignment="Center" />
                            <Button Content="{x:Static resource:CommonResourceManager.SATool_FirstPage}" Command="{Binding FirstPageCommand}" Margin="10 0" />
                            <Button Content="{x:Static resource:CommonResourceManager.SATool_PrevPage}" Command="{Binding PreviousPageCommand}" Margin="0 0" />
                            <Button Content="{x:Static resource:CommonResourceManager.SATool_NextPage}" Command="{Binding  NextPageCommand}" Margin="10 0 0 0" />
                            <Button Content="{x:Static resource:CommonResourceManager.SATool_LastPage}" Command="{Binding  LastPageCommand}" Margin="10 0" />
                            <TextBox Text="{Binding CurrentPage}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Width="30" MinWidth="30"/>
                            <Button Content="{x:Static resource:CommonResourceManager.SATool_GoToPage}"  Margin="10 0 0 0" Command="{Binding  TurnToPageCmd}" />
                            <TextBlock Text="{x:Static resource:CommonResourceManager.SATool_ShowRows}" VerticalAlignment="Center" Margin="10 0 10 0" />
                            <ComboBox ItemsSource="{Binding PageSizeList}" SelectedValue="{Binding PageSize}" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>