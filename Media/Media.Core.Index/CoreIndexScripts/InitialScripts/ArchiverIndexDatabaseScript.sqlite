CREATE TABLE [tb_head_index] ( 
          [COL_ID] CHAR(36) not null primary key, 
          [COL_FLAG] BIGINT, 
		  [COL_TYPE] CHAR(2),
          [COL_NAME] VARCHAR(32672), 
          [COL_PATH_MD5] CHAR(32), 
          [COL_PARENT_PATH_MD5] CHAR(32), 
          [COL_DATA_FILE_NUMBER] BIGINT, 
          [COL_DATA_FILE_OFFSET] BIGINT,
          [COL_DATA_FILE_LENGTH] BIGINT,
          [COL_CRC] BIGINT, 
          [COL_FILE_HEADER_TYPE] INT,
          [COL_ARCHIVE_TIME] BIGINT,
          [COL_CREATE_TIME] BIGINT,
          [COL_MODIFY_TIME] BIGINT,
          [COL_RECYCLE_TIME] BIGINT,
          [COL_AUTHOR] CHAR(20),
          [COL_PERMISSION] TEXT,
          [COL_RETENTION] VARCHAR(32672),
          [COL_SUB_RETENTION] VARCHAR(32672),
          [COL_ATTRIBUTES] VARCHAR(32672),
          [COL_EXTRAINFO] VARCHAR(32672),
          [COL_ITEMID] VARCHAR(32672),
          [COL_ISSYSTEMFILE] VARCHAR(20),
          [COL_STUBINFO] VARCHAR(32672),
          [COL_STORAGE] INT,
          [COL_PLANID] VARCHAR(32672),
          [COL_CYCLEID] VARCHAR(32672),
          [COL_JOBID] VARCHAR(32672),
          [COL_SEQUENCE] BIGINT,
          [COL_STORAGEPOLICYID] CHAR(36),
          [COL_EXTENSION_1] INT,
          [COL_EXTENSION_2] INT,
          [COL_EXTENSION_3] INT,
          [COL_EXTENSION_4] BIGINT,
          [COL_EXTENSION_5] BIGINT,
          [COL_EXTENSION_6] VARCHAR(32672),
          [COL_EXTENSION_7] VARCHAR(32672),
          [COL_EXTENSION_8] VARCHAR(32672),
          [COL_EXTENSION_9] TEXT,
          [COL_EXTENSION_10] TEXT,
          [COL_CONTENT_DATA_OFFSET] BIGINT,
          [COL_CONTENT_DATA_FILE_NUMBER] BIGINT,
          [COL_CONTENT_DATA_FILE_PREFIX_NUMBER] BIGINT,
          [COL_STORAGEINFO] TEXT,
          [COL_HAD_OFFSET] BOOLEAN,
          [COL_VERSION] BIGINT,
          [COL_META_DATA_HEADER_OFFSET] BIGINT,
          [COL_CONTENT_DATA_HEADER_OFFSET] BIGINT,
          [COL_CONTENT_PAGE_SIZE] BIGINT,
          [COL_STATUS] BIGINT default 0,
          [COL_PRUNE_TIME] BIGINT,
          [COL_POOL_GUID] TEXT,
          [COL_BLOB_INFO] TEXT,
          [COL_UI_VERSION] INTEGER,
		  [COL_SITE_PATH] VARCHAR(255),
		  [COL_DEL_STATUS] INT,
		  [COL_USESNAPLOCK] INT, 
		  [COL_RETENTION_STATUS] INT,
		  [COL_META_TAIL_LENGTH] BIGINT,
		  [COL_PLATFORM_TYPE] INT default 1,
		  [COL_ARCHIVE_BY] VARCHAR(32672),
		  [COL_IS_APP_DATA] VARCHAR(20),
		  [COL_APP_DATA_NAME] VARCHAR(255)
);

CREATE TABLE [tb_body_index] ( 
    [COL_ID] CHAR(36) not null primary key,
    [COL_FLAG] BIGINT,
	[COL_TYPE] CHAR(2),
    [COL_NAME] VARCHAR(32672), COL_PATH_MD5 CHAR(32),
    [COL_PARENT_PATH_MD5] CHAR(32),
    [COL_DATA_FILE_NUMBER] BIGINT,
    [COL_DATA_FILE_OFFSET] BIGINT,
    [COL_DATA_FILE_LENGTH] BIGINT,
    [COL_CRC] BIGINT,
    [COL_FILE_HEADER_TYPE] INT,
    [COL_ARCHIVE_TIME] BIGINT,
    [COL_CREATE_TIME] BIGINT,
    [COL_MODIFY_TIME] BIGINT,
    [COL_RECYCLE_TIME] BIGINT,
    [COL_AUTHOR] CHAR(20),
    [COL_PERMISSION] TEXT,
    [COL_RETENTION] VARCHAR(32672),
    [COL_SUB_RETENTION] VARCHAR(32672),
    [COL_ATTRIBUTES] VARCHAR(32672),
    [COL_EXTRAINFO] VARCHAR(32672),
    [COL_ITEMID] VARCHAR(32672),
    [COL_ISSYSTEMFILE] VARCHAR(20),
    [COL_STUBINFO] VARCHAR(32672),
    [COL_STORAGE] INT,
    [COL_PLANID] VARCHAR(32672),
    [COL_CYCLEID] VARCHAR(32672),
    [COL_JOBID] VARCHAR(32672),
    [COL_SEQUENCE] BIGINT,
    [COL_STORAGEPOLICYID] CHAR(36),
    [COL_EXTENSION_1] INT,
    [COL_EXTENSION_2] INT,
    [COL_EXTENSION_3] INT,
    [COL_EXTENSION_4] BIGINT,
    [COL_EXTENSION_5] BIGINT,
    [COL_EXTENSION_6] VARCHAR(32672),
    [COL_EXTENSION_7] VARCHAR(32672),
    [COL_EXTENSION_8] VARCHAR(32672),
    [COL_EXTENSION_9] TEXT,
    [COL_EXTENSION_10] TEXT,
    [COL_CONTENT_DATA_OFFSET] BIGINT,
    [COL_CONTENT_DATA_FILE_NUMBER] BIGINT,
    [COL_CONTENT_DATA_FILE_PREFIX_NUMBER] BIGINT,
    [COL_STORAGEINFO] TEXT,
    [COL_HAD_OFFSET] BOOLEAN,
    [COL_VERSION] BIGINT,
    [COL_META_DATA_HEADER_OFFSET] BIGINT,
    [COL_CONTENT_DATA_HEADER_OFFSET] BIGINT,
    [COL_CONTENT_PAGE_SIZE] BIGINT,
    [COL_STATUS] BIGINT default 0,
    [COL_PRUNE_TIME] BIGINT,
    [COL_POOL_GUID] TEXT,
    [COL_BLOB_INFO] TEXT,
    [COL_UI_VERSION] INTEGER,
	[COL_SITE_PATH] VARCHAR(255),
	[COL_DEL_STATUS] INT,
	[COL_USESNAPLOCK] INT, 
	[COL_RETENTION_STATUS] INT,
	[COL_META_TAIL_LENGTH] BIGINT,
	[COL_PLATFORM_TYPE] INT default 1,
	[COL_ARCHIVE_BY] VARCHAR(32672),
	[COL_IS_APP_DATA] VARCHAR(20),
	[COL_APP_DATA_NAME] VARCHAR(255)
);

CREATE TABLE [tb_site_master_index] ( 
    [COL_ID] VARCHAR(255) NOT NULL,
    [COL_BACKUP_TIME] BIGINT,
    [COL_CYCLE_ID] VARCHAR(255),
    [COL_FARM_NAME] VARCHAR(255),
    [COL_PLAN_TYPE] INTEGER,
    [COL_JOB_ID] VARCHAR(255),
    [COL_LOGICAL_DRIVE] VARCHAR(255),
    [COL_WEBAPP_NAME] VARCHAR(255),
    [COL_SITE_URL] VARCHAR(255),
    [COL_PLAN_ID] VARCHAR(255),
    [COL_SITE_INFO] VARCHAR(255),
    [COL_MARK1] VARCHAR(255),
    [COL_MARK2] VARCHAR(255),
    [COL_MARK3] VARCHAR(255),
    [COL_MARK4] INT,
    [COL_MARK5] BIGINT,
    [COL_SP_VERSION] INTEGER,
    [COL_MAX_DATA_BLOCK_SIZE] INTEGER, PRIMARY KEY (col_id)
    );

CREATE TABLE [tb_job_info](
    [COL_GUID] VARCHAR(36) not null primary key,
    [COL_JOB_ID] VARCHAR(32672),
    [COL_KEY] VARCHAR(32672),
    [COL_VALUE] VARCHAR(32672),
    [COL_EXTENSION_3] INT,
    [COL_EXTENSION_4] BIGINT,
    [COL_EXTENSION_5] BIGINT,
    [COL_EXTENSION_6] VARCHAR(32672),
    [COL_EXTENSION_7] VARCHAR(32672),
    [COL_EXTENSION_8] VARCHAR(32672),
    [COL_EXTENSION_9] TEXT,
    [COL_EXTENSION_10] TEXT
);

CREATE TABLE [tb_common_site_master_index] ( 
    [COL_ID] VARCHAR(255) NOT NULL,
    [COL_BACKUP_TIME] BIGINT,
    [COL_CYCLE_ID] VARCHAR(255),
    [COL_FARM_NAME] VARCHAR(255),
    [COL_PLAN_TYPE] INTEGER,
    [COL_JOB_ID] VARCHAR(255),
    [COL_LOGICAL_DRIVE] VARCHAR(255),
    [COL_WEBAPP_NAME] VARCHAR(255),
    [COL_SITE_URL] VARCHAR(255),
    [COL_PLAN_ID] VARCHAR(255),
    [COL_SITE_INFO] VARCHAR(255),
    [COL_MARK1] VARCHAR(255),
    [COL_MARK2] VARCHAR(255),
    [COL_MARK3] VARCHAR(255),
    [COL_MARK4] INT,
    [COL_MARK5] BIGINT,
    [COL_SP_VERSION] INTEGER,
    [COL_TEAMS_ID] VARCHAR(255),
    [COL_DATATYPE] INT,
    [COL_MAX_DATA_BLOCK_SIZE] INTEGER, PRIMARY KEY (col_id)
    );

