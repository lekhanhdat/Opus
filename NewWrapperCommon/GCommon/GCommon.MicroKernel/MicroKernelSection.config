<!--
    This file is as a sample config file of MicroKernel external server
-->
<configuration>
  <configSections>
    <section name="microKernel" type="AvePoint.GCommon.MicroKernel.MicroKernelSectionHandler, CommonMicroKernel"/>
  </configSections>
  <microKernel>
    <MicroKernelServers>
      <MicroKernelServer id="Id" name="typeName" type="" path="assemblyPath" assemblyQualifiedType="" isSameAssembly="true" />
    </MicroKernelServers>
    <MicroKernelIocContainers>
      <MicroKernelIocContainer id="castle windsow ioc container" type="AvePoint.GCommon.MicroKernel.DefaultIocContainer, CommonMicroKernel" />
    </MicroKernelIocContainers>
  </microKernel>
</configuration>