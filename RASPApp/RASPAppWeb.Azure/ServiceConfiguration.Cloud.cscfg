<ServiceConfiguration serviceName="RASPAppWeb.Azure" xmlns="http://schemas.microsoft.com/ServiceHosting/2008/10/ServiceConfiguration" osFamily="5" osVersion="*" schemaVersion="2015-04.2.6">
  <Role name="RASPAppWeb">
    <Instances count="1" />
    <ConfigurationSettings>
      <Setting name="Microsoft.WindowsAzure.Plugins.Diagnostics.ConnectionString" value="UseDevelopmentStorage=true" />
      <Setting name="AppUrl" value="https://www.cloudrecords.com"/>
      <Setting name="ClientId" value=""/>
      <Setting name="ClientSecret" value=""/>
      <Setting name="LogStorage" value=""/>
      <Setting name="LogContainerName" value="joblogs"/>
      <Setting name="PortalApiUrl" value=""/>
      <Setting name="CertificateThumbprint" value="" />
    </ConfigurationSettings>
    <Certificates>
      <Certificate name="Web" thumbprint="958B6B5093959E9B3886BC19D5B10A19C417973D" thumbprintAlgorithm="sha1" />
      <Certificate name="CloudRecords Application" thumbprint="958B6B5093959E9B3886BC19D5B10A19C417973D" thumbprintAlgorithm="sha1" />
    </Certificates>
  </Role>
</ServiceConfiguration>