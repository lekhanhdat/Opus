<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AvePoint.Deployment.CommonGUI"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/AvePoint.CallAssist.CommonDeploymentGUI ;component/BaseControl/ButtonStyle.xaml" />
        <ResourceDictionary Source="/AvePoint.CallAssist.CommonDeploymentGUI ;component/UI/BaseWindowUI/WinButtonStyle.xaml" />
        <ResourceDictionary Source="/AvePoint.CallAssist.CommonDeploymentGUI ;component/BaseControl/TextBlockStyle.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <local:MessageWindowIconTypeIconImageConverter x:Key="MessageWindowIconTypeIconImageConverter" />
    </ResourceDictionary>
  </ResourceDictionary.MergedDictionaries>
  <!--Main Style-->
  <ControlTemplate x:Key="BaseMessageWindowControlTemplate" TargetType="{x:Type local:BaseMessage}">
    <Border Margin="0" Padding="15" VerticalAlignment="Center" HorizontalAlignment="Center" 
            MinHeight="230" Width="530">

      <!--Main Border with Background-->
        <Grid Margin="0" Height="Auto">
                <Border Background="#FFFFFFFF"  BorderBrush="#1883D7"  BorderThickness="1" Margin="0">
                    <Border.Effect>
                        <DropShadowEffect ShadowDepth="0" BlurRadius="15" Color="#002266" Opacity="0.5"/>
                    </Border.Effect>
                </Border>

 
       
        <!--form button-->
        <Grid>
          <DockPanel VerticalAlignment="Top" LastChildFill="false" Margin="0" Height="Auto" x:Name="borderTitle"
                     Background="Transparent">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,8,13,8">
              <Button IsTabStop="False" FocusVisualStyle="{x:Null}" Content="Close" x:Name="btnClose"
                      HorizontalAlignment="Left" Height="21" Width="21" Margin="1" VerticalAlignment="Top"
                      Template="{StaticResource win_btn_close_grey}" />
            </StackPanel>
          </DockPanel>
          <AdornerDecorator VerticalAlignment="Stretch">

            <Grid Height="Auto" Margin="20,30,20,0" VerticalAlignment="Stretch">
              <Grid.RowDefinitions>
                <!--Content-->
                <RowDefinition Height="*" />
                <!--Button-->
                <RowDefinition Height="80" />
              </Grid.RowDefinitions>
                        
              <!--Content-->
              <Grid Margin="10,10,0,0" HorizontalAlignment="Left" Grid.Row="0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                  <!--Image-->
                  <ColumnDefinition Width="Auto" />
                  <!--Content-->
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image VerticalAlignment="Top" Grid.Column="0" Width="32" Height="32" Stretch="Fill" x:Name="mwIcon" />
                <ScrollViewer Grid.Column="1" Style="{DynamicResource RichScrollViewer}"
                              BorderThickness="0" VerticalScrollBarVisibility="Auto" VerticalAlignment="Top">
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid Grid.Column="1">
                      <StackPanel Margin="20,0,0,0">
                         <Grid Margin="0" x:Name="contentGrid">
                          <Grid.RowDefinitions>
                            <!--Title-->
                            <RowDefinition Height="Auto" />
                            <!--Summary-->
                            <RowDefinition Height="Auto" />
                            <!--<RowDefinition Height="Auto"/>-->
                          </Grid.RowDefinitions>
                          <!--Title-->
                          <TextBlock Grid.Row="0" Margin="0"
                                     Style="{StaticResource PageIntroTextBlock}" x:Name="messageTitle" TextWrapping="Wrap"
                                     Text="{TemplateBinding BaseMessageContentTitle}" VerticalAlignment="Top" Visibility="Collapsed" />
                          <!--Summary-->
                          <TextBlock Grid.Row="1" Margin="0"
                                     Style="{StaticResource PageIntroTextBlock}" x:Name="messageSummary" TextWrapping="Wrap"
                                     Text="{TemplateBinding BaseMessageContentSummary}" VerticalAlignment="Top" />
                          <!--
                                                这块取而代之的是一个ContentControl，既能放text也能放别的任何东西
                                            -->
                          <ContentControl Grid.Row="1" Content="{TemplateBinding Content}"
                                          VerticalAlignment="Center" HorizontalAlignment="Center" MinHeight="20"/>
                        </Grid>
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
              <!--Button-->
              <Grid Grid.Row="1" Height="80" VerticalAlignment="Bottom" Margin="0">
                <Border x:Name="footer" Margin="0" Padding="0">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0" Width="Auto">
                    <Button Content="Details" x:Name="detailButton" Width="70" Height="32"
                            IsDefault="True" IsCancel="True" Visibility="Visible" Margin="8,0,8,0" />
                    <Button Content="Test" x:Name="testButton" Width="70" Height="32"
                            IsDefault="True" IsCancel="False" Visibility="Visible" Margin="8,0,8,0" />
                    <Button Content="Retry" x:Name="retryButton" Width="70" Height="32" IsDefault="True" Visibility="Visible"
                            Margin="8,0,8,0" />
                    <Button Content="Yes" x:Name="yesButton" Width="70" Height="32"
                            IsDefault="True" Visibility="Visible" Margin="8,0,8,0"/>
                    <Button Content="No" x:Name="noButton" Width="70" Height="32" IsDefault="True"
                            Visibility="Visible" Margin="8,0,8,0"/>
                    <Button Content="Ignore" x:Name="ignoreButton" Width="70" Height="32" IsCancel="True" Visibility="Visible"
                            Margin="8,0,8,0"/>
                    <Button Content="OK" x:Name="okButton" Width="70" Height="32" IsDefault="True"
                            IsCancel="True" Visibility="Visible" Margin="8,0,8,0"/>
                    <Button Content="Cancel" x:Name="cancelButton" Width="70" Height="32"
                            IsCancel="True" Visibility="Collapsed" Margin="8,0,8,0" />
                  </StackPanel>
                </Border>
              </Grid>
            </Grid>
          </AdornerDecorator>
        </Grid>
      </Grid>
    </Border>
    <!--<ControlTemplate.Triggers>
                        <Trigger Property="ResizeMode" Value="CanResizeWithGrip">
                            <Setter TargetName="WindowResizeGrip" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>-->
  </ControlTemplate>

  <Style TargetType="{x:Type local:BaseMessage}">
    <Setter Property="Template" Value="{StaticResource BaseMessageWindowControlTemplate}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <!--<Setter Property="AllowsTransparency" Value="True" />-->
    <Setter Property="WindowStyle" Value="None" />
    <Setter Property="ResizeMode" Value="NoResize" />
    <Setter Property="MaxHeight" Value="500" />
  </Style>

</ResourceDictionary>