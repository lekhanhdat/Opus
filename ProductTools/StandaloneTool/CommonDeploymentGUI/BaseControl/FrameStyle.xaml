<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="BCStyleLink.xaml" />
  </ResourceDictionary.MergedDictionaries>


  <!--Old-->

  <!--for user control main content frame-->
  <Style x:Key="ucMainFrame" TargetType="{x:Type Frame}">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="NavigationUIVisibility" Value="Hidden" />
  </Style>

  <!--for user control left frame-->
  <Style x:Key="ucLeftFrame" TargetType="{x:Type Frame}">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Height" Value="466" />
    <Setter Property="Width" Value="263" />
    <Setter Property="Margin" Value="3,3,3,0" />
    <Setter Property="NavigationUIVisibility" Value="Hidden" />
  </Style>


  <!--for user control right frame-->
  <Style x:Key="ucRightFrame" TargetType="{x:Type Frame}">
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Height" Value="466" />
    <Setter Property="Width" Value="466" />
    <Setter Property="NavigationUIVisibility" Value="Hidden" />
  </Style>

</ResourceDictionary>