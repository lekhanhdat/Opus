<Project DefaultTargets="MainDeploy" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<PropertyGroup>
		<!--距此build.xml的相对路径层数-->
		<WorkingDirectory>..\</WorkingDirectory>
		<!--编译方式-->
		<BuildType>Release</BuildType>
		<BuildTarget>Rebuild</BuildTarget>
		<Platform>Any CPU</Platform>
		<!--Wsp10部分涉及到的文件相对路径-->
		<ProjectPath>..\</ProjectPath>
		<!--安装包RAWeb存放文件位置-->
		<RAWebPath>..\..\CloudRecords\CloudRecordsWebApp</RAWebPath>
		<!--安装包CloudService存放文件位置-->
		<CloudServicePath>..\..\CloudRecords\CloudRecordsService</CloudServicePath>
		<!--EndUserSolution zip临时存放路径-->
		<EndUserSolutionPath>..\..\CloudRecords\EndUserSolution</EndUserSolutionPath>
		<!--Hotfix文件临时存放路径-->
		<HotfixPath>..\..\CloudRecords\Hotfix</HotfixPath>
		<!--Bin\Rlease下的文件相对路径-->
		<ReleasePath>$(WorkingDirectory)bin\Release</ReleasePath>
		<!--安装包RAScheduleJob存放文件位置-->
		<RAScheduleJobPath>RevIMWorker.ScheduleJob</RAScheduleJobPath>
		<RATimerPath>RevIMWorker.Timer</RATimerPath>
		<!--RMWeb的相对路径-->
		<ProjectBasePath>$(WorkingDirectory)\RAWeb</ProjectBasePath>
		<!--RACloud的相对路径-->
		<CloudServiceBasePath>$(WorkingDirectory)RACloud</CloudServiceBasePath>
		<!--RAScheduleJob的相对路径-->
		<ScheduleJobBasePath>$(WorkingDirectory)\RAScheduleJob</ScheduleJobBasePath>
		<!--workerRole的相对路径-->
		<ScheduleJobWorkerRoleBasePath>$(WorkingDirectory)RAScheduleJobWorkerRole</ScheduleJobWorkerRoleBasePath>
		<ScheduleJobWorkerRoleReleasePath>$(ScheduleJobWorkerRoleBasePath)\bin\Release</ScheduleJobWorkerRoleReleasePath>
		<TimerWorkerRoleBasePath>$(WorkingDirectory)RATimerWorkerRole</TimerWorkerRoleBasePath>
		<TimerWorkerRoleReleasePath>$(TimerWorkerRoleBasePath)\bin\Release</TimerWorkerRoleReleasePath>
		
		<ProjectBaseBinPath>$(WorkingDirectory)\RAWeb\bin</ProjectBaseBinPath>
		<ProjectThirdPath>$(WorkingDirectory)\ThirdDlls</ProjectThirdPath>
		<RACommonPath>$(WorkingDirectory)\RACommon</RACommonPath>
		<DocAveRefPath>$(WorkingDirectory)\DocaveReference</DocAveRefPath>
		<PackagePath>$(ProjectPath)Package</PackagePath>
		<BinRoot>$(WorkingDirectory)bin</BinRoot>
		<DisableILMerge Condition="'$(DisableILMerge)' == ''">false</DisableILMerge>
		<ContinueOnFailure>false</ContinueOnFailure>
	
</PropertyGroup>
	<Target Name="CopyFiles">
		<!--<Copy SourceFiles="$(WorkingDirectory)\RACommon\ServiceVersion\ServiceVersion.config" DestinationFolder="$(HotfixPath)\Config\ServiceVersion" ContinueOnError="false" /> -->
		<!-- Demo: <Copy SourceFiles="$(ReleasePath)\AvePointRevIM.dll" DestinationFolder="$(HotfixPath)" ContinueOnError="false" /> -->
	</Target>
</Project>