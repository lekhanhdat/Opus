<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>
    <DataTemplate x:Key="InstallDetailItemTemplate">
        <StackPanel
            Margin="{Binding Path= UnitType, Converter={StaticResource PageWizardItemUnitTypeLocationConverter}}"
            Orientation="Horizontal" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
            Focusable="False"
            Visibility="{Binding Path=IsVisibility, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=true}"
            MaxHeight="19">
            <Grid Focusable="False" Margin="0,0,15,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Focusable="False" Text="{Binding Content}" />
            </Grid>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>