<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
  <!--button effect-->
  <Storyboard x:Key="OnMouseEnter1">
    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="image">
      <LinearDoubleKeyFrame KeyTime="0" Value="0.7" />
      <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
    </DoubleAnimationUsingKeyFrames>
  </Storyboard>
  <Storyboard x:Key="OnMouseMove1">
    <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="image">
      <LinearDoubleKeyFrame KeyTime="0" Value="1" />
      <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0.7" />
    </DoubleAnimationUsingKeyFrames>
  </Storyboard>
  <!--button-->
  <ControlTemplate x:Key="win_btn_mini" TargetType="{x:Type Button}">
      <Grid Width="21" Height="21" Margin="0,0,6,0" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Image x:Name="image" HorizontalAlignment="Stretch" Height="21" 
             Source="/AvePoint.CallAssist.CommonDeploymentGUI;component/UI/BaseWindowUI/Images/mini_21x21_over.png" Stretch="Fill"
             VerticalAlignment="Stretch" Width="21" Opacity="0.7" Cursor="Hand" />
    </Grid>
    <ControlTemplate.Triggers>
      <EventTrigger RoutedEvent="Mouse.MouseEnter">
        <BeginStoryboard Storyboard="{StaticResource OnMouseEnter1}" />
      </EventTrigger>
      <EventTrigger RoutedEvent="Mouse.MouseLeave">
        <BeginStoryboard x:Name="OnMouseMove1_BeginStoryboard1" Storyboard="{StaticResource OnMouseMove1}" />
      </EventTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
  
  <ControlTemplate x:Key="win_btn_close" TargetType="{x:Type Button}">
    <Grid Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Image x:Name="image" HorizontalAlignment="Stretch" Height="21" Margin="0"
             Source="/AvePoint.CallAssist.CommonDeploymentGUI;component/UI/BaseWindowUI/Images/close_21x21_over.png" Stretch="Fill"
             VerticalAlignment="Stretch" Width="21" Opacity="0.7" Cursor="Hand"/>
    </Grid>
    <ControlTemplate.Triggers>
      <EventTrigger RoutedEvent="Mouse.MouseEnter">
        <BeginStoryboard Storyboard="{StaticResource OnMouseEnter1}" />
      </EventTrigger>
      <EventTrigger RoutedEvent="Mouse.MouseLeave">
        <BeginStoryboard x:Name="OnMouseMove1_BeginStoryboard1" Storyboard="{StaticResource OnMouseMove1}" />
      </EventTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

    <ControlTemplate x:Key="win_btn_close_grey" TargetType="{x:Type Button}">
        <Grid Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image x:Name="image" HorizontalAlignment="Stretch" Height="21" Margin="0"
             Source="/AvePoint.CallAssist.CommonDeploymentGUI;component/UI/BaseWindowUI/Images/close_grey_21x21_over.png" Stretch="Fill"
             VerticalAlignment="Stretch" Width="21" Opacity="0.7" Cursor="Hand"/>
        </Grid>
        <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="Mouse.MouseEnter">
                <BeginStoryboard Storyboard="{StaticResource OnMouseEnter1}" />
            </EventTrigger>
            <EventTrigger RoutedEvent="Mouse.MouseLeave">
                <BeginStoryboard x:Name="OnMouseMove1_BeginStoryboard1" Storyboard="{StaticResource OnMouseMove1}" />
            </EventTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>