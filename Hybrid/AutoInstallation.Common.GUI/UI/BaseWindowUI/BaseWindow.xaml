<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AutoInstallation.Common.GUI"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Class="CommonDeploymentGUI.BaseWindow"
    mc:Ignorable="d">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../Styles/DefaultStyle.xaml" />
        <ResourceDictionary Source="WinButtonStyle.xaml" />
        <ResourceDictionary Source="ResizeGrip.xaml" />
        <ResourceDictionary Source="../../BaseControl/ButtonStyle.xaml" />
        <ResourceDictionary Source="../../BaseControl/FrameStyle.xaml" />
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>

    <!--Main Style-->
    <ControlTemplate x:Key="BaseWindowControlTemplate" TargetType="{x:Type local:BaseWindow}">
        <Grid Margin="0">
            <Grid.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.6" />
            </Grid.Effect>
            <Border BorderBrush="#FF636363" BorderThickness="1" Background="#FFB6B6B6">
                <Border BorderBrush="#FF7A7A7A" BorderThickness="1" Margin="6,30,6,6" Background="#FFFFFFFF" />
            </Border>
            <!--Title Text-->
            <TextBlock Margin="38,6,0,0" TextWrapping="Wrap" Text="{Binding Data.Title}" VerticalAlignment="Top"
                       FontFamily="Segoe UI" FontSize="14" Foreground="#FF333333">
                <TextBlock.Effect>
                    <DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="8" Opacity="1" />
                </TextBlock.Effect>
            </TextBlock>
            <!--Icon-->
            <Border>
                <Image x:Name="img_Title" HorizontalAlignment="Left" Height="24" Width="24" Margin="10,5,0,0"
                       Stretch="UniformToFill" VerticalAlignment="Top" Source="{Binding Data.TitleImage}" />
            </Border>

            <Grid>
                <DockPanel VerticalAlignment="Top" LastChildFill="false" Margin="0" Height="auto" x:Name="borderTitle"
                           Background="Transparent">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,1,6,0">
                        <Button IsTabStop="False" FocusVisualStyle="{x:Null}" Content="Min" x:Name="btnMin"
                                HorizontalAlignment="Left" Height="20" Width="26" Margin="0,0,1,0"
                                VerticalAlignment="Top" Template="{StaticResource win_btn_mini}" />
                        <Button IsTabStop="False" FocusVisualStyle="{x:Null}" Content="Max" x:Name="btnMax"
                                HorizontalAlignment="Left" Height="20" Width="25" Margin="0,0,1,0"
                                VerticalAlignment="Top" Template="{StaticResource win_btn_max}" />
                        <Button IsTabStop="False" FocusVisualStyle="{x:Null}" Content="Restore" x:Name="btnRestore"
                                HorizontalAlignment="Left" Height="20" Width="25" Margin="0,0,1,0"
                                VerticalAlignment="Top" Template="{StaticResource win_btn_restore}"
                                Visibility="Collapsed" />
                        <Button IsTabStop="False" FocusVisualStyle="{x:Null}" Content="Close" x:Name="btnClose"
                                HorizontalAlignment="Left" Height="20" Width="45" Margin="0,0,1,0"
                                VerticalAlignment="Top" Template="{StaticResource win_btn_close}" />
                    </StackPanel>
                </DockPanel>
                <AdornerDecorator d:IsHidden="True">
                    <ContentPresenter />
                </AdornerDecorator>
            </Grid>
            <Grid Margin="8,32,8,8">
                <Grid x:Name="footer" Height="44" Margin="0" VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="221" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Visibility="{Binding Data.WizardType, Converter={StaticResource BooleanToVisibilityConverter}}"
                        BorderThickness="0,0,1,0" BorderBrush="#FFbababa" />
                    <StackPanel Margin="0" Orientation="Horizontal" Width="Auto" HorizontalAlignment="Right"
                                Grid.Column="1">
                        <Button x:Name="BtnBack"
                                Margin="{StaticResource MainWindowButtonMargin}"
                                Height="24"
                                Content="{Binding BackButton.Content}"
                                Visibility="{Binding BackButton.Vis}"
                                IsEnabled="{Binding BackButton.Enabled}"
                                Command="{Binding BackButton.Command}"
                                HorizontalAlignment="Right" />
                        <Button x:Name="BtnNext"
                                Margin="{StaticResource MainWindowButtonMargin}"
                                Height="24"
                                Content="{Binding NextButton.Content}"
                                Visibility="{Binding NextButton.Vis}"
                                IsEnabled="{Binding NextButton.Enabled}"
                                Command="{Binding NextButton.Command}"
                                Style="{StaticResource RecommandedButtonStyle}" HorizontalAlignment="Right" />
                        <Button x:Name="BtnCancel"
                                Margin="{StaticResource MainWindowButtonMargin}"
                                Height="24"
                                Content="{Binding CancelButton.Content}"
                                IsEnabled="{Binding CancelButton.Enabled}"
                                Visibility="{Binding CancelButton.Vis}"
                                Command="{Binding CancelButton.Command}"
                                HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,0,0,42">
                    <Grid Margin="0,0,0,1">
                        <Frame x:Name="frame_MainContent" Content="{Binding Data.MainContentPage}"
                               Style="{StaticResource ucMainFrame}"
                               Margin="0,0,0,-2" />
                    </Grid>
                </Grid>
                <Grid Margin="0,0,0,0">
                    <Grid Margin="0,0,0,1">
                        <Frame x:Name="frame_FullScreen"
                               Visibility="{Binding Data.FullSreenFrameVisbility, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Content="{Binding Data.FullScreenPage}"
                               Style="{StaticResource ucMainFrame}"
                               Margin="0,0,0,0" />
                    </Grid>
                </Grid>
            </Grid>
            <ResizeGrip x:Name="WindowResizeGrip"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Visibility="Collapsed"
                        IsTabStop="false" />
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="ResizeMode" Value="CanResizeWithGrip">
                <Setter TargetName="WindowResizeGrip" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="WindowState" Value="Maximized">
                <Setter TargetName="btnMax" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="btnRestore" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="BaseWindowStyle" TargetType="{x:Type local:BaseWindow}">
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="Template" Value="{StaticResource BaseWindowControlTemplate}" />
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="MinWidth" Value="500" />

    </Style>

</ResourceDictionary>