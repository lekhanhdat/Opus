<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:AutoInstallation.Common.GUI"
                    xmlns:contract="clr-namespace:AutoInstallation.Contract.Message;assembly=CloudAgentConfigurationToolContract"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="d">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary
                    Source="/CloudAgentConfigurationToolCommonGUI;component/UI/BaseWindowUI/WinButtonStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:MessageWindowIconTypeIconImageConverter x:Key="MessageWindowIconTypeIconImageConverter" />
        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>
    <!--Main Style-->
    <ControlTemplate x:Key="BaseMessageWindowControlTemplate" TargetType="{x:Type contract:BaseMessage}">
        <Border Margin="0" Padding="10" VerticalAlignment="Center" HorizontalAlignment="Center"
                MaxHeight="180" MinHeight="180"
                Width="500">

            <!--Main Border with Background -->
            <Grid Margin="0">
                <Border BorderBrush="#FF555555" BorderThickness="1" Background="#FF555555">
                    <Border BorderBrush="#FF555555" BorderThickness="1" Background="#FFFFFFFF" />
                    <!--<Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.6"/>
                    </Border.Effect>-->
                </Border>


                <!--Title Text-->
                <!--<TextBlock Margin="38,6,0,0" TextWrapping="Wrap" Text="Records" VerticalAlignment="Top" FontFamily="Segoe UI" FontSize="14" Foreground="#FF333333">
                    <TextBlock.Effect>
            		    <DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="8" Opacity="1"/>
            	    </TextBlock.Effect>
                </TextBlock>-->
                <!--Icon-->
                <!--<Border>
                    <Image HorizontalAlignment="Left" Height="24" Width="24" Margin="10,5,0,0" Stretch="UniformToFill" VerticalAlignment="Top" Source="Images\Records_24x24.png"/>
                </Border>-->
                <Grid>
                    <DockPanel VerticalAlignment="Top" LastChildFill="false" Margin="0" Height="Auto"
                               x:Name="borderTitle" Background="Transparent">
                        <StackPanel DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    Margin="8,0,6,0">
                            <!--<Button IsTabStop="False"
                                    FocusVisualStyle="{x:Null}"
                                    Content="Close"
                                    x:Name="btnClose"
                                    HorizontalAlignment="Left"
                                    Height="20"
                                    Width="45"
                                    Margin="1"
                                    VerticalAlignment="Top"
                                    Template="{StaticResource win_btn_close}" />-->
                        </StackPanel>
                    </DockPanel>
                    <AdornerDecorator VerticalAlignment="Stretch">

                        <Grid Height="Auto" Margin="25,40,8,8" VerticalAlignment="Stretch">
                            <Grid.RowDefinitions>
                                <!--Content-->
                                <RowDefinition Height="*" />
                                <!--Button-->
                                <RowDefinition Height="40" />
                            </Grid.RowDefinitions>

                            <!--Content-->
                            <Grid Margin="0,0,0,0" HorizontalAlignment="Left" Grid.Row="0" VerticalAlignment="Top">
                                <Grid.ColumnDefinitions>
                                    <!--Image-->
                                    <ColumnDefinition Width="Auto" />
                                    <!--Content-->
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image VerticalAlignment="Top"
                                       Grid.Column="0"
                                       Width="32"
                                       Height="32"
                                       Stretch="Fill"
                                       x:Name="mwIcon" />
                                <ScrollViewer Grid.Column="1" Style="{DynamicResource RichScrollViewer}"
                                              BorderThickness="0" VerticalScrollBarVisibility="Auto">
                                    <StackPanel Grid.Column="1">
                                        <Grid Grid.Column="1">
                                            <StackPanel Margin="25,0,0,0">
                                                <Grid Margin="0" x:Name="contentGrid" VerticalAlignment="Center">
                                                    <Grid.RowDefinitions>
                                                        <!--Title-->
                                                        <RowDefinition Height="Auto" />
                                                        <!--Summary-->
                                                        <RowDefinition Height="Auto" />
                                                        <!--<RowDefinition Height="Auto"/>-->
                                                    </Grid.RowDefinitions>
                                                    <!--Title-->
                                                    <TextBlock Grid.Row="0"
                                                               Margin="0"
                                                               x:Name="messageTitle"
                                                               TextWrapping="Wrap"
                                                               Text="{TemplateBinding BaseMessageContentTitle}"
                                                               VerticalAlignment="Top" Visibility="Collapsed" />
                                                    <!--Summary-->
                                                    <TextBlock Grid.Row="1"
                                                               Margin="0"
                                                               x:Name="messageSummary"
                                                               TextWrapping="Wrap"
                                                               Text="{TemplateBinding BaseMessageContentSummary}"
                                                               VerticalAlignment="Top" />
                                                    <!--
                                                这块取而代之的是一个ContentControl，既能放text也能放别的任何东西
                                            -->
                                                    <ContentControl Grid.Row="1" Content="{TemplateBinding Content}"
                                                                    VerticalAlignment="Top"
                                                                    HorizontalAlignment="Center" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                            <!--Button-->
                            <Grid Grid.Row="1" VerticalAlignment="Bottom" Margin="0">
                                <Border x:Name="footer" Height="44" Margin="0" VerticalAlignment="Bottom">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,0"
                                                Width="Auto">
                                        <Button Content="{TemplateBinding DetailContent}"
                                                x:Name="detailButton"
                                                VerticalAlignment="Center"
                                                Margin="{DynamicResource BaseMessageButtonMargin}"
                                                Height="24"
                                                IsDefault="True"
                                                IsCancel="True" Visibility="Visible" />
                                        <Button Content="{TemplateBinding TestContent}"
                                                x:Name="testButton"
                                                VerticalAlignment="Center"
                                                Margin="{DynamicResource BaseMessageButtonMargin}"
                                                Height="24"
                                                IsDefault="True"
                                                IsCancel="False" Visibility="Visible" />
                                        <Button Content="{TemplateBinding RetryContent}"
                                                x:Name="retryButton"
                                                VerticalAlignment="Center"
                                                Margin="{DynamicResource BaseMessageButtonMargin}"
                                                Height="24"
                                                IsDefault="True" Visibility="Visible" />
                                        <Button Content="{TemplateBinding YesContent}"
                                                x:Name="yesButton"
                                                VerticalAlignment="Center"
                                                Margin="{DynamicResource BaseMessageButtonMargin}"
                                                Height="24"
                                                IsDefault="True" Visibility="Visible" />
                                        <Button Content="{TemplateBinding NoContent}"
                                                x:Name="noButton"
                                                VerticalAlignment="Center"
                                                Margin="{DynamicResource BaseMessageButtonMargin}"
                                                Height="24"
                                                IsDefault="True" Visibility="Visible" />
                                        <Button Content="{TemplateBinding IgnoreContent}"
                                                x:Name="ignoreButton"
                                                VerticalAlignment="Center"
                                                Margin="{DynamicResource BaseMessageButtonMargin}"
                                                Height="24"
                                                IsCancel="True" Visibility="Visible" />
                                        <Button Content="{TemplateBinding UpdateContent}"
                                                x:Name="updateButton"
                                                VerticalAlignment="Center"
                                                Margin="{DynamicResource BaseMessageButtonMargin}"
                                                Height="24"
                                                IsCancel="True" Visibility="Visible" />
                                        <Button Content="{TemplateBinding OkContent}"
                                                x:Name="okButton"
                                                VerticalAlignment="Center"
                                                Margin="{DynamicResource BaseMessageButtonMargin}"
                                                Height="24"
                                                IsDefault="True"
                                                IsCancel="True" Visibility="Visible" />
                                        <Button Content="{TemplateBinding CancelContent}"
                                                x:Name="cancelButton"
                                                VerticalAlignment="Center"
                                                Margin="{DynamicResource BaseMessageButtonMargin}"
                                                Height="24"
                                                IsCancel="True" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </AdornerDecorator>
                </Grid>
            </Grid>
        </Border>
        <!--<ControlTemplate.Triggers>
                        <Trigger Property="ResizeMode" Value="CanResizeWithGrip">
                            <Setter TargetName="WindowResizeGrip" Property="Visibility" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>-->
    </ControlTemplate>

    <Style TargetType="{x:Type contract:BaseMessage}">
        <Setter Property="Template" Value="{StaticResource BaseMessageWindowControlTemplate}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!--<Setter Property="AllowsTransparency" Value="True" />-->
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="MaxHeight" Value="160" />
        <Setter Property="MaxWidth" Value="500" />
    </Style>

</ResourceDictionary>