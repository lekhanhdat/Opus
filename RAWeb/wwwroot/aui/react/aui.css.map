:where(a, .link) {
  text-decoration: underline;
  color: var(--link-color);
  background-color: transparent;
  cursor: pointer;
  overflow-wrap: anywhere;
}
:where(a, .link):visited {
  color: var(--link-visited-color);
}
@media (hover: hover) {
  :where(a, .link):hover {
    text-decoration: underline;
    color: var(--link-hover-color);
  }
}
:where(a, .link):active {
  color: var(--link-active-color);
}
:where(a, .link):is([disabled], [aria-disabled='true'], [data-disabled='true']) {
  color: var(--disabled-color);
  background: transparent;
  border-color: transparent;
  text-decoration: none !important;
  opacity: var(--disabled-opacity);
  cursor: not-allowed;
}
:where(button, select, textarea, input:not([type='image'])) {
  font-family: inherit;
  font-size: 1em;
  margin: 0;
  max-width: 100%;
  color: inherit;
}
:where(select, textarea, input:not([type='image'])) {
  background: var(--section-bg);
}
@media (hover: hover) {
  :where(select, textarea, input:not([type='image'])):hover {
    border-color: var(--hover-border);
    color: var(--hover-color);
  }
}
:where(select, textarea, input:not([type='image'])):focus,
:where(select, textarea, input:not([type='image'])):focus-visible {
  border-color: var(--entry-border);
  color: var(--entry-color);
  background: var(--entry-bg);
}
:where(select, textarea, input:not([type='image'])):is([readonly], [aria-readonly='true']) {
  border-color: var(--readonly-border);
  background: var(--readonly-bg);
  color: var(--readonly-color);
}
:where(select, textarea, input:not([type='image'])):disabled:not(:where([aria-disabled='false'], [data-disabled='false'])) {
  border-color: var(--disabled-border);
  background: var(--disabled-bg);
  color: var(--disabled-color);
  cursor: not-allowed;
}
:where(select, textarea, input:is([type='text'], [type='password'], [type='search'], [type='email'], [type='number'], [type='tel'])) {
  display: block;
  width: 100%;
  height: var(--widget-height-m);
  padding: 0 var(--gap-s);
  border: var(--border-m) solid var(--focusable-border);
}
:where(input:is([type='checkbox'], [type='radio'])) {
  width: var(--widget-height-xxxs);
  height: var(--widget-height-xxxs);
  border: var(--border-m) solid var(--focusable-border);
  color: var(--icon-color);
  accent-color: currentcolor;
}
:where(textarea) {
  height: var(--widget-height-xxl);
  padding: var(--gap-s);
}
input[type='number'] {
  -moz-appearance: textfield;
}
input[type='number']::-webkit-inner-spin-button,
input[type='number']::-webkit-outer-spin-button {
  -webkit-appearance: none;
  margin: 0;
  pointer-events: none;
}
input[type='search']::-webkit-search-decoration,
input[type='search']::-webkit-search-cancel-button,
input[type='search']::-webkit-search-results-button,
input[type='search']::-webkit-search-results-decoration {
  display: none;
}
input::-ms-reveal {
  display: none;
}
::placeholder {
  opacity: 1;
  text-align: start;
}
:is(input, textarea):placeholder-shown {
  text-overflow: ellipsis;
}
:is(input, textarea)::placeholder {
  color: var(--placeholder-color);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
:is(input, textarea):disabled::placeholder {
  color: var(--disabled-placeholder);
}
textarea:focus::placeholder {
  white-space: normal;
}
* {
  scrollbar-color: var(--focusable-border) var(--normal-border);
  scrollbar-width: thin;
}
@media (hover: hover) {
  .hover-scrollbar {
    scrollbar-color: transparent transparent;
  }
  .hover-scrollbar:hover {
    scrollbar-color: var(--focusable-border) var(--normal-border);
  }
}
.invisible-scrollbar,
.invisible-scrollbar * {
  scrollbar-width: none;
}
.invisible-scrollbar::-webkit-scrollbar {
  width: 0;
  height: 0;
}
*,
*::before,
*::after {
  box-sizing: border-box;
}
* {
  line-height: round(down, calc(1em * var(--line-spacing)), 2px);
}
:focus {
  outline: 0 solid transparent;
}
:focus-visible {
  outline: 1px auto var(--focus-outline);
}
[aria-disabled='true'],
