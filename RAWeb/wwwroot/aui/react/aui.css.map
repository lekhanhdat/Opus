  border-color: var(--error-color) !important;
}
.aui-richeditor[aria-invalid='true'] > .cke:focus-visible {
  outline-style: var(--outline-style);
}
aui-editor[aria-invalid='true'] {
  border-image: none;
  clip-path: none;
  outline-color: var(--error-color) !important;
  border-color: var(--error-color) !important;
}
aui-editor[aria-invalid='true']:focus-visible {
