<local:BaseWindow x:Class="AutoInstallation.Records.App.Installer.View.Windows.ProxyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoInstallation.Records.App.Installer.View.Windows"
        xmlns:src="clr-namespace:AutoInstallation.Common.GUI;assembly=CloudAgentConfigurationToolCommonGUI"
        mc:Ignorable="d"
       Title="{Binding Source='Key_GUI_App_Title',Converter={StaticResource MessageI18N},ConverterParameter='ConfigurationTool'}" Loaded="BaseWindow_Loaded">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../../Resources/Styles/Style.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="312" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="25" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <Grid Grid.Row="0" >
                <Grid.Background>
                    <ImageBrush x:Name="BackgroundImage" ImageSource="../../Images/bg.png" />
                </Grid.Background>
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <Grid Grid.Row="1" Grid.Column="1">
                    <TextBlock  Margin="15,5,0,5" 
                            HorizontalAlignment="Stretch" d:LayoutOverrides="Width"
                           TextWrapping="WrapWithOverflow"
                           TextAlignment="Left"
                           LineHeight="19"
                           FontFamily="Segoe UI"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="#333333"
                           Text="{Binding Source='Key_GUI_Agent_Configuration',Converter={StaticResource MessageI18N},ConverterParameter='ConfigurationTool'}"
                           />
                </Grid>
                <Grid Grid.Row="2" Grid.Column="1" Grid.RowSpan="11" Background="White">
                </Grid>

                <CheckBox Grid.Row="2" Grid.Column="1" Margin="20,2,0,2"  
                        IsChecked="{Binding EnableProxy, Mode=TwoWay}"
                        Click="ClickEnableProxy"
                        Content="{Binding Source='Key_GUI_Proxy_Using_Proxy',Converter={StaticResource MessageI18N},ConverterParameter='ConfigurationTool'}"></CheckBox>

                <Grid Grid.Row="3" Grid.Column="1">
                    <TextBlock FontSize="14" Margin="28,2,0,2" Foreground="Red"  TextWrapping="Wrap"
                               HorizontalAlignment="Stretch" d:LayoutOverrides="Width" 
                               Text="*"
                               />
                    <TextBlock FontSize="14" Margin="40,2,0,2" Foreground="#333333"  TextWrapping="Wrap"
                               HorizontalAlignment="Stretch" d:LayoutOverrides="Width" 
                               Text="{Binding Source='Key_GUI_Proxy_Host',Converter={StaticResource MessageI18N},ConverterParameter='ConfigurationTool'}"
                               />
                </Grid>
                <Grid Grid.Row="4" Grid.Column="1">
                    <src:TextBoxEx Grid.Row="4" Grid.Column="1" Text="{Binding ProxyHost, Mode=TwoWay}" ShowMsgOnBottom="True"
                           Name="NameProxyHost"
                                       ErrorMsg="{Binding ProxyHostMsg}" 
                                       VerticalContentAlignment="Center"
                                       Padding="0,0,0,5"
                                       Margin="39,2,0,2"  VerticalAlignment="Top" HorizontalAlignment="Left" Width="200">
                    </src:TextBoxEx>
                </Grid>


                <Grid Grid.Row="5" Grid.Column="1">
                    <TextBlock FontSize="14" Margin="28,2,0,2" Foreground="Red"  TextWrapping="Wrap"
                               HorizontalAlignment="Stretch" d:LayoutOverrides="Width" 
                               Text="*"
                               />
                    <TextBlock FontSize="14" Margin="40,2,0,2" Foreground="#333333"  TextWrapping="Wrap"
                               HorizontalAlignment="Stretch" d:LayoutOverrides="Width" 
                               Text="{Binding Source='Key_GUI_Proxy_Port',Converter={StaticResource MessageI18N},ConverterParameter='ConfigurationTool'}"
                               />
                </Grid>


                <src:TextBoxEx Grid.Row="6" Grid.Column="1" Text="{Binding ProxyPort, Mode=TwoWay}" ShowMsgOnBottom="True"
                           Name="NameProxyPort"
                                       ErrorMsg="{Binding ProxyPortMsg}" 
                                       VerticalContentAlignment="Center"
                                       Padding="0,0,0,5"
                                       Margin="39,2,0,2"  VerticalAlignment="Top" HorizontalAlignment="Left" Width="200">
                </src:TextBoxEx>

                <TextBlock Grid.Row="7" Grid.Column="1" FontSize="14" Margin="40,2,0,2" Foreground="#333333"  TextWrapping="Wrap"
                               HorizontalAlignment="Stretch" d:LayoutOverrides="Width" 
                               Text="{Binding Source='Key_GUI_Proxy_UserName',Converter={StaticResource MessageI18N},ConverterParameter='ConfigurationTool'}"
                               />

                <src:TextBoxEx Grid.Row="8" Grid.Column="1" Text="{Binding UserName, Mode=TwoWay}" ShowMsgOnBottom="True"
                           Name="NameProxyUserName"
                                       ErrorMsg="{Binding UserNameMsg}" 
                                       VerticalContentAlignment="Center"
                                       Padding="0,0,0,5"
                                       Margin="39,2,0,2"  VerticalAlignment="Top" HorizontalAlignment="Left" Width="200">
                </src:TextBoxEx>

                <TextBlock Grid.Row="9" Grid.Column="1" FontSize="14" Margin="40,2,0,2" Foreground="#333333"  TextWrapping="Wrap"
                               HorizontalAlignment="Stretch" d:LayoutOverrides="Width" 
                               Text="{Binding Source='Key_GUI_Proxy_Password',Converter={StaticResource MessageI18N},ConverterParameter='ConfigurationTool'}"
                               />
                <PasswordBox Grid.Row="10" Grid.Column="1" Name="NameProxyPassword"
                                     src:PasswordBoxBindingHelper.IsPasswordBindingEnabled="True"
                                     src:PasswordBoxBindingHelper.BoundPassword="{Binding Path=Password, Mode=TwoWay,  UpdateSourceTrigger=PropertyChanged}"
                                     Margin="40,2,0,0" VerticalAlignment="Top"
                                     VerticalContentAlignment="Center"
                                     Padding="0,5,0,0"
                                     HorizontalAlignment="Left"  Width="200"/>
                <TextBlock Grid.Row="11" Grid.Column="1" Foreground="Red" Text="{Binding ErrorMsg}" Margin="39,30,0,0"
                                   Width="200"
                                   Visibility="{Binding ErrorMsgVis}" />


                <Grid Grid.Column="1" Grid.RowSpan="11">
                    <StackPanel Margin="1,1,1,1"
                    Background="#50333333"
                    Visibility="{Binding Path=IsConfiguring, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=true}"
                    >
                        <src:GifImage Source="../../Images/loading_64x64.gif" Width="64" Height="64" Margin="50,130,50,100"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </ScrollViewer>
        <Grid Grid.Row="1" Margin="0, 0, 6, 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.5" />
                <RowDefinition Height="1.5" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="#A0A0A0" Margin="0, 0, 1, 0" />
            <Grid Grid.Row="1" Background="White" />
        </Grid>
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="16" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="3"
                    Name="NextBtn"
                    Style="{StaticResource ActionButton}"
                    Content="{Binding Source='Key_GUI_Agent_Action_Next',Converter={StaticResource MessageI18N},ConverterParameter='ConfigurationTool'}"
                    IsDefault="True"
                    Click="NextAction" />
            <Button Grid.Column="5"
                    Style="{StaticResource ActionButton}"
                    Content="{Binding Source='Key_GUI_Agent_Action_Close',Converter={StaticResource MessageI18N},ConverterParameter='ConfigurationTool'}"
                    Click="CloseAction" />
        </Grid>
    </Grid>
</local:BaseWindow>
