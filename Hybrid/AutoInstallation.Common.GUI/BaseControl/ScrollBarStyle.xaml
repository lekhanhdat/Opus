        </ControlTemplate.Triggers>
    </ControlTemplate>
    <ControlTemplate x:Key="HorizontalScrollBar"
                     TargetType="{x:Type ScrollBar}">
        <ControlTemplate.Resources>
            <Storyboard x:Key="MouseEnter">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00"
                                               Storyboard.TargetName="SmallIncreaseBg"
                                               Storyboard.TargetProperty="(UIElement.Opacity)">
                    <LinearDoubleKeyFrame KeyTime="00:00:00.3000000"
                                          Value="1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00"
                                               Storyboard.TargetName="SmallDecreaseBg"
                                               Storyboard.TargetProperty="(UIElement.Opacity)">
                    <SplineDoubleKeyFrame KeyTime="00:00:00.3000000"
                                          Value="1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="MouseLeave">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00"
                                               Storyboard.TargetName="SmallIncreaseBg"
                                               Storyboard.TargetProperty="(UIElement.Opacity)">
                    <LinearDoubleKeyFrame KeyTime="00:00:00"
                                          Value="1" />
                    <LinearDoubleKeyFrame KeyTime="00:00:00.3000000"
                                          Value="0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00"
                                               Storyboard.TargetName="SmallDecreaseBg"
                                               Storyboard.TargetProperty="(UIElement.Opacity)">
                    <LinearDoubleKeyFrame KeyTime="00:00:00"
                                          Value="1" />
                    <LinearDoubleKeyFrame KeyTime="00:00:00.3000000"
                                          Value="0" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ControlTemplate.Resources>
        <Grid Height="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition MaxWidth="15" />
                <ColumnDefinition Width="0.00001*" />
                <ColumnDefinition MaxWidth="15" />
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="3"
                    CornerRadius="1"
                    Background="#F0F0F0" />
            <Border x:Name="SmallDecreaseBg"
                    CornerRadius="1"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource NormalBorderBrush}"
                    Margin="0"
                    Opacity="0">
                <Rectangle Stroke="#FFEAEBEC"
                           Fill="{DynamicResource HScrollbarBkgNormFill}"
                           RadiusX="1"
                           RadiusY="1" />
            </Border>
            <RepeatButton Grid.Column="0"
                          Style="{StaticResource HScrollBarLineButton}"
                          Width="15"
                          Command="ScrollBar.LineLeftCommand"
                          Content="M 4 0 L 4 8 L 0 4 Z" />
            <Track x:Name="PART_Track"
                   Grid.Column="1"
                   IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                                  Command="ScrollBar.PageLeftCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource HScrollBarThumb}"
                           Margin="0"
                           Background="{StaticResource NormalBrush}"
                           BorderBrush="{StaticResource NormalBorderBrush}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                                  Command="ScrollBar.PageRightCommand" />
                </Track.IncreaseRepeatButton>
            </Track>
            <Border x:Name="SmallIncreaseBg"
                    CornerRadius="1"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource NormalBorderBrush}"
                    Margin="0"
                    Grid.Row="0"
                    Opacity="0"
                    Grid.Column="2">
                <Rectangle Stroke="#FFEAEBEC"
                           Fill="{DynamicResource HScrollbarBkgNormFill}"
                           RadiusX="1"
                           RadiusY="1" />
            </Border>
            <RepeatButton Grid.Column="3"
                          Style="{StaticResource HScrollBarLineButton}"
                          Width="15"
                          Command="ScrollBar.LineRightCommand"
                          Content="M 0 0 L 4 4 L 0 8 Z" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver"
                     Value="True">
                <Trigger.ExitActions>
                    <BeginStoryboard x:Name="MouseLeave_BeginStoryboard"
                                     Storyboard="{StaticResource MouseLeave}" />
                </Trigger.ExitActions>
                <Trigger.EnterActions>
                    <BeginStoryboard Storyboard="{StaticResource MouseEnter}" />
                </Trigger.EnterActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="{x:Type ScrollBar}"
           TargetType="{x:Type ScrollBar}">
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <Setter Property="OverridesDefaultStyle"
                Value="true" />
        <Style.Triggers>
            <Trigger Property="Orientation"
                     Value="Horizontal">
                <Setter Property="Width"
                        Value="Auto" />
                <Setter Property="Height"
                        Value="15" />
                <Setter Property="Focusable"
                        Value="true" />
                <Setter Property="FocusVisualStyle"
                        Value="{StaticResource HScrollBarFocusVisual}" />
                <Setter Property="Template"
                        Value="{StaticResource HorizontalScrollBar}" />
            </Trigger>
            <Trigger Property="Orientation"
                     Value="Vertical">
                <Setter Property="Width"
                        Value="15" />
                <Setter Property="Height"
                        Value="Auto" />
                <Setter Property="Focusable"
                        Value="true" />
                <Setter Property="FocusVisualStyle"
                        Value="{StaticResource VScrollBarFocusVisual}" />
                <Setter Property="Template"
                        Value="{StaticResource VerticalScrollBar}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>