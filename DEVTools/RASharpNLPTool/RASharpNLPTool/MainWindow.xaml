<Window x:Class="RASharpNLPTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RASharpNLPTool"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="800">



    <TabControl >

        <TabItem Header="Noun" Width="80">
            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="20"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="50"></RowDefinition>
                    <RowDefinition Height="2*"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Text="Attention! This page treats all input as nouns."  Grid.Row="0" HorizontalAlignment="Center" />
                <StackPanel x:Name="sp_InputAreaNoun" Margin="2" Grid.Row="1" >
                    <TextBox x:Name="tb_InputNoun"  FontSize="18" Height="145" Margin="5 5 5 1" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel x:Name="sp_OperationArea" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" >
                    <!--<CheckBox x:Name="cb_RegardedAsNoun" Content="Check" Width="150" Height="30"  Margin="20 5 5 5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="20" IsChecked="False"/>-->
                    <!--<Button x:Name="btn_CheckToken" Content="Check" Height="30" Width="80" Margin="5" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontSize="15"/>-->
                    <Button x:Name="btn_NounDeformate" Content="NounDeformate" Height="30" Width="100" Margin="5" FontSize="13" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"  Click="btn_NounDeformate_Click"/>
                    <Button x:Name="btn_ClearInputNoun" Content="ClearInput" Height="30" Width="100" Margin="5" FontSize="13" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"  Click="btn_ClearInputNoun_Click"/>
                    <Button x:Name="btn_ClearOutputNoun" Content="ClearOutput" Height="30" Width="100" Margin="5" FontSize="13" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"  Click="btn_ClearOutputNoun_Click"/>
                </StackPanel>
                <StackPanel x:Name="sp_OutputAreaNoun" Grid.Row="3" Margin="2">
                    <!--<TextBlock Height=""></TextBlock>-->
                    <TextBox x:Name="tb_OutputNoun" Margin="2" Height="300" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible" IsReadOnly="True"></TextBox>
                </StackPanel>
            </Grid>
        </TabItem>

        <TabItem Header="Verb" Width="80">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="20"></RowDefinition>
                    <RowDefinition Height="*"></RowDefinition>
                    <RowDefinition Height="50"></RowDefinition>
                    <RowDefinition Height="2*"></RowDefinition>
                </Grid.RowDefinitions>
                <TextBlock Text="Attention! This page is for finding verb and noun conjugations."  Grid.Row="0"  HorizontalAlignment="Center" />
                <StackPanel x:Name="sp_InputAreaVerb" Margin="2" Grid.Row="1" >
                    <TextBox x:Name="tb_InputVerb"  FontSize="18" Height="145" Margin="5 5 5 1" TextWrapping="WrapWithOverflow"/>
                </StackPanel>
                <StackPanel x:Name="sp_OperationAreaVerb" Grid.Row="2"  Orientation="Horizontal" HorizontalAlignment="Center" >
                    <!--<CheckBox x:Name="cb_RegardedAsNoun1" Content="Check" Width="150" Height="30"  Margin="20 5 5 5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="20" IsChecked="False"/>-->
                    <Button x:Name="btn_FindDeformate" Content="FindDeformate" Height="30" Width="100" Margin="5" FontSize="14" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Click="btn_FindDeformate_Click" />
                    <Button x:Name="btn_CheckTag" Content="CheckTags" Height="30" Width="100" Margin="5" FontSize="15"  VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Click="btn_CheckTag_Click"/>
                    <Button x:Name="btn_ClearInputVerbs" Content="ClearInput" Height="30" Width="100" Margin="5" FontSize="15"  VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Click="btn_ClearInputVerbs_Click"/>
                    <Button x:Name="btn_ClearOutputVerbs" Content="ClearOutput" Height="30" Width="100" Margin="5" FontSize="15"  VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Click="btn_ClearOutputVerbs_Click"/>
                </StackPanel>
                <StackPanel x:Name="sp_OutputAreaVerb" Grid.Row="3" Margin="2" Orientation="Horizontal">
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                            <ColumnDefinition Width="*"></ColumnDefinition>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="tb_OutputVerb" Margin="2" Height="305" Width="385" Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible" HorizontalAlignment="Center" IsReadOnly="True"></TextBox>
                        <TextBox x:Name="tb_OutputTags" Margin="2" Height="305" Width="385" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Visible" HorizontalAlignment="Center" IsReadOnly="True"></TextBox>
                    </Grid>
                </StackPanel>
            </Grid>
        </TabItem>
    </TabControl>

</Window>
