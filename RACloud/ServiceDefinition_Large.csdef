<ServiceDefinition name="ScheduleJobCloudService" xmlns="http://schemas.microsoft.com/ServiceHosting/2008/10/ServiceDefinition" schemaVersion="2015-04.2.6">
  <WorkerRole name="RAScheduleJobWorkerRole" vmsize="Large">
    <ConfigurationSettings>
      <Setting name="Microsoft.WindowsAzure.Plugins.Diagnostics.ConnectionString" />
      <Setting name="ConfigDatabaseConnection" />
      <Setting name="JobQueueConnectionString" />
      <Setting name="JobQueueName" />
      <Setting name="RealTimeQueueName"/>
      <Setting name="ReportContainerName" />
      <Setting name="ReportStorage" />
      <Setting name="ReportFolder" />
      <Setting name="LogStorage" />
      <Setting name="LogContainerName" />
      <Setting name="ControlServiceAddress" />
      <Setting name="PortalApiUrl" />
      <Setting name="CertificateThumbprint" />
      <Setting name="HotfixStorageUrl"/>
      <Setting name="AzureTableConnection"/>
      <Setting name="NotificationSetting" />
      <Setting name="RedirectAosLoginUrl" />
      <Setting name="CosmosDBURI" />
      <Setting name="CosmosDBSecret" />
      <Setting name="DAOKeyVaultCertThumbprint" />
      <Setting name="DAOKeyVaultUrl" />
      <Setting name="DAOKeyVaultClientId" />
      <Setting name="SubscriptionId" />
      <Setting name="SubscriptionCertThumbprint" />
      <Setting name="MaxBackupItemsThreads" />
      <Setting name="ReservedInstanceCount" />
    </ConfigurationSettings>
    <Runtime executionContext="elevated" />
    <LocalResources>
    </LocalResources>
    <Certificates>
      <Certificate name="CloudRecords Application" storeName="My" storeLocation="LocalMachine" />
      <Certificate name="DocAveOnline Application" storeName="My" storeLocation="LocalMachine" />
      <Certificate name="DocAveOnline KeyVault" storeName="My" storeLocation="LocalMachine" />
      <Certificate name="Subscription Management" storeName="My" storeLocation="LocalMachine" />
    </Certificates>
    <Startup>
      <Task commandLine="SecurityProtocolStartup.bat" executionContext="elevated" taskType="simple" />
    </Startup>
  </WorkerRole>
  
</ServiceDefinition>