<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="BCStyleLink.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Focus Visual -->
    <Style x:Key="CheckBoxFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border>
                        <Rectangle
                            Margin="15,-2,-2,-2"
                            StrokeThickness="1"
                            Stroke="Black"
                            StrokeDashArray="1 2" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- SimpleStyles: CheckBox -->
    <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
        <Setter Property="SnapsToDevicePixels" Value="true" />
        <Setter Property="OverridesDefaultStyle" Value="true" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource CheckBoxFocusVisual}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="FontFamily" Value="Arial" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#FF333333" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CheckBox}">
                    <ControlTemplate.Resources>
                        <Storyboard x:Key="CheckBoxOnMouseEnter">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)"
                                                           Storyboard.TargetName="BackgroundOver">
                                <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)"
                                                           Storyboard.TargetName="BoxOver">
                                <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                        <Storyboard x:Key="CheckBoxOnMouseLeave">
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)"
                                                           Storyboard.TargetName="BoxOver">
                                <LinearDoubleKeyFrame KeyTime="0" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)"
                                                           Storyboard.TargetName="BackgroundOver">
                                <LinearDoubleKeyFrame KeyTime="0" Value="1" />
                                <LinearDoubleKeyFrame KeyTime="0:0:0.3" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </ControlTemplate.Resources>
                    <BulletDecorator Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <BulletDecorator.Bullet>
                            <Grid Width="13" Height="13" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <Border x:Name="Border" Width="13" Height="13" CornerRadius="0" Background="White"
                                        BorderThickness="1" BorderBrush="#FF868686" />
                                <Rectangle x:Name="BackgroundOver" Width="13" Height="13" Fill="#FFDEF9FA"
                                           Stroke="#FF5989A5" StrokeThickness="1" Visibility="Visible" Opacity="0" />
                                <Rectangle x:Name="BackgroundPress" Width="13" Height="13" Fill="#FFC2E4F6"
                                           Stroke="#FF2C628B" StrokeThickness="1" Visibility="Collapsed" />
                                <Rectangle x:Name="BoxFill" Width="9" Height="9" Fill="#FFCACFD5" StrokeThickness="1">
                                    <Rectangle.Stroke>

                                        <LinearGradientBrush EndPoint="0.8,0.8" StartPoint="0.3,0.3">
                                            <GradientStop Color="#FFB3B8BD" />
                                            <GradientStop Color="#FFE0E0E0" Offset="1" />
                                        </LinearGradientBrush>

                                    </Rectangle.Stroke>
                                </Rectangle>
                                <Rectangle x:Name="BoxOver" Margin="0" Width="9" Height="9" Fill="#FFAFDEFD"
                                           StrokeThickness="1" Visibility="Visible" Opacity="0">
                                    <Rectangle.Stroke>
                                        <LinearGradientBrush EndPoint="0.8,0.8" StartPoint="0.3,0.3">
                                            <GradientStop Color="#FF79C6F9" Offset="0" />
                                            <GradientStop Color="#FFCFEDFD" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Stroke>
                                </Rectangle>
                                <Rectangle x:Name="BoxPress" Width="9" Height="9" Fill="#FF90CFFC" StrokeThickness="1"
                                           Visibility="Collapsed">
                                    <Rectangle.Stroke>
                                        <LinearGradientBrush EndPoint="0.8,0.8" StartPoint="0.3,0.3">
                                            <GradientStop Color="#FF5EB6F7" Offset="0" />
                                            <GradientStop Color="#FFC0E7FC" Offset="1" />
                                        </LinearGradientBrush>
                                    </Rectangle.Stroke>
                                </Rectangle>
                                <Rectangle x:Name="BoxGradient" Width="7" Height="7" StrokeThickness="1">
                                    <Rectangle.Fill>

                                        <LinearGradientBrush EndPoint="0.752,0.752" StartPoint="0.238,0.228">
                                            <GradientStop Color="#00F6F6F6" Offset="0.254" />
                                            <GradientStop Color="#53F8F8F8" Offset="0.54" />
                                            <GradientStop Color="#BFFFFFFF" Offset="1" />
                                        </LinearGradientBrush>

                                    </Rectangle.Fill>
                                </Rectangle>
                                <Rectangle x:Name="Focused" Stroke="#FF99DDFF" StrokeThickness="1" Margin="-1"
                                           Visibility="Collapsed" />
                                <Path x:Name="CheckMark" Margin="0,2,3,0" Width="7" Height="9" Stretch="Fill"
                                      Opacity="1" VerticalAlignment="Top" HorizontalAlignment="Right"
                                      Data="M103.78572,598.96112 L105.09846,597.5661 L107.00806,600.16229 C107.00806,600.16229 109.91004,592.74463 109.91004,592.74463 C109.91004,592.74463 111.74678,593.79761 111.74678,593.79761 C111.74678,593.79761 107.88566,602.75848 107.88566,602.75848 L106.60118,602.75848 z"
                                      Visibility="Collapsed" Fill="#FF425080" />
                                <Rectangle x:Name="BoxDis" Width="13" Height="13" Visibility="Collapsed"
                                           Fill="#CCFFFFFF" Stroke="#66FFFFFF" StrokeThickness="2" />
                            </Grid>
                        </BulletDecorator.Bullet>
                        <ContentPresenter Margin="4,0,4,0" VerticalAlignment="Top" HorizontalAlignment="Left"
                                          RecognizesAccessKey="True" />
                    </BulletDecorator>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                            <BeginStoryboard Storyboard="{StaticResource CheckBoxOnMouseEnter}" />
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                            <BeginStoryboard Storyboard="{StaticResource CheckBoxOnMouseLeave}" />
                        </EventTrigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Focused" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Visibility" TargetName="CheckMark" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="CheckMark" Property="Data" Value="M0,4 L7,4" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="true">
                            <Setter TargetName="BackgroundPress" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BoxPress" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" TargetName="BackgroundOver" Value="1" />
                            <Setter Property="Opacity" TargetName="BoxOver" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="false">
                            <Setter TargetName="BoxDis" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource DisabledForegroundBrush}" />
                            <Setter Property="Fill" TargetName="CheckMark" Value="#FF333333" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="IsEnabled" Value="True" />
        <Setter Property="IsChecked" Value="True" />
    </Style>
</ResourceDictionary>