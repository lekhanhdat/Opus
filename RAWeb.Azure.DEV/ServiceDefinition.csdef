<ServiceDefinition name="RAWeb.Azure" xmlns="http://schemas.microsoft.com/ServiceHosting/2008/10/ServiceDefinition" schemaVersion="2015-04.2.6">
  <WebRole name="RAWeb" vmsize="Small">
    <Sites>
      <Site name="Web" physicalDirectory="..\build\RevIMWorker.Web">
        <Bindings>
          <Binding name="Endpoint1" endpointName="HTTPSEndpoint1" />
        </Bindings>
      </Site>
    </Sites>
    <ConfigurationSettings>
      <Setting name="Microsoft.WindowsAzure.Plugins.Diagnostics.ConnectionString" />
      <Setting name="JobQueueConnectionString" />
      <Setting name="LogStorage" />
      <Setting name="JobQueueName" />
      <Setting name="LogContainerName" />
      <Setting name="ReportStorage" />
      <Setting name="ReportFolder" />
      <Setting name="LogKeepDays" />
      <Setting name="TenantDBTier" />
      <Setting name="RevIMHoldPhysicalLibraryName" />
      <Setting name="RevIMHomeLocationName" />
      <Setting name="AppUrl" />
      <Setting name="JobLimitCount" />
      <Setting name="ForwardToReportCenter" />
      <Setting name="RedirectAosLoginUrl" />
      <Setting name="ReportContainerName" />
      <Setting name="ConfigDatabaseConnection" />
      <Setting name="PortalApiUrl" />
      <Setting name="ControlServiceAddress" />
      <Setting name="CertificateThumbprint" />
      <Setting name="NotificationSetting" />
      <Setting name="ClientId" />
      <Setting name="ClientSecret" />
    </ConfigurationSettings>
    <Runtime executionContext="elevated" />
    <Certificates>
      <Certificate name="Web" storeLocation="LocalMachine" storeName="My" />
      <Certificate name="CloudRecords Application" storeName="My" storeLocation="LocalMachine" />
      <Certificate name="DocAveOnline Application" storeName="My" storeLocation="LocalMachine" />
    </Certificates>
    <Endpoints>
      <InputEndpoint name="HTTPSEndpoint1" protocol="https" port="6001" certificate="Web" />
    </Endpoints>
    <Startup>
      <!--<Task commandLine="SecurityProtocolStartup.bat" executionContext="elevated" taskType="simple" />-->
    </Startup>
  </WebRole>
  <WorkerRole name="RATimerWorkerRole" vmsize="Small">
    <ConfigurationSettings>
      <Setting name="Microsoft.WindowsAzure.Plugins.Diagnostics.ConnectionString" />
      <Setting name="JobQueueConnectionString" />
      <Setting name="ConfigDatabaseConnection" />
      <Setting name="JobQueueName" />
      <Setting name="PortalApiUrl" />
      <Setting name="ControlServiceAddress" />
      <Setting name="JobLimitCount" />
      <Setting name="ReportFolder" />
      <Setting name="LogStorage" />
      <Setting name="LogContainerName" />
      <Setting name="CertificateThumbprint" />
      <Setting name="PortalTopicConnectionstring" />
      <Setting name="PortalSubscriptionName" />
      <Setting name="PortalTopicName" />
      <Setting name="AzureTableConnection" />
    </ConfigurationSettings>
    <Runtime executionContext="elevated" />
    <Certificates>
      <Certificate name="CloudRecords Application" storeName="My" storeLocation="LocalMachine" />
      <Certificate name="DocAveOnline Application" storeName="My" storeLocation="LocalMachine" />
    </Certificates>
    <Startup>
      <!--<Task commandLine="SecurityProtocolStartup.bat" executionContext="elevated" taskType="simple" />-->
    </Startup>
  </WorkerRole>
  <WorkerRole name="RAScheduleJobWorkerRole" vmsize="Standard_D2">
    <ConfigurationSettings>
      <Setting name="Microsoft.WindowsAzure.Plugins.Diagnostics.ConnectionString" />
      <Setting name="ConfigDatabaseConnection" />
      <Setting name="JobQueueConnectionString" />
      <Setting name="JobQueueName" />
      <Setting name="ReportContainerName" />
      <Setting name="ReportStorage" />
      <Setting name="ReportFolder" />
      <Setting name="LogStorage" />
      <Setting name="LogContainerName" />
      <Setting name="ControlServiceAddress" />
      <Setting name="PortalApiUrl" />
      <Setting name="CertificateThumbprint" />
      <Setting name="HotfixStorageUrl" />
      <Setting name="AzureTableConnection" />
      <Setting name="NotificationSetting" />
      <Setting name="RedirectAosLoginUrl" />
    </ConfigurationSettings>
    <Runtime executionContext="elevated" />
    <LocalResources>
    </LocalResources>
    <Certificates>
      <Certificate name="CloudRecords Application" storeName="My" storeLocation="LocalMachine" />
      <Certificate name="DocAveOnline Application" storeName="My" storeLocation="LocalMachine" />
    </Certificates>
    <Startup>
      <!--<Task commandLine="SecurityProtocolStartup.bat" executionContext="elevated" taskType="simple" />-->
    </Startup>
  </WorkerRole>
</ServiceDefinition>