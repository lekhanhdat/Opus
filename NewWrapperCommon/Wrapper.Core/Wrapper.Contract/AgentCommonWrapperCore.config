<configuration>
  <restore defaultVersion="1.0.0.0">
    <metadataService maxCacheCount="20" />
    <userprofileService maxCacheCount="10" >
      <userProfileIgnoredProperties>UserProfile_GUID</userProfileIgnoredProperties>
    </userprofileService>
  </restore>
  <common defaultConnectionLimit="80" >
    <defaultProxy enabled="false" userName="" password="" address="" bypassProxyOnLocal="false">
      <bypassList address="" />
    </defaultProxy>
  </common>
  <!--the default timeout seconds from O365 is 28800s.-->
  <o365 timeoutSeconds="27000" ></o365>
</configuration>