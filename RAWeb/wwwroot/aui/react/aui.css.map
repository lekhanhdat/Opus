  scrollbar-width: none;
}
html:not(.aui-touchable) .scrollbar-hidden-pc::-webkit-scrollbar {
  display: none;
}
html.vk-shown {
  overscroll-behavior: none;
}
.mobile-visible {
  display: none;
}
.mobile-hidden {
  display: block;
}
.aui-mobile-view .mobile-visible {
  display: block !important;
}
.aui-mobile-view .mobile-hidden {
  display: none !important;
}
@media (width <= 768px) {
  .phone-hidden {
    display: none !important;
  }
}
