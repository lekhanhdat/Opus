<FieldMappings>
  <FieldMapping>
    <Condition>
      <SiteCondition>
        <ConditionRule type="url" condition="contains" value="sites" relation="and"></ConditionRule>
        <ConditionRule type="sitecontenttype" condition="contains" value="document" relation="or"></ConditionRule>
      </SiteCondition>
      <ListCondition>
        <ConditionRule type="templateid" condition="contains" value="1" relation="and"></ConditionRule>
        <ConditionRule type="listtitle" condition="contains" value="list" relation="and"></ConditionRule>
        <ConditionRule type="listcontenttype" condition="contains" value="item" relation="or"></ConditionRule>
      </ListCondition>
      <ItemCondition>
        <ConditionRule type="name" condition="contains" value="1" relation="or"></ConditionRule>
      </ItemCondition>
    </Condition>
    <Mappings>
      <Mapping type="SameType" sourceName="single001" sourceDisplayName="single001" destinationName="destination-single001" destinationDisplayName="destination-single001">
        <ValueMappings>
          <ValueMapping sourceValue="111" destinationValue="destination-111"></ValueMapping>
        </ValueMappings>
      </Mapping>
      <Mapping type="ChangeToMetadata" sourceName="maptomms" sourceDisplayName="maptomms" destinationName="destination-maptomms" destinationDisplayName="destination-maptomms">
        <Setting termSetPath="group 001;termset 001" allowMultiValue="false" separateChar=";"></Setting>
        <ValueMappings>
          <ValueMapping sourceValue="abc" destinationValue="term1"></ValueMapping>
        </ValueMappings>
      </Mapping>
      <Mapping type="ChangeToDes" sourceName="maptodestination" sourceDisplayName="maptodestination" destinationName="destination-maptodestination" destinationDisplayName="destination-maptodestination">
        <ValueMappings>
          <ValueMapping sourceValue="sourcevalue" destinationValue="destinationvalue"></ValueMapping>
        </ValueMappings>
      </Mapping>
      <Mapping type="ChangeToLookUp" sourceName="maptolookup" sourceDisplayName="maptolookup" destinationName="destination-maptolookup" destinationDisplayName="destination-maptolookup">
        <Setting listTitle="Announcements" columnName="Title" allowMultiValue="false" SeparateChar=";"></Setting>
        <ValueMappings>
          <ValueMapping sourceValue="123" destinationValue="123"></ValueMapping>
        </ValueMappings>
      </Mapping>
    </Mappings>
  </FieldMapping>
</FieldMappings>