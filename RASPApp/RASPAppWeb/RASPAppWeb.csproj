<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
	<PropertyGroup>
		<EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>
	</PropertyGroup>
  
  <ItemGroup>
    <None Remove="Resources\ResourceFileMapping.xml" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wwwroot\css\appMain.css" />
    <None Include="wwwroot\images\APP-icon1.png" />
    <None Include="wwwroot\images\APP-icon2.png" />
  </ItemGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\..\Common\GlobalCommon\GCommonContract\DocAve.GCommonContract.csproj" />
    <ProjectReference Include="..\..\RACommon.Global\RACommon.Global.csproj" />
    <ProjectReference Include="..\..\RACommon\RACommon.csproj" />
    <ProjectReference Include="..\..\RAContract.Global\RAContract.Global.csproj" />
    <ProjectReference Include="..\..\RAContract\RAContract.csproj" />
    <ProjectReference Include="..\..\RAWebExtensions\RAWebExtensions.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\RACommon\ServiceVersion\ServiceVersion.config">
      <Link>Config\ServiceVersion\ServiceVersion.config</Link>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.17.3" />
    <PackageReference Include="log4net" Version="3.3.1" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.4" />
    <PackageReference Include="System.Data.SqlClient" Version="4.9.0" />
    <PackageReference Include="System.Net.Security" Version="4.3.2" />
    <PackageReference Include="System.Private.Uri" Version="4.3.2" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources\RelatedRecords.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>RelatedRecords.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Content Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources\RelatedRecords.resx">
      <SubType>Designer</SubType>
      <LastGenOutput>RelatedRecords.Designer.cs</LastGenOutput>
      <Generator>ResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <Target Condition="'$(Configuration)' == 'Debug'" Name="CopyAppSettings" BeforeTargets="PrepareForBuild">
    <Copy SourceFiles="$(ProjectDir)..\..\build\AppConfig\appsettings.json" DestinationFolder="$(ProjectDir)" />
  </Target>
</Project>
