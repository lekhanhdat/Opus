        #endregion

        #region Private Method
        private string GetServerUrl(string url)
        {
            int index = url.IndexOf("://");
            if (index < 0)
            {
                throw new Exception(string.Format("illegal format:{0} ", url));
            }
            index = url.IndexOf('/', index + 3);
            if (index > 0)
            {
                return url.Substring(0, index);
            }
            else
            {
                return url;
            }
        }
        #endregion

