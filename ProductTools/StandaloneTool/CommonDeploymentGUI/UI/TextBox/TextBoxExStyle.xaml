<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AvePoint.Deployment.CommonGUI"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="/AvePoint.CallAssist.CommonDeploymentGUI;component/Styles/DefaultStyle.xaml" />
  </ResourceDictionary.MergedDictionaries>
	
  <!--Base-->
  <Style x:Key="TextBoxBasicTheme" TargetType="{x:Type TextBox}">
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <!-- <Setter Property="OverridesDefaultStyle" Value="True"/>-->
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="MinWidth" Value="80" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="AllowDrop" Value="true" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBoxBase}">
          <ControlTemplate.Resources>
            <Storyboard x:Key="TextBoxOnMouseEnter">
              <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Over">
                <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="TextBoxOnMouseLeave">
              <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)" Storyboard.TargetName="Over">
                <SplineDoubleKeyFrame KeyTime="0" Value="1" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="0" />
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </ControlTemplate.Resources>
          <Grid>
            <Border x:Name="Border" CornerRadius="2" Padding="5,0,0,0" Background="#FFF" BorderBrush="#FFCCCCCC"
                    BorderThickness="{TemplateBinding BorderThickness}" />
            <Border x:Name="Over" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"
                    Opacity="0" Visibility="Visible" Margin="0" Background="{x:Null}" BorderBrush="#FF4488CC" />
            <Border x:Name="ReadOnly" Background="#CCE8E8E8" CornerRadius="2"
                    BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="#FFCCCCCC" Visibility="Collapsed" Margin="0"
                    HorizontalAlignment="Stretch" Height="Auto" VerticalAlignment="Stretch" Width="Auto" />
            <ScrollViewer Margin="0" x:Name="PART_ContentHost" Template="{DynamicResource TextBoxScrollViewer}"
                          VerticalAlignment="Center" />
            <Border x:Name="Disable" Background="#CCE8E8E8" BorderBrush="#FFB7B7B7"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" IsHitTestVisible="False" Visibility="Collapsed"
                    Margin="0" />
            <!--Border x:Name="Focus" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="1"
                    IsHitTestVisible="False" Visibility="Collapsed" Margin="-1" BorderBrush="#9DF" /-->
            <!--<ContentControl x:Name="Watermark" Background="{TemplateBinding Background}" Content="{TemplateBinding Watermark}" Foreground="#FFAAAAAA" FontWeight="{TemplateBinding FontWeight}" FontStyle="Normal" FontStretch="{TemplateBinding FontStretch}" FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" IsHitTestVisible="False" IsTabStop="False" Margin="2,0,0,0" Opacity="0" Padding="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>-->
          </Grid>
          <ControlTemplate.Triggers>

            <EventTrigger RoutedEvent="Mouse.MouseEnter">
              <BeginStoryboard Storyboard="{StaticResource TextBoxOnMouseEnter}" />
            </EventTrigger>
            <EventTrigger RoutedEvent="Mouse.MouseLeave">
              <BeginStoryboard Storyboard="{StaticResource TextBoxOnMouseLeave}" />
            </EventTrigger>
            <Trigger Property="IsReadOnly" Value="True">
              <Setter TargetName="ReadOnly" Property="Visibility" Value="Visible" />
            </Trigger>
            <!--Trigger Property="IsFocused" Value="True">
              <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
            </-->
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Disable" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
    
  <!--Default-->
  <Style TargetType="{x:Type TextBox}" BasedOn="{StaticResource TextBoxBasicTheme}" />
    
  <!--Extra-->
  <Style TargetType="{x:Type local:TextBoxEx}" BasedOn="{StaticResource TextBoxBasicTheme}">
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="Template">
      <Setter.Value>
        <!--<ControlTemplate TargetType="{x:Type TextBox}">-->
        <ControlTemplate TargetType="{x:Type local:TextBoxEx}">
          <ControlTemplate.Resources>
            <Storyboard x:Key="TextBoxOnMouseEnter">
              <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)"
                                             Storyboard.TargetName="Over">
                <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="TextBoxOnMouseLeave">
              <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)"
                                             Storyboard.TargetName="Over">
                <SplineDoubleKeyFrame KeyTime="0" Value="1" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="0" />
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </ControlTemplate.Resources>

          <Grid x:Name="RootElement">
            <!--RowDefinitions need not to be changed-->
            <Grid.RowDefinitions>
              <RowDefinition Height="auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="auto" />
              <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="Border" CornerRadius="2" Padding="0" Background="#FFF" BorderBrush="#FFCCCCCC" MinHeight="30"
                    BorderThickness="{TemplateBinding BorderThickness}" />
            <Border x:Name="Over" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"
                    Opacity="0" Visibility="Visible" Margin="0" Background="{x:Null}" BorderBrush="#FF4488CC" />
            <Border x:Name="ReadOnly" Background="#CCE8E8E8" CornerRadius="2"
                    BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="#FFCCCCCC" Visibility="Collapsed" Margin="0"
                    Width="Auto" />
            <Border x:Name="ValidationError" CornerRadius="2"
                    BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="Red" Visibility="Collapsed" Margin="0"
                    Width="Auto" />
            <ScrollViewer  Width="{TemplateBinding TextBoxWidth}" Margin="5,0,0,0" VerticalAlignment="Center"  x:Name="PART_ContentHost" />
            <Border x:Name="Disable" Background="#CCE8E8E8" BorderBrush="#FFB7B7B7"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" IsHitTestVisible="False" Visibility="Collapsed"
                    Margin="0" />
            <Border x:Name="Focus" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"
                    IsHitTestVisible="False" Visibility="Collapsed" Margin="-1" BorderBrush="#9DF" />
            <Label x:Name="WaterMark" Content="{TemplateBinding Tag}" Visibility="Collapsed"
                   Focusable="False" Foreground="#FFCCCCCC" Margin="5,0,0,0" Padding="0" 
                   VerticalAlignment="Center" Width="Auto" Height="Auto" />
            <Grid x:Name="ValidationPanel" Width="{TemplateBinding TextBoxWidth}" Visibility="Collapsed" Grid.Row="1"
                  Grid.Column="0" Grid.RowSpan="2"  HorizontalAlignment="Left" VerticalAlignment="Top">
              <!--Grid.ColumnDefinitions>
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
              </-->
              <!--Image Grid.Column="0"
                     Source="/AvePoint.CallAssist.CommonDeploymentGUI;component/UI/TextBox/Images/errormsg_16x16.png" Width="16" Height="16"
                     HorizontalAlignment="Left" VerticalAlignment="Top" /-->
              <TextBlock Grid.Column="1" TextWrapping="Wrap" x:Name="ValidationMsg"
                         Text="{Binding ErrorMsg}" Foreground="Red" DataContext="{Binding RelativeSource={RelativeSource TemplatedParent}}" />
            </Grid>
          </Grid>


          <ControlTemplate.Triggers>

            <EventTrigger RoutedEvent="Mouse.MouseEnter">
              <BeginStoryboard Storyboard="{StaticResource TextBoxOnMouseEnter}" />
            </EventTrigger>
            <EventTrigger RoutedEvent="Mouse.MouseLeave">
              <BeginStoryboard Storyboard="{StaticResource TextBoxOnMouseLeave}" />
            </EventTrigger>
            <Trigger Property="IsReadOnly" Value="True">
              <Setter TargetName="ReadOnly" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Visibility" TargetName="Disable" Value="Visible" />
              <Setter Property="Foreground" TargetName="WaterMark" Value="#FFBFBFBF" />
            </Trigger>

            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="IsFocused" Value="False" />
                <Condition Property="Text" Value="" />
              </MultiTrigger.Conditions>
              <Setter Property="Visibility" TargetName="WaterMark" Value="Visible" />
              <!--<Setter Property="Margin" TargetName="WaterMark" Value="0"/>-->
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="Padding" Value="1" />
  </Style>
	
	
  <!-- SimpleStyles: RichTextBox -->

  <Style x:Key="{x:Type RichTextBox}" BasedOn="{StaticResource {x:Type TextBox}}" TargetType="{x:Type RichTextBox}">
    <Style.Resources>
      <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
        <Setter Property="OverridesDefaultStyle" Value="true" />
      </Style>
      <!--<Style x:Key="{x:Type FlowDocument}" TargetType="{x:Type FlowDocument}">
                <Setter Property="OverridesDefaultStyle" Value="true"/>
            </Style>-->
    </Style.Resources>
  </Style>


  <!-- SimpleStyles: PasswordBox -->

  <Style x:Key="{x:Type PasswordBox}" TargetType="{x:Type PasswordBox}">
    <Setter Property="SnapsToDevicePixels" Value="true" />
    <Setter Property="OverridesDefaultStyle" Value="true" />
    <Setter Property="KeyboardNavigation.TabNavigation" Value="None" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="PasswordChar" Value="*" />
    <Setter Property="MinWidth" Value="120" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="AllowDrop" Value="true" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="#333333" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type PasswordBox}">
          <ControlTemplate.Resources>
            <Storyboard x:Key="TextBoxOnMouseEnter">
              <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)"
                                             Storyboard.TargetName="Over">
                <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="1" />
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="TextBoxOnMouseLeave">
              <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Opacity)"
                                             Storyboard.TargetName="Over">
                <SplineDoubleKeyFrame KeyTime="0" Value="1" />
                <SplineDoubleKeyFrame KeyTime="0:0:0.3" Value="0" />
              </DoubleAnimationUsingKeyFrames>
            </Storyboard>
          </ControlTemplate.Resources>
          <Grid>
            <Border Name="Border" CornerRadius="2" Padding="5,0,0,0" Background="#FFF" BorderBrush="#FFCCCCCC"
                    BorderThickness="1">
            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" />
            </Border>
            <Border x:Name="Over" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"
                    Opacity="0" Visibility="Visible" Margin="0" BorderBrush="#FF4488CC" />
            <Border x:Name="Focus" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"
                    IsHitTestVisible="False" Visibility="Collapsed" Margin="-1" BorderBrush="#9DF" />
            <Border x:Name="Disable" Background="#CCE8E8E8" BorderBrush="#FFCCCCCC"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" IsHitTestVisible="False" Visibility="Collapsed"
                    Margin="0" />
          </Grid>
          <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="Mouse.MouseEnter">
              <BeginStoryboard Storyboard="{StaticResource TextBoxOnMouseEnter}" />
            </EventTrigger>
            <EventTrigger RoutedEvent="Mouse.MouseLeave">
              <BeginStoryboard Storyboard="{StaticResource TextBoxOnMouseLeave}" />
            </EventTrigger>
            <Trigger Property="IsFocused" Value="True">
              <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Disable" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <ControlTemplate x:Key="TextBoxScrollViewer" TargetType="{x:Type ScrollViewer}">
    <Grid x:Name="Grid" Background="{TemplateBinding Background}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Rectangle x:Name="Corner" Fill="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Grid.Column="1"
                 Grid.Row="1" />
      <ScrollContentPresenter Margin="0,1,0,0" x:Name="PART_ScrollContentPresenter" Grid.Column="0" Grid.Row="0"
                              Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                              CanContentScroll="{TemplateBinding CanContentScroll}" CanHorizontallyScroll="False" CanVerticallyScroll="False" />
      <!--Border Grid.Column="1" BorderThickness="0,1,1,1" BorderBrush="#FFCCCCCC"/-->
      <ScrollBar x:Name="PART_VerticalScrollBar" Cursor="Arrow"
                 Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Grid.Column="1" Grid.Row="0"
                 ViewportSize="{TemplateBinding ViewportHeight}" Maximum="{TemplateBinding ScrollableHeight}" Minimum="0"
                 Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                 AutomationProperties.AutomationId="VerticalScrollBar" Margin="0,1,1,1" />
      <ScrollBar x:Name="PART_HorizontalScrollBar" Cursor="Arrow"
                 Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" Grid.Column="0" Grid.Row="1"
                 Orientation="Horizontal" ViewportSize="{TemplateBinding ViewportWidth}" Maximum="{TemplateBinding ScrollableWidth}"
                 Minimum="0" Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                 AutomationProperties.AutomationId="HorizontalScrollBar" />
    </Grid>
  </ControlTemplate>


</ResourceDictionary>