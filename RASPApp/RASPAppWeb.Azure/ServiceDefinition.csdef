<ServiceDefinition name="RASPAppWeb.Azure" xmlns="http://schemas.microsoft.com/ServiceHosting/2008/10/ServiceDefinition" schemaVersion="2015-04.2.6">
  <WebRole name="RASPAppWeb" vmsize="Small">
    <Sites>
      <Site name="Web" physicalDirectory="..\..\build\RevIMWorker.ProviderWeb">
        <Bindings>
        <Binding name="AppEndpoint" endpointName="AppEndpoint" /></Bindings>
      </Site>
    </Sites>
    <ConfigurationSettings>
      <Setting name="Microsoft.WindowsAzure.Plugins.Diagnostics.ConnectionString" />
      <Setting name="AppUrl"/>
      <Setting name="ClientId"/>
      <Setting name="ClientSecret"/>
      <Setting name="LogStorage"/>
      <Setting name="LogContainerName"/>
      <Setting name="PortalApiUrl"/>
      <Setting name="CertificateThumbprint" />
    </ConfigurationSettings>
    <Endpoints>
    <InputEndpoint name="AppEndpoint" protocol="https" port="443" certificate="Web" /></Endpoints>
    <Runtime executionContext="elevated" />
    <Certificates>
      <Certificate name="Web" storeLocation="LocalMachine" storeName="My" />
      <Certificate name="CloudRecords Application" storeName="My" storeLocation="LocalMachine" />
    </Certificates>
    <Startup>
      <Task commandLine="SecurityProtocolStartup.bat" executionContext="elevated" taskType="simple" />
    </Startup>
  </WebRole>
  
</ServiceDefinition>