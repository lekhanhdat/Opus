<configuration>
	<components>
		<component id="AvePoint.Media.Service.DomainModel.CommonConfigInfo" service="AvePoint.Media.Service.DomainModel.CommonConfigInfo, MediaServiceDomainModel" type="AvePoint.Media.Service.DomainModel.CommonConfigInfo, MediaServiceDomainModel">
			<parameters>
				<MaxNodesCount>500</MaxNodesCount>
				<ForceUseCache>true</ForceUseCache>
				<UseMemoryStream>false</UseMemoryStream>
				<VerifyDataInRestore>false</VerifyDataInRestore>
				<ReadMetaDataViaCache>false</ReadMetaDataViaCache>
				<ReadContentDataViaCache>false</ReadContentDataViaCache>
			</parameters>
		</component>
		<component id="AvePoint.RA.DB.Dao.IMediaDataDao" service="AvePoint.RA.DB.Dao.IMediaDataDao, RevIMDB" type="AvePoint.RA.DB.Dao.MediaDataDao, RevIMDB" lifestyle="transient"/>
		<!--<component id="AvePoint.RA.Common.Audit.AuditInterceptorSelector" type="AvePoint.RA.Common.Audit.AuditInterceptorSelector, RevIMCommon" lifestyle="transient"/>-->
		<component id="AvePoint.Media.Service.ArchiverBackup.Backup.IArchiverBackupDataWriter" service="AvePoint.Media.Service.ArchiverBackup.Backup.IArchiverBackupDataWriter, MediaServiceArchiverBackup" type="AvePoint.Media.Service.ArchiverBackup.ArchiverBackupDataWriter, MediaServiceArchiverBackup" lifestyle="transient" />
		<component id="AvePoint.Media.Core.Index.IIndexDatabaseUpgradeManager" service="AvePoint.Media.Core.Index.IIndexDatabaseUpgradeManager, MediaCoreIndex" type="AvePoint.Media.Core.Index.IndexDatabaseUpgradeManager, MediaCoreIndex" lifestyle="transient" />
