<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AvePoint.Deployment.CommonGUI">

  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ResourceDictionary>
    <ResourceDictionary>
        <local:PageWizardItemUnitTypeLocationConverter x:Key="PageWizardItemUnitTypeLocationConverter" />
    </ResourceDictionary>
    <ResourceDictionary>
        <local:PageWizardItemUnitStateIconConverter x:Key="PageWizardItemUnitStateIconConverter" />
    </ResourceDictionary>
    <ResourceDictionary>
        <local:LineVisibilityConverter x:Key="LineVisibilityConverter" />
    </ResourceDictionary>
</ResourceDictionary.MergedDictionaries>

    <DataTemplate x:Key="PageWizardItemTemplate">
        <StackPanel
            Margin="0"
            Orientation="Horizontal" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
            Focusable="False"
            Visibility="{Binding Path=IsVisibility, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=true}"
        >
            <Grid Focusable="False" Margin="0">
                <Button
                    Focusable="False"
                    Content="{Binding Content}"  
                    Command="{Binding WizardOperator.Command}"
                    Style="{DynamicResource WizardButtonStyle}"
                />
            </Grid>
            <Line
                X1="0"
                Y1="15"
                X2="66"
                Y2="15"
                Stroke="White"
                StrokeThickness="2"
                Visibility="{Binding Path=Content, Converter={StaticResource LineVisibilityConverter}}"
            />
        </StackPanel>
    </DataTemplate>

