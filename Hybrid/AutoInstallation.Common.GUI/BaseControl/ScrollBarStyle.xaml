        <ControlTemplate.Resources>
            <Storyboard x:Key="MouseEnter">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00"
                                               Storyboard.TargetName="SmallDecreaseBg"
                                               Storyboard.TargetProperty="(UIElement.Opacity)">
                    <LinearDoubleKeyFrame KeyTime="00:00:00.3000000"
                                          Value="1" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00"
                                               Storyboard.TargetName="SmallIncreaseBg"
                                               Storyboard.TargetProperty="(UIElement.Opacity)">
                    <LinearDoubleKeyFrame KeyTime="00:00:00.3000000"
                                          Value="1" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
            <Storyboard x:Key="MouseLeave">
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00"
                                               Storyboard.TargetName="SmallIncreaseBg"
                                               Storyboard.TargetProperty="(UIElement.Opacity)">
                    <LinearDoubleKeyFrame KeyTime="00:00:00"
                                          Value="1" />
                    <LinearDoubleKeyFrame KeyTime="00:00:00.3000000"
                                          Value="0" />
                </DoubleAnimationUsingKeyFrames>
                <DoubleAnimationUsingKeyFrames BeginTime="00:00:00"
                                               Storyboard.TargetName="SmallDecreaseBg"
                                               Storyboard.TargetProperty="(UIElement.Opacity)">
                    <LinearDoubleKeyFrame KeyTime="00:00:00"
                                          Value="1" />
                    <LinearDoubleKeyFrame KeyTime="00:00:00.3000000"
                                          Value="0" />
                </DoubleAnimationUsingKeyFrames>
            </Storyboard>
        </ControlTemplate.Resources>
        <Grid Width="15">
            <Grid.RowDefinitions>
                <RowDefinition MaxHeight="15" />
                <RowDefinition Height="*" />
                <RowDefinition MaxHeight="15" />
            </Grid.RowDefinitions>
            <Border Background="#FFEFEFEF"
                    Grid.RowSpan="3" />
            <Border x:Name="SmallDecreaseBg"
                    CornerRadius="1"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource NormalBorderBrush}"
                    Margin="0"
                    Opacity="0">
                <Rectangle Stroke="#FFEAEBEC"
                           Fill="{DynamicResource VScrollbarBkgNormFill}"
                           RadiusX="1"
                           RadiusY="1" />
            </Border>
            <RepeatButton Grid.Row="0"
                          Style="{StaticResource ScrollBarLineButton}"
                          Height="15"
                          Command="ScrollBar.LineUpCommand"
                          Content="M 0 4 L 8 4 L 4 0 Z" />
            <Track x:Name="PART_Track"
                   Grid.Row="1"
                   IsDirectionReversed="true">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                                  Command="ScrollBar.PageUpCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource VScrollBarThumb}"
                           Margin="0"
                           MinWidth="0" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource ScrollBarPageButton}"
                                  Command="ScrollBar.PageDownCommand" />
                </Track.IncreaseRepeatButton>
            </Track>
            <Border x:Name="SmallIncreaseBg"
                    CornerRadius="1"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource NormalBorderBrush}"
                    Margin="0"
                    Grid.Row="2"
                    Opacity="0">
                <Rectangle Stroke="#FFEAEBEC"
                           Fill="{DynamicResource VScrollbarBkgNormFill}"
                           RadiusX="1"
                           RadiusY="1" />
            </Border>
            <RepeatButton Grid.Row="2"
                          Style="{StaticResource ScrollBarLineButton}"
                          Height="15"
                          Command="ScrollBar.LineDownCommand"
                          Content="M 0 0 L 4 4 L 8 0 Z" />
