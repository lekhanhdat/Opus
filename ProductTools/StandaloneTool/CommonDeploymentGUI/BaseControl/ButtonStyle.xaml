<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">
  <ResourceDictionary.MergedDictionaries>
    <ResourceDictionary Source="BCStyleLink.xaml" />
  </ResourceDictionary.MergedDictionaries>

    <!-- SimpleStyles: Hyperlink -->
    <Style x:Key="HyperlinkStyle"  TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="#FF0066FF" />
        <Setter Property="Template">
          <Setter.Value>
             <ControlTemplate TargetType="{x:Type Button}">
             <Grid MinHeight="0" MinWidth="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="Transparent">
             <TextBlock x:Name="TextBlockNormal" Margin="0" Text="{TemplateBinding Content}"
                       TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF0066FF" Padding="5" Visibility="Visible"/>
             <TextBlock x:Name="TextBlockMouseOver" HorizontalAlignment="Center" Margin="0"
                       VerticalAlignment="Center" Foreground="#FF0055E8" Text="{TemplateBinding Content}" TextWrapping="Wrap"
                       TextDecorations="Underline" Visibility="Collapsed" Padding="5" />
             </Grid>
                     <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="true">
                            <Setter Property="Visibility" TargetName="TextBlockMouseOver" Value="Visible" />
                            <Setter Property="Visibility" TargetName="TextBlockNormal" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
        </Setter>
    </Style>
    
    <!-- SimpleStyles: Button -->

  <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="#FF333333" />
    <Setter Property="SnapsToDevicePixels" Value="true" />
    <Setter Property="OverridesDefaultStyle" Value="true" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Padding" Value="8,1,8,1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid MinHeight="30" MinWidth="70">
            <Border x:Name="BackgroundNorm" BorderThickness="1" Background="#FFFFFFFF"
                    BorderBrush="#FFCCCCCC" CornerRadius="2" />
            <Border x:Name="BackgroundOver" BorderBrush="#FF4488CC" BorderThickness="1" CornerRadius="2" Opacity="0"/>
            <Border x:Name="BackgroundNorm_highlight" Margin="1" BorderBrush="#FFFFFFFF"
                    BorderThickness="1,1,1,1" CornerRadius="2" />
            <Border x:Name="BackgroundPressed" Background="#FFEEEEEE" BorderBrush="#FF3B79AC"
                    BorderThickness="1" CornerRadius="2" Opacity="0" />
            <ContentPresenter Margin="0,0,0,2" HorizontalAlignment="Center" VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
            <Border x:Name="DisabledVisualElement" Background="#CCE2E2E2" BorderBrush="#FFB7B7B7"
                    BorderThickness="1" CornerRadius="2" IsHitTestVisible="false" Visibility="Collapsed" />
            <!--Border x:Name="FocusVisualElement" Margin="1" BorderBrush="#FF98DDFB" BorderThickness="1"
                    CornerRadius="2" IsHitTestVisible="false" Visibility="Collapsed" /-->
          </Grid>
          <ControlTemplate.Triggers>
            <!--Trigger Property="IsKeyboardFocused" Value="true">
              <Setter Property="Visibility" TargetName="FocusVisualElement" Value="Visible" />
            </-->
            <Trigger Property="IsMouseOver" Value="true">
              <Setter Property="Opacity" TargetName="BackgroundOver" Value="1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
              <Setter Property="Opacity" TargetName="BackgroundPressed" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
              <Setter Property="Visibility" TargetName="DisabledVisualElement" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <!-- Wizard button styles: Button -->
  <Style x:Key="WizardButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="SnapsToDevicePixels" Value="true" />
    <Setter Property="OverridesDefaultStyle" Value="true" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="FontFamily" Value="Segoe UI" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="#FF1188EE" />
    <Setter Property="Padding" Value="4,1,4,1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid>
            <Border x:Name="BackgroundNorm" BorderThickness="1" Background="{x:Null}"
                    BorderBrush="{x:Null}" CornerRadius="1" />
            <Border x:Name="BackgroundOver" BorderBrush="{x:Null}" BorderThickness="1" CornerRadius="1"
                    Opacity="0" Background="{x:Null}" Height="Auto" />
            <Border x:Name="BackgroundNorm_highlight" Margin="1" BorderBrush="{x:Null}"
                    BorderThickness="1,1,1,1" CornerRadius="1" Height="Auto" />
            <Border x:Name="BackgroundPressed" Background="{x:Null}" BorderBrush="{x:Null}"
                    BorderThickness="1" CornerRadius="1" Opacity="0" Height="Auto" />
            <Grid Width="30" Height="30"  >
              <Ellipse x:Name="textcircle"  Fill="#FFFFFFFF" Height="30" Stroke="White" Width="30" StrokeThickness="2"/>
              <TextBlock x:Name="textBlock" HorizontalAlignment="Center" VerticalAlignment="Center"
              Text="{TemplateBinding Content}" Foreground="#FF1188EE"  FontWeight="Bold">
              </TextBlock>
            </Grid >
           
            <Border x:Name="DisabledVisualElement" Background="{x:Null}" BorderBrush="{x:Null}"
                    BorderThickness="1" CornerRadius="1" IsHitTestVisible="false" Visibility="Collapsed" />
            <Rectangle x:Name="Focus" Fill="{x:Null}" Stroke="Black" Margin="0"
                       d:LayoutOverrides="HorizontalAlignment, VerticalAlignment" StrokeDashArray="0.5 1" Visibility="Collapsed" />
            <Border x:Name="FocusVisualElement" Margin="1" BorderBrush="{x:Null}" BorderThickness="1"
                    CornerRadius="1" IsHitTestVisible="false" Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="true">

              <Setter Property="Visibility" TargetName="FocusVisualElement" Value="Visible" />
              <Setter Property="Visibility" TargetName="Focus" Value="Visible" />

            </Trigger>
            <Trigger Property="IsMouseOver" Value="true">
              <Setter Property="Opacity" TargetName="BackgroundOver" Value="1" />
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
              <Setter Property="Opacity" TargetName="BackgroundPressed" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
              <Setter Property="Visibility" TargetName="DisabledVisualElement" Value="Visible" />
              <Setter Property="Fill" TargetName="textcircle" Value="#FF1188EE" />
              <Setter Property="Foreground" TargetName="textBlock" Value="#FFFFFFFF" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>

  </Style>


    <!-- RecommandedStyle: Button -->
  <Style x:Key="RecommandedButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="SnapsToDevicePixels" Value="true" />
    <Setter Property="OverridesDefaultStyle" Value="true" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="#FFFFFFFF" />
	<Setter Property="FontSize" Value="14"/>
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="4,1,4,1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Grid MinHeight="32" MinWidth="70">
            <Border x:Name="BackgroundNorm" CornerRadius="4" Background="#FF1188EE" Opacity="1"/>
            <Border x:Name="BackgroundOver" CornerRadius="4" Background="#FF2299FF" Opacity="0"/>
            <Border x:Name="BackgroundPressed" CornerRadius="4" Background="#FF1188EE" Opacity="0"/>
            <!--Border x:Name="BackgroundNorm_highlight" Margin="1" BorderBrush="#FFFFFFFF" BorderThickness="1,1,1,1" CornerRadius="1" /-->
            <ContentPresenter Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                              RecognizesAccessKey="True" Opacity="0" />
            <TextBlock x:Name="TextBlockNormal" Margin="0,0,0,2" Text="{TemplateBinding Content}"
                       TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" />
            <Border x:Name="DisabledVisualElement" Background="#FFE6E8EE" 
                        CornerRadius="4" IsHitTestVisible="false" Visibility="Collapsed" />
            <TextBlock x:Name="TextBlockDis" HorizontalAlignment="Center" Margin="0,0,0,2"
                       VerticalAlignment="Center" Foreground="#FFB1B6BB" Text="{TemplateBinding Content}" TextWrapping="Wrap"
                       Visibility="Collapsed" />
            <!--Border x:Name="FocusVisualElement" Margin="-1" BorderBrush="#FF99DDFF" BorderThickness="1"
                    CornerRadius="3" IsHitTestVisible="false" Visibility="Visible" Opacity="0" /-->
          </Grid>
          <ControlTemplate.Triggers>
            <!--Trigger Property="IsKeyboardFocused" Value="true">
              <Setter Property="Visibility" TargetName="FocusVisualElement" Value="Visible" />
            </-->
            <Trigger Property="IsMouseOver" Value="true">
              <Setter Property="Opacity" TargetName="BackgroundOver" Value="1" />
              <Setter Property="Cursor" Value="Hand"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
              <Setter Property="Opacity" TargetName="BackgroundPressed" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
              <Setter Property="Visibility" TargetName="DisabledVisualElement" Value="Visible" />
              <Setter Property="Opacity" TargetName="BackgroundNorm" Value="0" />  
              <Setter Property="Visibility" TargetName="TextBlockDis" Value="Visible" />
              <!--Setter Property="Visibility" TargetName="FocusVisualElement" Value="Collapsed" /-->
            </Trigger>
            <!--Trigger Property="IsFocused" Value="True">
              <Setter Property="Opacity" TargetName="FocusVisualElement" Value="1" />
            </-->
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


  <!-- NotRecommandedStyle: Button -->
  <Style x:Key="NotRecommandedButtonStyle" TargetType="{x:Type Button}">
    <Setter Property="SnapsToDevicePixels" Value="true" />
    <Setter Property="OverridesDefaultStyle" Value="true" />
    <!--<Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocusVisual}"/>-->
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Foreground" Value="#FF0066BB" />
	<Setter Property="FontSize" Value="14"/>
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="4,1,4,1" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
           <Grid MinHeight="32" MinWidth="70"
                Background="Transparent">
            <Border x:Name="BackgroundNorm" CornerRadius="4" Background="#FFAAB8C8" Opacity="1"/>
            <Border x:Name="BackgroundOver" CornerRadius="4" Background="#FFA3B3C3" Opacity="0"/>
            <Border x:Name="BackgroundPressed" CornerRadius="4" Background="#FFAAB8C8" Opacity="0"/>
            <ContentPresenter Margin="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                              RecognizesAccessKey="True" Opacity="0" />
            <TextBlock x:Name="TextBlockNormal" Margin="0,0,0,2" Text="{TemplateBinding Content}"
                       TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" />
            <Border x:Name="DisabledVisualElement" Background="#FFE6E8EE" 
                        CornerRadius="4" IsHitTestVisible="false" Visibility="Collapsed" />
            <TextBlock x:Name="TextBlockDis" HorizontalAlignment="Center" Margin="0,0,0,2"
                       VerticalAlignment="Center" Foreground="#FFB1B6BB" Text="{TemplateBinding Content}" TextWrapping="Wrap"
                       Visibility="Collapsed" />
          </Grid>
          <ControlTemplate.Triggers>
            <!--Trigger Property="IsKeyboardFocused" Value="true" /-->
            <Trigger Property="IsMouseOver" Value="true">
               <Setter Property="Opacity" TargetName="BackgroundOver" Value="1" />
               <Setter Property="Cursor" Value="Hand"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
               <Setter Property="Opacity" TargetName="BackgroundPressed" Value="1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
               <Setter Property="Opacity" TargetName="TextBlockDis" Value="1" />
            </Trigger>
            <!--Trigger Property="IsFocused" Value="True">
              <Setter Property="Visibility" TargetName="FocusRectangle" Value="Visible" />
            </-->
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>