CREATE INDEX 
            IF NOT EXISTS IDX_HEAD_PATH_MD5
            on tb_head_index(COL_PATH_MD5 asc);

CREATE INDEX 
            IF NOT EXISTS IDX_BODY_PATH_MD5 
            on tb_body_index(COL_PATH_MD5 asc);

CREATE INDEX 
            IF NOT EXISTS IDX_HEAD_PARENT_PATH_MD5
            on tb_head_index(COL_PARENT_PATH_MD5 asc);

CREATE INDEX 
            IF NOT EXISTS IDX_BODY_PARENT_PATH_MD5
            on tb_body_index(COL_PARENT_PATH_MD5 asc);