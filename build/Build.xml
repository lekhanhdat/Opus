<Project  DefaultTargets="MainDeployRecordsAutomation"  xmlns="http://schemas.microsoft.com/developer/msbuild/2003" >
  <PropertyGroup>
	<!--距此build.xml的相对路径层数-->
	<WorkingDirectory>..\</WorkingDirectory>
	<!--编译方式-->
	<BuildType>Release</BuildType>
	<BuildTarget>Rebuild</BuildTarget>
	<Platform>Any CPU</Platform>
	<!--Wsp10部分涉及到的文件相对路径-->
	<ProjectPath>$(WorkingDirectory)</ProjectPath>
	<ProjectToolPath>$(WorkingDirectory)ProductTools\</ProjectToolPath>
	<!--文件夹的相对路径-->
	<ProjectBasePath></ProjectBasePath>
	<DisableILMerge Condition="'$(DisableILMerge)' == ''">false</DisableILMerge>
	<ContinueOnFailure>false</ContinueOnFailure>
	<MSBuildPath>C:\Program Files (x86)\MSBuild\14.0\Bin\MSBuild.exe</MSBuildPath>    
  </PropertyGroup>

  <Target Name="MainDeploy">
    <CallTarget Targets="MainDeployAvePointRevIM" />
  </Target>
  
  <Target Name="MainDeployAvePointRevIM">
    <CallTarget Targets="RAWebCompressJsCss" />
    <CallTarget Targets="AvePointRevIM" />
    <CallTarget Targets="RevIMCloudService" />
    <CallTarget Targets="RevIMScheduleJob" />
    <CallTarget Targets="RevIMLoginWeb" />
	<CallTarget Targets="RevIMRelatedApp" />

  </Target>
  
  <!--RAWebCompressJsCss-->
  <Target Name="RAWebCompressJsCss">
    <Exec Command=".\RAWebjscss.bat"/>
  </Target>

  <!--RAWeb Gulp Build-->
  <Target Name="RAWebGulpBuild">
    <Exec Command=".\RAWebGulpBuild.bat"/>
  </Target>
  
<!--RAWebApp-->
<Target Name="AvePointRevIM">
   <MSBuild
      Projects="$(ProjectPath)RecordsAutomation.sln"
      ContinueOnError="$(ContinueOnFailure)"
      Targets="$(BuildTarget)"
      Properties="Configuration=$(BuildType);Platform=$(Platform)" TargetAndPropertyListSeparators="False">
   </MSBuild>
</Target>
<!--RevIMRelatedApp-->
<Target Name="RevIMRelatedApp">
   <MSBuild
      Projects="$(ProjectPath)RASPApp/RASPApp.sln"
      ContinueOnError="$(ContinueOnFailure)"
      Targets="$(BuildTarget)"
      Properties="Configuration=$(BuildType);Platform=$(Platform)" TargetAndPropertyListSeparators="False">
   </MSBuild>
</Target>
<!--RevIMLoginWeb-->
<Target Name="RevIMLoginWeb">
   <MSBuild
      Projects="$(ProjectPath)RecordsLogIn.sln"
      ContinueOnError="$(ContinueOnFailure)"
      Targets="$(BuildTarget)"
      Properties="Configuration=$(BuildType);Platform=$(Platform)" TargetAndPropertyListSeparators="False">
   </MSBuild>
</Target>
<!--RAScheduleJobCloudService-->
<Target Name="RevIMCloudService">
    <MSBuild
       Projects=" $(ProjectPath)RACloud.sln"
       ContinueOnError="$(ContinueOnFailure)"
       Targets="$(BuildTarget)"
       Properties="Configuration=$(BuildType);Platform=$(Platform);DeployOnBuild=true;DeployTarget=Package;AutoParameterizationWebConfigConnectionStrings=false" TargetAndPropertyListSeparators="False">
    </MSBuild>
</Target>

<!--RAScheduleJobCloudService-->
<!--RAScheduleJob-->
<Target Name="RevIMScheduleJob">
		<MSBuild
      Projects=" $(ProjectPath)RAScheduleJob.sln"
      ContinueOnError="$(ContinueOnFailure)"
      Targets="$(BuildTarget)"
      Properties="Configuration=$(BuildType);Platform=$(Platform)" TargetAndPropertyListSeparators="False">
		</MSBuild>
</Target>
<Target Name="RevIMHotfix">
		<MSBuild
      Projects=" $(ProjectPath)RecordsHotfixMaintenanceService.sln"
      ContinueOnError="$(ContinueOnFailure)"
      Targets="$(BuildTarget)"
      Properties="Configuration=$(BuildType);Platform=$(Platform)" TargetAndPropertyListSeparators="False">
		</MSBuild>
</Target>


</Project>
