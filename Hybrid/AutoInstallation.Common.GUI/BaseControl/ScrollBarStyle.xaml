    <Style x:Key="ScrollBarLineButton"
           TargetType="{x:Type RepeatButton}">
        <Setter Property="SnapsToDevicePixels"
                Value="True" />
        <Setter Property="OverridesDefaultStyle"
                Value="true" />
        <Setter Property="Focusable"
                Value="false" />
        <Setter Property="FocusVisualStyle"
                Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Grid x:Name="Root">
                        <Rectangle x:Name="Background"
                                   Stroke="{x:Null}"
                                   StrokeThickness="1"
                                   RadiusX="0.5"
                                   RadiusY="0.5">
                            <Rectangle.Fill>
                                <SolidColorBrush />
                            </Rectangle.Fill>
                        </Rectangle>
                        <Rectangle x:Name="BackgroundMouseOver"
                                   Stroke="{DynamicResource NormalOverLightBrush}"
                                   StrokeThickness="1"
                                   RadiusX="0.5"
                                   RadiusY="0.5"
                                   Opacity="0"
                                   Fill="{DynamicResource VScrollbarBkgOverFill}" />
                        <Rectangle x:Name="BackgroundPressed"
                                   StrokeThickness="1"
                                   RadiusX="0.5"
                                   RadiusY="0.5"
                                   Opacity="0"
                                   Stroke="{DynamicResource NormalPressLightBrush}"
                                   Fill="{DynamicResource VScrollbarBkgPressFill}" />
                        <Rectangle x:Name="Highlight"
                                   Margin="1"
                                   Stroke="{DynamicResource FocusBrush}"
                                   StrokeThickness="1"
                                   RadiusX="0.5"
                                   RadiusY="0.5"
                                   Opacity="0"
                                   IsHitTestVisible="false" />
                        <Rectangle x:Name="DisabledElement"
                                   Fill="#FFFFFFFF"
                                   Opacity="0" />
                        <Path x:Name="Path"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="{Binding Path=Content,RelativeSource={RelativeSource TemplatedParent}}">
                            <Path.Fill>
                                <LinearGradientBrush EndPoint="0.7,0.75"
                                                     StartPoint="0.25,0">
                                    <GradientStop Color="Black"
                                                  Offset="0.25" />
                                    <GradientStop Color="#FFA9AAAC"
                                                  Offset="1" />
                                    <GradientStop Color="#FFA4A5A7"
                                                  Offset="0.75" />
                                </LinearGradientBrush>
                            </Path.Fill>
                        </Path>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter Property="Opacity"
                                    TargetName="BackgroundMouseOver"
                                    Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="true">
                            <Setter Property="Background"
                                    Value="{DynamicResource PressedBrush}" />
                            <Setter Property="Opacity"
                                    TargetName="BackgroundPressed"
                                    Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="false">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource DisabledForegroundBrush}" />
                            <Setter Property="Opacity"
                                    TargetName="DisabledElement"
                                    Value="0.615" />
                            <Setter Property="Fill"
                                    TargetName="Path">
                                <Setter.Value>
                                    <LinearGradientBrush EndPoint="0.7,0.75"
                                                         StartPoint="0.25,0">
                                        <GradientStop Color="#FFA4A5A7"
                                                      Offset="0.25" />
                                        <GradientStop Color="#FFA9AAAC"
                                                      Offset="1" />
                                        <GradientStop Color="#FFA4A5A7"
                                                      Offset="0.75" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
